# Source spans are half-open UTF-8 byte ranges tied to the exact generated file.

include "../../src/codegen/source_map.elisa"
include "../model/test_support.elisa"

module CodegenSourceMapTest:
    private:
        def index_of(value: CodegenSourceMap::Lookup) -> i64:
            return value.span_index if value.ok and value.found
            return -1

    public:
        def run() -> i64:
            # Bytes are: 'a', 'b', UTF-8 e-acute (c3 a9), 'c', 'd'. The
            # multibyte character occupies byte offsets [2,4).
            generated_bytes: darray[u8] = [97, 98, 195, 169, 99, 100]
            generated: sview = TestSupport::view_of(generated_bytes)
            map: mutable CodegenSourceMap::SourceMap = CodegenSourceMap::empty(generated)
            added_form: bool = CodegenSourceMap::add_span(&map, 0, 6, CodegenSourceMap::OriginKind.Form, "form1", "", "")
            added_node: bool = CodegenSourceMap::add_span(&map, 0, 2, CodegenSourceMap::OriginKind.Node, "form1", "node1", "")
            added_template: bool = CodegenSourceMap::add_span(&map, 0, 1, CodegenSourceMap::OriginKind.Template, "form1", "", "page-template")
            added_property: bool = CodegenSourceMap::add_span(&map, 2, 4, CodegenSourceMap::OriginKind.Property, "form1", "node1", "caption")
            added_event: bool = CodegenSourceMap::add_span(&map, 4, 5, CodegenSourceMap::OriginKind.Event, "form1", "node1", "clicked")
            checked: CodegenSourceMap::Validation = CodegenSourceMap::validate(map, generated)
            TestSupport::check("map records exact generated byte length and hash", added_form and added_node and added_template and added_property and added_event and map.generated_length == 6 and map.generated_hash == Fingerprint::fnv1a64(generated) and checked.ok)

            template_lookup: CodegenSourceMap::Lookup = CodegenSourceMap::lookup(map, generated, 0)
            template_index: i64 = index_of(template_lookup)
            TestSupport::check("overlapping ranges resolve to the smallest template-origin span", template_lookup.ok and CodegenSourceMap::kind_at(map, template_index) == CodegenSourceMap::OriginKind.Template and DesignText::equal(CodegenSourceMap::member_at(map, template_index), "page-template"))

            node_lookup: CodegenSourceMap::Lookup = CodegenSourceMap::lookup(map, generated, 1)
            node_index: i64 = index_of(node_lookup)
            TestSupport::check("node-origin spans map back to their form and node IDs", node_lookup.ok and CodegenSourceMap::kind_at(map, node_index) == CodegenSourceMap::OriginKind.Node and DesignText::equal(CodegenSourceMap::form_id_at(map, node_index), "form1") and DesignText::equal(CodegenSourceMap::node_id_at(map, node_index), "node1"))

            property_lookup: CodegenSourceMap::Lookup = CodegenSourceMap::lookup(map, generated, 3)
            property_index: i64 = index_of(property_lookup)
            TestSupport::check("UTF-8 byte offset inside a multibyte character maps to its property", property_lookup.ok and CodegenSourceMap::kind_at(map, property_index) == CodegenSourceMap::OriginKind.Property and DesignText::equal(CodegenSourceMap::form_id_at(map, property_index), "form1") and DesignText::equal(CodegenSourceMap::node_id_at(map, property_index), "node1") and DesignText::equal(CodegenSourceMap::member_at(map, property_index), "caption"))

            event_lookup: CodegenSourceMap::Lookup = CodegenSourceMap::lookup(map, generated, 4)
            event_index: i64 = index_of(event_lookup)
            TestSupport::check("event ranges map to the originating node and connection", event_lookup.ok and CodegenSourceMap::kind_at(map, event_index) == CodegenSourceMap::OriginKind.Event and DesignText::equal(CodegenSourceMap::member_at(map, event_index), "clicked"))
            form_lookup: CodegenSourceMap::Lookup = CodegenSourceMap::lookup(map, generated, 5)
            form_index: i64 = index_of(form_lookup)
            TestSupport::check("half-open event span end falls back to the containing form span", form_lookup.ok and CodegenSourceMap::kind_at(map, form_index) == CodegenSourceMap::OriginKind.Form)

            bad_range: bool = CodegenSourceMap::add_span(&map, -1, 1, CodegenSourceMap::OriginKind.Form, "form1", "", "")
            past_end: bool = CodegenSourceMap::add_span(&map, 5, 7, CodegenSourceMap::OriginKind.Form, "form1", "", "")
            invalid_origin: bool = CodegenSourceMap::add_span(&map, 0, 1, CodegenSourceMap::OriginKind.Property, "form1", "node1", "")
            TestSupport::check("invalid byte ranges and incomplete property origins are rejected", not bad_range and not past_end and not invalid_origin and map.spans.count == 5)

            wrong_length_lookup: CodegenSourceMap::Lookup = CodegenSourceMap::lookup(map, "changed", 0)
            TestSupport::check("lookup rejects a stale map when generated byte length changes", not wrong_length_lookup.ok and wrong_length_lookup.code == CodegenSourceMap::Issue.StaleGeneratedFile)
            changed_bytes: darray[u8] = [97, 98, 195, 169, 99, 120]
            changed_lookup: CodegenSourceMap::Lookup = CodegenSourceMap::lookup(map, TestSupport::view_of(changed_bytes), 0)
            TestSupport::check("lookup rejects a stale map when same-length generated bytes change", not changed_lookup.ok and changed_lookup.code == CodegenSourceMap::Issue.StaleGeneratedFile)

            outside: CodegenSourceMap::Lookup = CodegenSourceMap::lookup(map, generated, 6)
            TestSupport::check("byte offsets beyond the generated file are rejected", not outside.ok and outside.code == CodegenSourceMap::Issue.InvalidByteOffset)

            return TestSupport::report("codegen_source_map")

def main() -> i64:
    return CodegenSourceMapTest::run()
