# Deterministic persisted source maps, strict decoding, and stale-byte guard.

include "../../src/codegen/source_map_json.elisa"
include "../model/test_support.elisa"

module CodegenSourceMapJsonTest:
    public:
        def run() -> i64:
            # Two UTF-8 bytes encode the character at generated byte offsets
            # [1,3), so the persisted range semantics can be checked directly.
            generated_bytes: darray[u8] = [97, 195, 169, 98, 99]
            generated: sview = TestSupport::view_of(generated_bytes)
            source_map: mutable CodegenSourceMap::SourceMap = CodegenSourceMap::empty(generated)
            added_form: bool = CodegenSourceMap::add_span(&source_map, 0, 5, CodegenSourceMap::OriginKind.Form, "form1", "", "")
            added_node: bool = CodegenSourceMap::add_span(&source_map, 0, 5, CodegenSourceMap::OriginKind.Node, "form1", "node1", "")
            added_property: bool = CodegenSourceMap::add_span(&source_map, 1, 3, CodegenSourceMap::OriginKind.Property, "form1", "node1", "caption")
            added_event: bool = CodegenSourceMap::add_span(&source_map, 3, 4, CodegenSourceMap::OriginKind.Event, "form1", "node1", "clicked")
            added_template: bool = CodegenSourceMap::add_span(&source_map, 4, 5, CodegenSourceMap::OriginKind.Template, "form1", "node1", "page-template")
            TestSupport::check("all source-map origin records are accepted", added_form and added_node and added_property and added_event and added_template)

            encoded: darray[u8] = CodegenSourceMapJson::encode(source_map, generated)
            encoded_again: darray[u8] = CodegenSourceMapJson::encode(source_map, generated)
            TestSupport::check("source-map JSON is deterministic", encoded.count > 0 and DesignText::equal(TestSupport::view_of(encoded), TestSupport::view_of(encoded_again)))
            TestSupport::check("generated hash exceeds exact JSON floating-point integer precision", source_map.generated_hash > 9007199254740991)

            decoded: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode(TestSupport::view_of(encoded), generated)
            TestSupport::check("source-map JSON round-trips and validates against exact bytes", decoded.ok and decoded.issue == CodegenSourceMapJson::Issue.None and CodegenSourceMap::validate(decoded.map, generated).ok)
            TestSupport::check("round-trip retains generated length, full-width hash, and UTF-8 byte ranges", decoded.map.generated_length == source_map.generated_length and decoded.map.generated_hash == source_map.generated_hash and decoded.map.spans[2].start_byte == 1 and decoded.map.spans[2].end_byte == 3)
            TestSupport::check("form, node, property, event, and template origins survive", decoded.map.spans.count == 5 and CodegenSourceMap::kind_at(decoded.map, 0) == CodegenSourceMap::OriginKind.Form and CodegenSourceMap::kind_at(decoded.map, 1) == CodegenSourceMap::OriginKind.Node and CodegenSourceMap::kind_at(decoded.map, 2) == CodegenSourceMap::OriginKind.Property and CodegenSourceMap::kind_at(decoded.map, 3) == CodegenSourceMap::OriginKind.Event and CodegenSourceMap::kind_at(decoded.map, 4) == CodegenSourceMap::OriginKind.Template)
            TestSupport::check("round-trip retains every origin field", DesignText::equal(CodegenSourceMap::form_id_at(decoded.map, 2), "form1") and DesignText::equal(CodegenSourceMap::node_id_at(decoded.map, 2), "node1") and DesignText::equal(CodegenSourceMap::member_at(decoded.map, 2), "caption") and DesignText::equal(CodegenSourceMap::member_at(decoded.map, 3), "clicked") and DesignText::equal(CodegenSourceMap::member_at(decoded.map, 4), "page-template"))

            stale_bytes: darray[u8] = [97, 195, 169, 98, 100]
            stale_decode: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode(TestSupport::view_of(encoded), TestSupport::view_of(stale_bytes))
            TestSupport::check("decoding against changed generated bytes is rejected", not stale_decode.ok and stale_decode.issue == CodegenSourceMapJson::Issue.StaleGeneratedBytes and stale_decode.map.spans.count == 0)
            stale_encode: darray[u8] = CodegenSourceMapJson::encode(source_map, TestSupport::view_of(stale_bytes))
            TestSupport::check("encoding refuses a map bound to different generated bytes", stale_encode.count == 0)

            malformed: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode("{", "abc")
            TestSupport::check("malformed JSON is rejected", not malformed.ok and malformed.issue == CodegenSourceMapJson::Issue.MalformedJson)

            duplicate_root: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode("{\"format\":\"elisa-ide-source-map\",\"format\":\"elisa-ide-source-map\",\"version\":1,\"generatedLength\":3,\"generatedHash\":\"e71fa2190541574b\",\"spans\":[]}", "abc")
            TestSupport::check("duplicate root keys are rejected", not duplicate_root.ok and duplicate_root.issue == CodegenSourceMapJson::Issue.DuplicateKey)

            duplicate_span: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode("{\"format\":\"elisa-ide-source-map\",\"version\":1,\"generatedLength\":3,\"generatedHash\":\"e71fa2190541574b\",\"spans\":[{\"startByte\":0,\"startByte\":1,\"endByte\":1,\"kind\":\"form\",\"formId\":\"form1\",\"nodeId\":\"\",\"member\":\"\"}]}", "abc")
            TestSupport::check("duplicate span keys are rejected", not duplicate_span.ok and duplicate_span.issue == CodegenSourceMapJson::Issue.DuplicateKey)

            unsupported: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode("{\"format\":\"elisa-ide-source-map\",\"version\":2,\"generatedLength\":3,\"generatedHash\":\"e71fa2190541574b\",\"spans\":[]}", "abc")
            TestSupport::check("unknown schema versions are rejected", not unsupported.ok and unsupported.issue == CodegenSourceMapJson::Issue.UnsupportedVersion)

            wrong_hash_shape: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode("{\"format\":\"elisa-ide-source-map\",\"version\":1,\"generatedLength\":3,\"generatedHash\":\"1234\",\"spans\":[]}", "abc")
            TestSupport::check("malformed hash metadata is rejected", not wrong_hash_shape.ok and wrong_hash_shape.issue == CodegenSourceMapJson::Issue.InvalidMetadata)

            wrong_range: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode("{\"format\":\"elisa-ide-source-map\",\"version\":1,\"generatedLength\":3,\"generatedHash\":\"e71fa2190541574b\",\"spans\":[{\"startByte\":2,\"endByte\":1,\"kind\":\"form\",\"formId\":\"form1\",\"nodeId\":\"\",\"member\":\"\"}]}", "abc")
            TestSupport::check("invalid ranges and origins fail closed", not wrong_range.ok and wrong_range.issue == CodegenSourceMapJson::Issue.InvalidSpan and wrong_range.map.spans.count == 0)

            wrong_kind: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode("{\"format\":\"elisa-ide-source-map\",\"version\":1,\"generatedLength\":3,\"generatedHash\":\"e71fa2190541574b\",\"spans\":[{\"startByte\":0,\"endByte\":1,\"kind\":\"unknown\",\"formId\":\"form1\",\"nodeId\":\"\",\"member\":\"\"}]}", "abc")
            TestSupport::check("unknown origin kinds are rejected", not wrong_kind.ok and wrong_kind.issue == CodegenSourceMapJson::Issue.InvalidSpan)

            wrong_format: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode("{\"format\":\"other\",\"version\":1,\"generatedLength\":3,\"generatedHash\":\"e71fa2190541574b\",\"spans\":[]}", "abc")
            TestSupport::check("wrong format marker is rejected", not wrong_format.ok and wrong_format.issue == CodegenSourceMapJson::Issue.InvalidFormat)

            return TestSupport::report("codegen_source_map_json")

def main() -> i64:
    return CodegenSourceMapJsonTest::run()
