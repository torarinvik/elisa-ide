# Ownership manifest structure and overwrite/delete preflight are pure core
# operations over caller-supplied file snapshots; no filesystem is touched.

include "../../src/codegen/generation_manifest.elisa"
include "../model/test_support.elisa"

module GenerationManifestTest:
    private:
        def has_error(actual: GenerationManifest::Validation, expected: GenerationManifest::Issue) -> bool:
            return not actual.ok and actual.code == expected

        def one_file(path: sview, content: sview) -> darray[GenerationManifest::CurrentFile]:
            files: mutable darray[GenerationManifest::CurrentFile] = []
            files.push(GenerationManifest::CurrentFile{relative_path: path, content: content})
            return files

        def make_old_manifest() -> GenerationManifest::Manifest:
            manifest: mutable GenerationManifest::Manifest = GenerationManifest::empty("elisa-ui.sdl3.handles.v1", "elisa-ui@framework-42", 0xabc123)
            _ = GenerationManifest::add_file(manifest, "generated/settings_view.elisa", "old generated view\n")
            _ = GenerationManifest::add_file(manifest, "generated/obsolete_controls.elisa", "old generated controls\n")
            return manifest

        def make_next_manifest() -> GenerationManifest::Manifest:
            manifest: mutable GenerationManifest::Manifest = GenerationManifest::empty("elisa-ui.sdl3.handles.v1", "elisa-ui@framework-43", 0xdef456)
            _ = GenerationManifest::add_file(manifest, "generated/settings_view.elisa", "new generated view\n")
            _ = GenerationManifest::add_file(manifest, "generated/application.elisa", "new generated application\n")
            return manifest

    public:
        def run() -> i64:
            old: mutable GenerationManifest::Manifest = make_old_manifest()
            next: mutable GenerationManifest::Manifest = make_next_manifest()
            old_valid: GenerationManifest::Validation = GenerationManifest::validate(old)
            TestSupport::check("manifest version and metadata validate", old_valid.ok and old.version == GenerationManifest::SUPPORTED_VERSION)
            TestSupport::check("target and framework IDs are recorded", DesignValues::text_of(old.strings, old.target_id).len > 0 and DesignValues::text_of(old.strings, old.framework_id).len > 0)
            TestSupport::check("document hash is retained", old.document_hash == 0xabc123)
            TestSupport::check("generated bytes are fingerprinted", old.files[0].content_hash == Fingerprint::fnv1a64("old generated view\n"))

            encoding_sink: mutable DesignDiagnostics::Sink = TestSupport::sink()
            encoded: darray[u8] = GenerationManifest::encode(old, &encoding_sink)
            encoded_again: darray[u8] = GenerationManifest::encode(old, &encoding_sink)
            TestSupport::check("manifest encoding is deterministic", DesignText::equal(TestSupport::view_of(encoded), TestSupport::view_of(encoded_again)))
            decoded_sink: mutable DesignDiagnostics::Sink = TestSupport::sink()
            decoded: mutable GenerationManifest::Manifest = GenerationManifest::decode(TestSupport::view_of(encoded), &decoded_sink)
            TestSupport::check("manifest JSON round-trips with no diagnostics", not DesignDiagnostics::has_errors(decoded_sink) and GenerationManifest::validate(decoded).ok)
            TestSupport::check("manifest JSON preserves file list and hashes", decoded.files.count == old.files.count and decoded.files[0].content_hash == old.files[0].content_hash and DesignText::equal(DesignValues::text_of(decoded.strings, decoded.files[1].relative_path), "generated/obsolete_controls.elisa"))

            full_width_hash: mutable GenerationManifest::Manifest = GenerationManifest::empty("target", "framework", 0xfedcba9876543210)
            _ = GenerationManifest::add_hashed_file(&full_width_hash, "generated/full_width.elisa", 0x8123456789abcdef)
            full_width_json: darray[u8] = GenerationManifest::encode(full_width_hash, &encoding_sink)
            full_width_copy: GenerationManifest::Manifest = GenerationManifest::decode(TestSupport::view_of(full_width_json), &decoded_sink)
            TestSupport::check("hex encoding preserves every bit of 64-bit hashes", full_width_copy.document_hash == 0xfedcba9876543210 and full_width_copy.files[0].content_hash == 0x8123456789abcdef)
            malformed_sink: mutable DesignDiagnostics::Sink = TestSupport::sink()
            malformed: GenerationManifest::Manifest = GenerationManifest::decode("{", &malformed_sink)
            TestSupport::check("malformed ownership data fails closed with an error", not GenerationManifest::validate(malformed).ok and DesignDiagnostics::has_errors(malformed_sink))
            duplicate_manifest_sink: mutable DesignDiagnostics::Sink = TestSupport::sink()
            _ = GenerationManifest::decode("{\"format\":\"elisa-ide-generation-manifest\",\"format\":\"elisa-ide-generation-manifest\"}", &duplicate_manifest_sink)
            TestSupport::check("duplicate ownership keys are rejected", DesignDiagnostics::has_errors(duplicate_manifest_sink))

            previous_bytes: darray[GenerationManifest::CurrentFile] = [
                GenerationManifest::CurrentFile{relative_path: "generated/settings_view.elisa", content: "old generated view\n"},
                GenerationManifest::CurrentFile{relative_path: "generated/obsolete_controls.elisa", content: "old generated controls\n"},
            ]
            replacement: GenerationManifest::Validation = GenerationManifest::validate_transition(old, next, previous_bytes)
            TestSupport::check("unchanged owned files may be replaced and obsolete generated files removed", replacement.ok)

            edited_bytes: darray[GenerationManifest::CurrentFile] = [
                GenerationManifest::CurrentFile{relative_path: "generated/settings_view.elisa", content: "hand-edited by user\n"},
                GenerationManifest::CurrentFile{relative_path: "generated/obsolete_controls.elisa", content: "old generated controls\n"},
            ]
            edited: GenerationManifest::Validation = GenerationManifest::validate_transition(old, next, edited_bytes)
            TestSupport::check("user-modified generated output is preserved by rejecting overwrite", has_error(edited, GenerationManifest::Issue.ModifiedOwnedFile) and edited.current_index == 0)

            obsolete_manifest: mutable GenerationManifest::Manifest = GenerationManifest::empty("target-v1", "framework-v1", 1)
            _ = GenerationManifest::add_file(obsolete_manifest, "generated/old_view.elisa", "last generated bytes")
            no_outputs: GenerationManifest::Manifest = GenerationManifest::empty("target-v1", "framework-v1", 2)
            intact_obsolete: GenerationManifest::Validation = GenerationManifest::validate_transition(obsolete_manifest, no_outputs, one_file("generated/old_view.elisa", "last generated bytes"))
            TestSupport::check("obsolete file deletion is allowed when bytes match ownership hash", intact_obsolete.ok)
            edited_obsolete: GenerationManifest::Validation = GenerationManifest::validate_transition(obsolete_manifest, no_outputs, one_file("generated/old_view.elisa", "user edits"))
            TestSupport::check("obsolete deletion is rejected after user edits", has_error(edited_obsolete, GenerationManifest::Issue.ModifiedOwnedFile))
            missing_obsolete: GenerationManifest::Validation = GenerationManifest::validate_transition(obsolete_manifest, no_outputs, [])
            TestSupport::check("already-missing obsolete output is harmless", missing_obsolete.ok)

            unowned_manifest: mutable GenerationManifest::Manifest = GenerationManifest::empty("target-v1", "framework-v1", 3)
            _ = GenerationManifest::add_file(unowned_manifest, "generated/user_file.elisa", "generator would replace this")
            unowned_collision: GenerationManifest::Validation = GenerationManifest::validate_transition(no_outputs, unowned_manifest, one_file("generated/user_file.elisa", "handwritten source"))
            TestSupport::check("new output cannot claim an existing unowned file", has_error(unowned_collision, GenerationManifest::Issue.UnownedOutputCollision))

            absolute: mutable GenerationManifest::Manifest = GenerationManifest::empty("target", "framework", 0)
            _ = GenerationManifest::add_file(absolute, "/Users/me/app.elisa", "bytes")
            TestSupport::check("absolute POSIX output paths are rejected", has_error(GenerationManifest::validate(absolute), GenerationManifest::Issue.InvalidManifestPath))
            windows_absolute: mutable GenerationManifest::Manifest = GenerationManifest::empty("target", "framework", 0)
            _ = GenerationManifest::add_file(windows_absolute, "C:/project/app.elisa", "bytes")
            TestSupport::check("absolute Windows output paths are rejected", has_error(GenerationManifest::validate(windows_absolute), GenerationManifest::Issue.InvalidManifestPath))
            traversal: mutable GenerationManifest::Manifest = GenerationManifest::empty("target", "framework", 0)
            _ = GenerationManifest::add_file(traversal, "generated/../src/app.elisa", "bytes")
            TestSupport::check("parent traversal segments are rejected", has_error(GenerationManifest::validate(traversal), GenerationManifest::Issue.InvalidManifestPath))
            dot_segment: mutable GenerationManifest::Manifest = GenerationManifest::empty("target", "framework", 0)
            _ = GenerationManifest::add_file(dot_segment, "generated/./app.elisa", "bytes")
            TestSupport::check("dot segments are rejected rather than normalized silently", has_error(GenerationManifest::validate(dot_segment), GenerationManifest::Issue.InvalidManifestPath))
            backslash: mutable GenerationManifest::Manifest = GenerationManifest::empty("target", "framework", 0)
            _ = GenerationManifest::add_file(backslash, "generated\\app.elisa", "bytes")
            TestSupport::check("backslash paths are rejected as non-normalized", has_error(GenerationManifest::validate(backslash), GenerationManifest::Issue.InvalidManifestPath))

            duplicate: mutable GenerationManifest::Manifest = GenerationManifest::empty("target", "framework", 0)
            _ = GenerationManifest::add_file(duplicate, "generated/view.elisa", "first")
            _ = GenerationManifest::add_file(duplicate, "generated/view.elisa", "second")
            TestSupport::check("duplicate generated manifest entries are rejected", has_error(GenerationManifest::validate(duplicate), GenerationManifest::Issue.DuplicateManifestPath))

            duplicate_current: darray[GenerationManifest::CurrentFile] = [
                GenerationManifest::CurrentFile{relative_path: "other/one.elisa", content: "1"},
                GenerationManifest::CurrentFile{relative_path: "other/one.elisa", content: "2"},
            ]
            duplicate_snapshot: GenerationManifest::Validation = GenerationManifest::validate_transition(no_outputs, no_outputs, duplicate_current)
            TestSupport::check("ambiguous duplicate current snapshot paths are rejected", has_error(duplicate_snapshot, GenerationManifest::Issue.DuplicateCurrentPath))
            bad_snapshot: GenerationManifest::Validation = GenerationManifest::validate_transition(no_outputs, no_outputs, one_file("../outside.elisa", "bytes"))
            TestSupport::check("unsafe observed paths are rejected before reconciliation", has_error(bad_snapshot, GenerationManifest::Issue.InvalidCurrentPath))

            wrong_version: mutable GenerationManifest::Manifest = GenerationManifest::empty("target", "framework", 0)
            wrong_version.version <- 2
            TestSupport::check("unknown ownership manifest versions are rejected", has_error(GenerationManifest::validate(wrong_version), GenerationManifest::Issue.UnsupportedVersion))
            missing_target: GenerationManifest::Manifest = GenerationManifest::empty("", "framework", 0)
            TestSupport::check("missing target identity is rejected", has_error(GenerationManifest::validate(missing_target), GenerationManifest::Issue.InvalidTargetId))

            return TestSupport::report("generation_manifest")

def main() -> i64:
    return GenerationManifestTest::run()
