# User-owned handlers included explicitly by the generated application file.
# The generated view references these names; this module stays outside generator
# ownership so regeneration cannot replace application behavior.
global mutable save_click_count: i64 = 0
global mutable name_change_count: i64 = 0
global mutable volume_change_count: i64 = 0

module SettingsHandlers:
    public:
        def name_changed(widget: usize, event: i32) -> void:
            name_change_count <- name_change_count + 1
            status: UiHandles::Handle = settings_view::widget_status_label()
            UiHandles::set_text(status, "Changes are not saved", 13.0, UiCore::rgb(174, 184, 204))

        def volume_changed(widget: usize, event: i32) -> void:
            volume_change_count <- volume_change_count + 1
            slider: UiHandles::Handle = settings_view::widget_volume_slider()
            progress: UiHandles::Handle = settings_view::widget_volume_progress()
            value: f32 = UiHandles::value(slider)
            UiHandles::set_value(progress, value)
            display: UiHandles::Handle = settings_view::widget_volume_display()
            if value < 0.34:
                UiHandles::set_text(display, "Volume: Low", 13.0, UiCore::rgb(205, 214, 232))
            elif value < 0.67:
                UiHandles::set_text(display, "Volume: Medium", 13.0, UiCore::rgb(205, 214, 232))
            else:
                UiHandles::set_text(display, "Volume: High", 13.0, UiCore::rgb(205, 214, 232))
            status: UiHandles::Handle = settings_view::widget_status_label()
            UiHandles::set_text(status, "Changes are not saved", 13.0, UiCore::rgb(174, 184, 204))

        def reset_clicked(widget: usize, event: i32) -> void:
            name: UiHandles::Handle = settings_view::widget_name_input()
            UiHandles::replace_text(name, "Ada")
            dark_mode: UiHandles::Handle = settings_view::widget_dark_mode()
            UiHandles::set_selected(dark_mode, false)
            blue: UiHandles::Handle = settings_view::widget_accent_blue()
            green: UiHandles::Handle = settings_view::widget_accent_green()
            UiHandles::set_selected(blue, true)
            UiHandles::set_selected(green, false)
            slider: UiHandles::Handle = settings_view::widget_volume_slider()
            progress: UiHandles::Handle = settings_view::widget_volume_progress()
            UiHandles::set_value(slider, 0.5)
            UiHandles::set_value(progress, 0.5)
            display: UiHandles::Handle = settings_view::widget_volume_display()
            UiHandles::set_text(display, "Volume: Medium", 13.0, UiCore::rgb(205, 214, 232))
            status: UiHandles::Handle = settings_view::widget_status_label()
            UiHandles::set_text(status, "Changes are not saved", 13.0, UiCore::rgb(174, 184, 204))

        def save_clicked(widget: usize, event: i32) -> void:
            save_click_count <- save_click_count + 1
            status: UiHandles::Handle = settings_view::widget_status_label()
            UiHandles::set_text(status, "Saved", 13.0, UiCore::rgb(114, 202, 148))

        def save_click_count_value() -> i64:
            return save_click_count

        def name_change_count_value() -> i64:
            return name_change_count

        def volume_change_count_value() -> i64:
            return volume_change_count
