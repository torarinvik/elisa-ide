def drag_handle_to(source: UiHandles::Handle, target: UiHandles::Handle) -> void:
    return if not UiHandles::is_valid(source) or not UiHandles::is_valid(target)
    if UiHandles::widget(source) is source_widget:
        if UiHandles::widget(target) is target_widget:
            source_x: f32 = source_widget.x + source_widget.width * 0.5
            source_y: f32 = source_widget.y + source_widget.height * 0.5
            target_x: f32 = target_widget.x + target_widget.width * 0.5
            target_y: f32 = target_widget.y + target_widget.height * 0.5
            UiHarness::dispatch(UiCore::PointerEvent.Down(at: UiCore::Vec2(source_x, source_y), button: UiCore::PointerButton.Primary.i32()))
            UiHarness::dispatch(UiCore::PointerEvent.Move(UiCore::Vec2(target_x, target_y)))
            UiHarness::dispatch(UiCore::PointerEvent.Up(at: UiCore::Vec2(target_x, target_y), button: UiCore::PointerButton.Primary.i32()))

def test_drag_editing() -> void:
    _ = HostClient::request(host_process, 10, 0, 0)
    refresh_all(shell, host_process)
    drag_handle_to(shell.palette_rows[4.usize()], shell.hierarchy_rows[0.usize()])
    expect_integration(shell.projection.node_count == 2 and shell.projection.selection_count == 1, 170)
    expect_integration(same_text(UiHandles::text_value(shell.inspector_editors[0.usize()]), "Button"), 171)

    _ = HostClient::request(host_process, 10, 0, 0)
    _ = HostClient::request(host_process, 30, 1, 0)
    _ = HostClient::request(host_process, 31, 0, 0)
    _ = HostClient::request(host_process, 30, 4, 0)
    refresh_all(shell, host_process)
    expect_integration(shell.projection.hierarchy_count == 3, 172)
    drag_handle_to(shell.hierarchy_rows[2.usize()], shell.hierarchy_rows[1.usize()])
    expect_integration(shell.drag_kind == 0 and shell.projection.dirty, 173)
    path_after_drag: HostClient::HostReply = HostClient::request(host_process, 63, 0, 0)
    expect_integration(path_after_drag.result == 1 and same_text(ShellBytes::view_of(&path_after_drag.text), "Column / Row / Button"), 174)
    command(shell, 13, 0)
    path_after_undo: HostClient::HostReply = HostClient::request(host_process, 63, 0, 0)
    expect_integration(path_after_undo.result == 1 and same_text(ShellBytes::view_of(&path_after_undo.text), "Column / Button"), 175)

    # A self/leaf target gets red feedback and does not mutate the graph.
    before_invalid: i64 = shell.projection.node_count
    drag_handle_to(shell.hierarchy_rows[2.usize()], shell.hierarchy_rows[2.usize()])
    expect_integration(shell.projection.node_count == before_invalid, 176)

    # Escape and pointer leave cancel an in-flight drag before release.
    root_count_before_cancel: i64 = shell.projection.node_count
    if UiHandles::widget(shell.palette_rows[4.usize()]) is palette_widget:
        if UiHandles::widget(shell.hierarchy_rows[0.usize()]) is root_widget:
            UiHarness::dispatch(UiCore::PointerEvent.Down(at: UiCore::Vec2(palette_widget.x + 4.0, palette_widget.y + 4.0), button: UiCore::PointerButton.Primary.i32()))
            UiHarness::dispatch(UiCore::PointerEvent.Move(UiCore::Vec2(root_widget.x + root_widget.width * 0.5, root_widget.y + root_widget.height * 0.5)))
            UiHarness::dispatch(UiCore::KeyEvent.Down(UiCore::Key.Escape))
            expect_integration(shell.projection.node_count == root_count_before_cancel and shell.drag_kind == 0, 177)
            UiHarness::dispatch(UiCore::PointerEvent.Down(at: UiCore::Vec2(palette_widget.x + 4.0, palette_widget.y + 4.0), button: UiCore::PointerButton.Primary.i32()))
            UiHarness::dispatch(UiCore::PointerEvent.Move(UiCore::Vec2(root_widget.x + root_widget.width * 0.5, root_widget.y + root_widget.height * 0.5)))
            UiHarness::dispatch(UiCore::PointerEvent.Leave)
            expect_integration(shell.projection.node_count == root_count_before_cancel and shell.drag_kind == 0, 178)
    _ = HostClient::request(host_process, 10, 0, 0)
    refresh_all(shell, host_process)

def click_with_modifier(handle: UiHandles::Handle, modifier: UiCore::Key) -> void:
    UiHarness::dispatch(UiCore::KeyEvent.Down(modifier))
    click(handle)
    UiHarness::dispatch(UiCore::KeyEvent.Up(modifier))

def test_hierarchy_multi_selection() -> void:
    # Build two siblings and exercise actual retained hierarchy callbacks with
    # both platform selection modifiers, then delete/undo the selected roots.
    _ = HostClient::request(host_process, 10, 0, 0)
    _ = HostClient::request(host_process, 30, 4, 0)
    _ = HostClient::request(host_process, 31, 0, 0)
    _ = HostClient::request(host_process, 30, 3, 0)
    refresh_all(shell, host_process)
    expect_integration(shell.projection.hierarchy_count == 3, 100)

    click(shell.hierarchy_rows[0.usize()])
    click_with_modifier(shell.hierarchy_rows[1.usize()], UiCore::Key.LeftControl)
    row_zero: HostClient::HostReply = HostClient::request(host_process, 43, 0, 0)
    row_one: HostClient::HostReply = HostClient::request(host_process, 43, 1, 0)
    expect_integration(shell.projection.selection_count == 2 and row_zero.result == 1 and row_one.result == 1, 101)
    expect_integration(shell.hierarchy_breadcrumb_count == 2
        and same_text(UiFlat::widget(shell.hierarchy_breadcrumb_segments[0.usize()].widget_id.usize()).text, "Column")
        and same_text(UiFlat::widget(shell.hierarchy_breadcrumb_segments[1.usize()].widget_id.usize()).text, "Button"), 113)

    click_with_modifier(shell.hierarchy_rows[2.usize()], UiCore::Key.LeftControl)
    expect_integration(shell.projection.selection_count == 3, 102)
    expect_integration(shell.hierarchy_breadcrumb_count == 2
        and same_text(UiFlat::widget(shell.hierarchy_breadcrumb_segments[0.usize()].widget_id.usize()).text, "Column")
        and same_text(UiFlat::widget(shell.hierarchy_breadcrumb_segments[1.usize()].widget_id.usize()).text, "Label"), 114)
    click_with_modifier(shell.hierarchy_rows[1.usize()], UiCore::Key.LeftControl)
    row_one_after_toggle: HostClient::HostReply = HostClient::request(host_process, 43, 1, 0)
    expect_integration(shell.projection.selection_count == 2 and row_one_after_toggle.result == 0, 103)

    click_with_modifier(shell.hierarchy_rows[1.usize()], UiCore::Key.LeftSuper)
    expect_integration(shell.projection.selection_count == 3, 104)
    click_with_modifier(shell.hierarchy_rows[1.usize()], UiCore::Key.LeftSuper)
    expect_integration(shell.projection.selection_count == 2, 105)

    click(shell.hierarchy_rows[2.usize()])
    row_zero_after_plain: HostClient::HostReply = HostClient::request(host_process, 43, 0, 0)
    row_two_after_plain: HostClient::HostReply = HostClient::request(host_process, 43, 2, 0)
    expect_integration(shell.projection.selection_count == 1
        and row_zero_after_plain.result == 0 and row_two_after_plain.result == 1, 106)

    click(shell.hierarchy_rows[1.usize()])
    click_with_modifier(shell.hierarchy_rows[0.usize()], UiCore::Key.LeftShift)
    range_row_zero: HostClient::HostReply = HostClient::request(host_process, 43, 0, 0)
    range_row_one: HostClient::HostReply = HostClient::request(host_process, 43, 1, 0)
    range_row_two: HostClient::HostReply = HostClient::request(host_process, 43, 2, 0)
    expect_integration(shell.projection.selection_count == 2
        and range_row_zero.result == 1 and range_row_one.result == 1 and range_row_two.result == 0, 110)
    click_with_modifier(shell.hierarchy_rows[2.usize()], UiCore::Key.LeftShift)
    repeated_range_row_zero: HostClient::HostReply = HostClient::request(host_process, 43, 0, 0)
    repeated_range_row_one: HostClient::HostReply = HostClient::request(host_process, 43, 1, 0)
    repeated_range_row_two: HostClient::HostReply = HostClient::request(host_process, 43, 2, 0)
    expect_integration(shell.projection.selection_count == 2
        and repeated_range_row_zero.result == 0 and repeated_range_row_one.result == 1 and repeated_range_row_two.result == 1, 112)
    click(shell.hierarchy_rows[2.usize()])
    expect_integration(shell.projection.selection_count == 1, 111)

    click(shell.hierarchy_rows[1.usize()])
    click_with_modifier(shell.hierarchy_rows[2.usize()], UiCore::Key.LeftControl)
    expect_integration(shell.projection.selection_count == 2, 107)
    command(shell, 12, 0)
    expect_integration(shell.projection.hierarchy_count == 1, 108)
    command(shell, 13, 0)
    expect_integration(shell.projection.hierarchy_count == 3, 109)
    click(shell.hierarchy_rows[2.usize()])
    expect_integration(shell.hierarchy_breadcrumb_count == 2
        and same_text(UiFlat::widget(shell.hierarchy_breadcrumb_segments[1.usize()].widget_id.usize()).text, "Label"), 115)
    click(shell.hierarchy_breadcrumb_segments[0.usize()])
    breadcrumb_root_selected: HostClient::HostReply = HostClient::request(host_process, 43, 0, 0)
    expect_integration(shell.projection.selection_count == 1 and breadcrumb_root_selected.result == 1
        and shell.hierarchy_breadcrumb_count == 1
        and same_text(UiFlat::widget(shell.hierarchy_breadcrumb_segments[0.usize()].widget_id.usize()).text, "Column"), 116)
    _ = HostClient::request(host_process, 10, 0, 0)
    refresh_all(shell, host_process)

def test_deep_hierarchy_breadcrumb() -> void:
    # The breadcrumb keeps a bounded number of visible segments and lets the
    # leading ellipsis jump back to the end of the first fully visible chunk.
    _ = HostClient::request(host_process, 10, 0, 0)
    for depth in 0..<7:
        _ = HostClient::request(host_process, 30, 0, 0)
    refresh_all(shell, host_process)
    expect_integration(shell.projection.hierarchy_count == 8
        and shell.hierarchy_breadcrumb_truncated
        and shell.hierarchy_breadcrumb_count == MAX_HIERARCHY_BREADCRUMB_SEGMENTS
        and same_text(UiFlat::widget(shell.hierarchy_breadcrumb_segments[0.usize()].widget_id.usize()).text, "..."), 117)
    ellipsis_ancestor_row: HostClient::HostReply = HostClient::request(host_process, 65, MAX_HIERARCHY_BREADCRUMB_SEGMENTS - 1, 0)
    expect_integration(ellipsis_ancestor_row.result == 2, 123)
    ellipsis_widget: UiFlat::Widget = UiFlat::widget(shell.hierarchy_breadcrumb_segments[0.usize()].widget_id.usize())
    ellipsis_hit: usize = UiFlat::hit(ellipsis_widget.x + ellipsis_widget.width * 0.5, ellipsis_widget.y + ellipsis_widget.height * 0.5)
    expect_integration(ellipsis_hit == shell.hierarchy_breadcrumb_segments[0.usize()].widget_id.usize(), 127)
    click(shell.hierarchy_breadcrumb_segments[0.usize()])
    selected_hidden_ancestor: HostClient::HostReply = HostClient::request(host_process, 43, 2, 0)
    selected_deep_node: HostClient::HostReply = HostClient::request(host_process, 43, 7, 0)
    expect_integration(shell.projection.selection_count == 1, 118)
    expect_integration(selected_hidden_ancestor.result == 1, 119)
    expect_integration(selected_deep_node.result == 0, 120)
    expect_integration(not shell.hierarchy_breadcrumb_truncated, 121)
    expect_integration(shell.hierarchy_breadcrumb_count == 3, 122)
    _ = HostClient::request(host_process, 10, 0, 0)
    refresh_all(shell, host_process)

def test_keyboard_reorder_shortcuts() -> void:
    # Build two siblings directly through the real host, then use the public
    # key-event path to exercise application shortcut resolution and refresh.
    _ = HostClient::request(host_process, 10, 0, 0)
    dispatch_insert_shortcut()
    expect_integration(shell.projection.node_count == 2 and shell.projection.selection_count == 1, 154)
    command(shell, 13, 0)
    expect_integration(shell.projection.node_count == 1, 155)
    command(shell, 14, 0)
    expect_integration(shell.projection.node_count == 2, 156)
    command(shell, 13, 0)
    _ = HostClient::request(host_process, 30, 4, 0)
    _ = HostClient::request(host_process, 31, 0, 0)
    _ = HostClient::request(host_process, 30, 3, 0)
    _ = HostClient::request(host_process, 31, 1, 0)
    refresh_all(shell, host_process)

    button_type: HostClient::HostReply = HostClient::request(host_process, 51, 1, 0)
    label_type: HostClient::HostReply = HostClient::request(host_process, 51, 2, 0)
    expect_integration(shell.projection.node_count == 3
        and not same_text(ShellBytes::view_of(&button_type.text), ShellBytes::view_of(&label_type.text)), 90)

    # Editable text gets first refusal even when the design selection is a
    # reorderable node.
    focused_edit_field: UiHandles::Handle = shell.compact_open_path_field if shell.compact_mode else shell.open_path_field
    _ = UiHandles::request_focus(focused_edit_field)
    expect_integration(UiHandles::is_focused(focused_edit_field) and shell_text_focus(shell), 97)
    dispatch_reorder_shortcut(UiCore::Key.Down)
    row_after_focused_key: HostClient::HostReply = HostClient::request(host_process, 51, 1, 0)
    expect_integration(same_text(ShellBytes::view_of(&row_after_focused_key.text), ShellBytes::view_of(&button_type.text)), 91)
    UiFlat::clear_focus()

    dispatch_reorder_shortcut(UiCore::Key.Down)
    row_one_after_down: HostClient::HostReply = HostClient::request(host_process, 51, 1, 0)
    row_two_after_down: HostClient::HostReply = HostClient::request(host_process, 51, 2, 0)
    selection_after_down: HostClient::HostReply = HostClient::request(host_process, 55, 0, 0)
    expect_integration(same_text(ShellBytes::view_of(&row_one_after_down.text), ShellBytes::view_of(&label_type.text))
        and same_text(ShellBytes::view_of(&row_two_after_down.text), ShellBytes::view_of(&button_type.text)), 92)
    expect_integration(same_text(ShellBytes::view_of(&selection_after_down.text), ShellBytes::view_of(&button_type.text)), 93)

    dispatch_reorder_shortcut(UiCore::Key.Up)
    row_one_after_up: HostClient::HostReply = HostClient::request(host_process, 51, 1, 0)
    row_two_after_up: HostClient::HostReply = HostClient::request(host_process, 51, 2, 0)
    expect_integration(same_text(ShellBytes::view_of(&row_one_after_up.text), ShellBytes::view_of(&button_type.text))
        and same_text(ShellBytes::view_of(&row_two_after_up.text), ShellBytes::view_of(&label_type.text)), 94)

    dispatch_reorder_shortcut(UiCore::Key.Up)
    boundary_row_one: HostClient::HostReply = HostClient::request(host_process, 51, 1, 0)
    expect_integration(same_text(ShellBytes::view_of(&boundary_row_one.text), ShellBytes::view_of(&button_type.text)), 95)
    command(shell, 13, 0)
    command(shell, 13, 0)
    command(shell, 13, 0)
    command(shell, 13, 0)
    refresh_all(shell, host_process)
    expect_integration(shell.projection.node_count == 1 and not shell.projection.dirty, 96)

def app_init() -> void:
    _ = PosixFile::remove(SAVE_PATH)
    clean_generated_project()
    _ = PosixFile::remove(PROJECT_HANDLERS_PATH)
    _ = PosixFile::remove_directory_if_empty("build/New Elisa Project/src")
    clean_test_project(PROJECT_FORM_PATH, PROJECT_MANIFEST_PATH, "build/New Elisa Project/forms", PROJECT_ROOT_PATH)
    clean_compact_generated_project()
    clean_test_project(COMPACT_PROJECT_FORM_PATH, COMPACT_PROJECT_MANIFEST_PATH, "build/Compact Elisa Project/forms", COMPACT_PROJECT_ROOT_PATH)
    _ = PosixFile::remove("build/shell-integration-preferences.json")
    _ = integration_setenv("ELISA_IDE_CONFIG", "build/shell-integration-preferences.json")
    init(shell)

def app_widget_event(widget: usize, event: i32) -> void:
    widget_event(shell, widget, event)

def app_event(event: UiCore::Event) -> void:
    handle_shell_event(shell, event)

def app_text_input(text: sview) -> void:
    UiHandles::insert_text(text)

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    UiHandles::update_marked_text_utf8_characters(text, selected_start, selected_length)

def app_frame() -> void:
    frame(shell)

def test_related_dirty_guard() -> void:
    expect_integration(widget_event_rows(shell, shell.problem_rows[0.usize()].widget_id.usize())
        and UiHandles::is_enabled(shell.problem_related_button), 232)
    related_button_label: sview = UiFlat::widget(shell.problem_related_button.widget_id.usize()).text
    expect_integration(same_text(related_button_label, "Related 1/4"), 233)
    open_document(shell)
    open_guard_title: sview = UiFlat::widget(shell.source_title.widget_id.usize()).text
    expect_integration(shell.source_mode and same_text(open_guard_title, "Elisa source (modified)")
        and bytes_contain(geometry_bytes(status_view(shell)), "Save this source file before opening another"), 246)
    _ = widget_event_rows(shell, shell.problem_related_button.widget_id.usize())
    blocked_title: sview = UiFlat::widget(shell.source_title.widget_id.usize()).text
    expect_integration(shell.source_mode and same_text(blocked_title, "Elisa source (modified)")
        and bytes_contain(geometry_bytes(status_view(shell)), "Save this source file before opening"), 234)
    UiHandles::set_text(shell.build_output, "build/shell-source-edit.elisa:4:5: error: source fixture error", 11.0, shell_color(172, 184, 204))
    shell.build_problem_count <- build_diagnostic_count(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    refresh_problems(shell, host_process)
    _ = widget_event_rows(shell, shell.problem_rows[1.usize()].widget_id.usize())
    build_mapped_line: sview = UiHandles::text_value(shell.source_line_rows[3.usize()])
    expect_integration(shell.build_problem_count == 1 and shell.source_selected_line == 4
        and bytes_contain(geometry_bytes(build_mapped_line), "Source editor paging fixture, line 4.")
        and UiFlat::selection_utf16_location(shell.source_line_rows[3.usize()].widget_id.usize())
            == source_line_prefix(shell, 4).count + 4
        and bytes_contain(geometry_bytes(status_view(shell)), "Selected build diagnostic at source line 4"), 247)
    UiHandles::set_text(shell.build_output, "build/shell-source-edit.elisa(3,2): error: parenthesized fixture error", 11.0, shell_color(172, 184, 204))
    shell.build_problem_count <- build_diagnostic_count(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    refresh_problems(shell, host_process)
    _ = widget_event_rows(shell, shell.problem_rows[1.usize()].widget_id.usize())
    parenthesized_mapped_line: sview = UiHandles::text_value(shell.source_line_rows[2.usize()])
    expect_integration(shell.build_problem_count == 1 and shell.source_selected_line == 3
        and bytes_contain(geometry_bytes(parenthesized_mapped_line), "Source editor paging fixture, line 3.")
        and UiFlat::selection_utf16_location(shell.source_line_rows[2.usize()].widget_id.usize())
            == source_line_prefix(shell, 3).count + 1
        and bytes_contain(geometry_bytes(status_view(shell)), "Selected build diagnostic at source line 3"), 248)
    UiHandles::set_text(shell.build_output, "build/shell-source-edit.elisa(3,): error: malformed fixture column", 11.0, shell_color(172, 184, 204))
    shell.build_problem_count <- build_diagnostic_count(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    refresh_problems(shell, host_process)
    _ = widget_event_rows(shell, shell.problem_rows[1.usize()].widget_id.usize())
    expect_integration(shell.build_problem_count == 1 and shell.source_selected_line == 3
        and bytes_contain(geometry_bytes(status_view(shell)), "Build diagnostic source mapping is unavailable"), 249)

def test_related_cycle() -> void:
    related_target_uri: sview = selected_related_uri(shell, 0)
    expect_integration(bytes_contain(geometry_bytes(related_target_uri), "Related%20Elisa%20Source.elisa"), 241)
    decoded_related_target: darray[u8] = decode_local_file_uri(related_target_uri)
    expect_integration(bytes_contain(decoded_related_target, "Related Elisa Source.elisa"), 242)
    _ = widget_event_rows(shell, shell.problem_related_button.widget_id.usize())
    related_first_line: sview = UiHandles::text_value(shell.source_line_rows[0.usize()])
    expect_integration(shell.source_mode, 235)
    expect_integration(bytes_contain(geometry_bytes(status_view(shell)), "Opened related Elisa-LSP location 1 of 4 at line 1"), 240)
    expect_integration(bytes_contain(geometry_bytes(related_first_line), "module related_fixture:"), 237)
    expect_integration(shell.source_selected_line == 1, 238)
    expect_integration(UiFlat::selection_utf16_location(shell.source_line_rows[0.usize()].widget_id.usize())
        == source_line_prefix(shell, 1).count + 2, 239)
    _ = widget_event_rows(shell, shell.problem_related_button.widget_id.usize())
    next_related_line: sview = UiHandles::text_value(shell.source_line_rows[3.usize()])
    expect_integration(shell.source_selected_line == 4
        and bytes_contain(geometry_bytes(next_related_line), "Source editor paging fixture, line 4.")
        and UiFlat::selection_utf16_location(shell.source_line_rows[3.usize()].widget_id.usize())
            == source_line_prefix(shell, 4).count + 4
        and bytes_contain(geometry_bytes(status_view(shell)), "Opened related Elisa-LSP location 2 of 4 at line 4"), 236)

def test_toolchain_doctor() -> void:
    shortcut_capacity: UiShortcuts::Snapshot = UiShortcuts::snapshot()
    expect_integration(not shortcut_capacity.overflowed, 462)
    doctor_shortcut: UiShortcuts::Decision = UiShortcuts::resolve(
        UiCore::Key.D.i32(),
        UiShortcuts::MOD_SUPER | UiShortcuts::MOD_ALT | UiShortcuts::MOD_SHIFT,
        false,
        false,
    )
    expect_integration(doctor_shortcut.layer == UiShortcuts::Layer.ApplicationCommand
        and doctor_shortcut.command == ShellCommand.ToolchainDoctor.u32(), 461)
    dispatch_toolchain_doctor_shortcut()
    if not toolchain_doctor_active and not BuildJob::is_running(&toolchain_doctor_job):
        integration_report_text("doctor command returned without starting a task")
        integration_report_i64("doctor_job_state=", toolchain_doctor_job.state.i32().i64())
        integration_report_i64("build_job_state=", build_job.state.i32().i64())
        integration_report_i64("run_active=", 1 if run_active else 0)
        integration_report_i64("debug_active=", 1 if shell.debug_session_active else 0)
        report_sview(status_view(shell))
    doctor_wait: mutable i64 = 0
    while BuildJob::is_running(&toolchain_doctor_job) and doctor_wait < 30000:
        app_frame()
        doctor_wait <- doctor_wait + 1
    doctor_output: darray[u8] = geometry_bytes(BuildJob::output_view(&toolchain_doctor_job))
    doctor_ok: bool = (doctor_wait < 30000
        and not toolchain_doctor_active
        and toolchain_doctor_job.state == BuildJob::State.Succeeded
        and bytes_contain(doctor_output, "stage1_product_freshness=pass")
        and bytes_contain(doctor_output, "all required dependencies resolved")
        and bytes_contain(geometry_bytes(status_view(shell)), "Toolchain doctor passed"))
    if not doctor_ok:
        integration_report_i64("doctor_wait=", doctor_wait)
        integration_report_i64("doctor_active=", 1 if toolchain_doctor_active else 0)
        report_sview(BuildJob::output_view(&toolchain_doctor_job))
        report_sview(status_view(shell))
    expect_integration(doctor_ok, 460)

    previous_stage1: cstr? = getenv("ELISA_UI_STAGE1")
    expect_integration(integration_setenv("ELISA_UI_STAGE1", "build/missing-stage1-for-doctor-test") == 0, 463)
    dispatch_toolchain_doctor_shortcut()
    doctor_failure_wait: mutable i64 = 0
    while BuildJob::is_running(&toolchain_doctor_job) and doctor_failure_wait < 30000:
        app_frame()
        doctor_failure_wait <- doctor_failure_wait + 1
    doctor_failure_output: darray[u8] = geometry_bytes(BuildJob::output_view(&toolchain_doctor_job))
    doctor_failure_ok: bool = (doctor_failure_wait < 30000
        and not toolchain_doctor_active
        and toolchain_doctor_job.state == BuildJob::State.Failed
        and bytes_contain(doctor_failure_output, "missing directory build/missing-stage1-for-doctor-test")
        and bytes_contain(geometry_bytes(status_view(shell)), "Toolchain doctor found a missing or stale dependency"))
    if not doctor_failure_ok:
        integration_report_i64("doctor_failure_wait=", doctor_failure_wait)
        integration_report_i64("doctor_failure_state=", toolchain_doctor_job.state.i32().i64())
        report_sview(BuildJob::output_view(&toolchain_doctor_job))
        report_sview(status_view(shell))
    expect_integration(doctor_failure_ok, 464)
    if previous_stage1 is value:
        _ = integration_setenv("ELISA_UI_STAGE1", value)
    else:
        _ = integration_setenv("ELISA_UI_STAGE1", "")

def test_debug_restart_shortcut() -> void:
    restart: UiShortcuts::Decision = UiShortcuts::resolve(
        UiCore::Key.F5.i32(),
        UiShortcuts::MOD_SUPER | UiShortcuts::MOD_SHIFT,
        false,
        false,
    )
    expect_integration(restart.layer == UiShortcuts::Layer.ApplicationCommand
        and restart.command == ShellCommand.RestartDebug.u32(), 465)

def test_package_task_workflow() -> void:
    _ = PosixFile::remove("build/fake-elisapkg-task.log")
    expect_integration(integration_setenv("ELISA_IDE_ELISAPKG", "test/fixtures/fake_elisapkg.py") == 0, 420)
    expect_integration(integration_setenv("FAKE_ELISAPKG_LOG", "../../../build/fake-elisapkg-task.log") == 0, 421)
    package_source_path: sview = "test/fixtures/package_task/src/main.elisa"
    if shell.compact_mode:
        UiHandles::replace_text(shell.compact_open_path_field, package_source_path)
    else:
        UiHandles::replace_text(shell.open_path_field, package_source_path)
    open_document(shell)
    app_frame()
    app_frame()
    expect_integration(shell.standalone_source and shell.source_mode, 422)
    dispatch_package_test_shortcut()
    app_frame()
    package_preview: darray[u8] = geometry_bytes(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    package_log: mutable darray[u8] = []
    package_log_size: mutable usize = PosixFile::read_bytes(&package_log, "build/fake-elisapkg-task.log", 4096)
    expect_integration(not BuildJob::is_running(&build_job) and not package_task_active, 423)
    expect_integration(bytes_contain(package_preview, "Discovered test targets (2): unit-tests, integration-tests"), 426)
    expect_integration(bytes_contain(package_preview, "No project code has run"), 427)
    expect_integration(bytes_contain(package_preview, "press Ctrl/Cmd+Shift+T again"), 428)
    expect_integration(package_log_size == 0, 429)
    app_frame()
    dispatch_package_test_shortcut()
    if not BuildJob::is_running(&build_job):
        report_sview(status_view(shell))
        report_sview(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    package_task_wait: mutable i64 = 0
    while BuildJob::is_running(&build_job) and package_task_wait < 30000:
        app_frame()
        package_task_wait <- package_task_wait + 1
    package_task_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
    package_log <- []
    package_log_size <- PosixFile::read_bytes(&package_log, "build/fake-elisapkg-task.log", 4096)
    if build_job.state != BuildJob::State.Succeeded:
        report_sview(BuildJob::output_view(&build_job))
        integration_report_i64("package_task_wait=", package_task_wait)
        integration_report_i64("package_task_active=", 1 if package_task_active else 0)
    expect_integration(package_task_wait < 30000 and not package_task_active, 424)
    expect_integration(build_job.state == BuildJob::State.Succeeded, 430)
    expect_integration(bytes_contain(package_task_output, "fake elisapkg test succeeded"), 431)
    expect_integration(package_log_size > 0, 432)
    expect_integration(bytes_contain(package_log, "argv=test --offline --test unit-tests"), 433)
    _ = PosixFile::remove("build/fake-elisapkg-task.log")
    dispatch_package_history_shortcut()
    package_history_preview: darray[u8] = geometry_bytes(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    expect_integration(not BuildJob::is_running(&build_job)
        and bytes_contain(package_history_preview, "Recent package test runs")
        and bytes_contain(package_history_preview, "succeeded | unit-tests | exit 0"), 457)
    dispatch_package_history_older_shortcut()
    package_history_detail: darray[u8] = geometry_bytes(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    expect_integration(bytes_contain(package_history_detail, "Package test run 1 of")
        and bytes_contain(package_history_detail, "fake elisapkg test succeeded")
        and bytes_contain(package_history_detail, "State: succeeded | target: unit-tests"), 458)
    dispatch_package_history_newer_shortcut()
    package_history_return: darray[u8] = geometry_bytes(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    expect_integration(bytes_contain(package_history_return, "Recent package test runs"), 459)
    dispatch_package_target_cycle_shortcut()
    selected_target_preview: darray[u8] = geometry_bytes(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    package_log <- []
    package_log_size <- PosixFile::read_bytes(&package_log, "build/fake-elisapkg-task.log", 4096)
    selection_preview_ok: bool = not BuildJob::is_running(&build_job) and not package_task_active and bytes_contain(selected_target_preview, "Selected test target: integration-tests") and bytes_contain(selected_target_preview, "Press Ctrl/Cmd+Option+Shift+T to cycle targets") and package_log_size == 0
    if not selection_preview_ok:
        report_sview(status_view(shell))
        report_sview(UiFlat::widget(shell.build_output.widget_id.usize()).text)
        integration_report_i64("package_test_target_count=", package_test_target_count)
        integration_report_i64("package_selected_target_index=", package_selected_target_index)
        integration_report_i64("package_log_size=", package_log_size.i64())
    expect_integration(selection_preview_ok, 455)
    run_shell_command(shell, ShellCommand.RunPackageTests.u32())
    selected_target_wait: mutable i64 = 0
    while BuildJob::is_running(&build_job) and selected_target_wait < 30000:
        app_frame()
        selected_target_wait <- selected_target_wait + 1
    selected_target_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
    package_log <- []
    package_log_size <- PosixFile::read_bytes(&package_log, "build/fake-elisapkg-task.log", 4096)
    expect_integration(selected_target_wait < 30000 and build_job.state == BuildJob::State.Succeeded
        and not package_task_active and bytes_contain(selected_target_output, "fake elisapkg test succeeded")
        and package_log_size > 0 and bytes_contain(package_log, "argv=test --offline --test integration-tests"), 456)
    _ = PosixFile::remove("build/fake-elisapkg-task.log")
    expect_integration(integration_setenv("FAKE_ELISAPKG_EXIT", "7") == 0, 434)
    run_shell_command(shell, ShellCommand.RunPackageTests.u32())
    package_failure_wait: mutable i64 = 0
    while BuildJob::is_running(&build_job) and package_failure_wait < 30000:
        app_frame()
        package_failure_wait <- package_failure_wait + 1
    package_failure_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
    test_runner_problem: ToolProblem& = &shell.tool_problems[PROBLEM_TOOL_TEST_RUNNER.usize()]
    expect_integration(package_failure_wait < 30000 and build_job.state == BuildJob::State.Failed
        and not package_task_active and test_runner_problem.active
        and test_runner_problem.severity == 1
        and test_runner_problem.task_id == build_revision.i64()
        and test_runner_problem.source_revision == package_task_source_fingerprint
        and test_runner_problem.source_path_length > 0
        and bytes_contain(package_failure_output, "fake elisapkg test failed"), 435)
    dispatch_package_test_explorer_shortcut()
    package_case_failure: darray[u8] = geometry_bytes(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    expect_integration(package_test_explorer_open
        and bytes_contain(package_case_failure, "FAILED fixture_assertion")
        and bytes_contain(package_case_failure, "fixture assertion output for the test explorer"), 467)
    dispatch_package_history_older_shortcut()
    package_case_next: darray[u8] = geometry_bytes(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    expect_integration(package_test_case_selection == 1
        and bytes_contain(package_case_next, "PASSED fixture_cleanup")
        and bytes_contain(package_case_next, "Selected case 2 of 2"), 468)
    dispatch_package_history_newer_shortcut()
    package_case_previous: darray[u8] = geometry_bytes(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    expect_integration(package_test_case_selection == 0
        and bytes_contain(package_case_previous, "FAILED fixture_assertion")
        and bytes_contain(package_case_previous, "fixture assertion output for the test explorer"), 469)
    dispatch_package_test_explorer_shortcut()
    package_case_return: darray[u8] = geometry_bytes(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    expect_integration(not package_test_explorer_open
        and bytes_contain(package_case_return, "Package test run 1 of"), 470)
    expect_integration(integration_setenv("FAKE_ELISAPKG_EXIT", "") == 0, 436)
    expect_integration(integration_setenv("FAKE_ELISAPKG_SLEEP", "30") == 0, 437)
    expect_integration(integration_setenv("FAKE_ELISAPKG_STARTED_FILE", "../../../build/fake-elisapkg-started") == 0, 438)
    _ = PosixFile::remove("build/fake-elisapkg-started")
    run_shell_command(shell, ShellCommand.RunPackageTests.u32())
    package_started_wait: mutable i64 = 0
    package_started: mutable darray[u8] = []
    while (package_started.count == 0 or not BuildJob::is_running(&build_job)) and package_started_wait < 30000:
        app_frame()
        package_started <- []
        _ = PosixFile::read_bytes(&package_started, "build/fake-elisapkg-started", 128)
        package_started_wait <- package_started_wait + 1
    expect_integration(package_started_wait < 30000 and package_started.count > 0
        and BuildJob::is_running(&build_job) and package_task_active, 439)
    click(shell.stop_button)
    expect_integration(not package_task_active and not BuildJob::is_running(&build_job)
        and build_job.state == BuildJob::State.Cancelled
        and not shell.tool_problems[PROBLEM_TOOL_TEST_RUNNER.usize()].active, 440)
    expect_integration(integration_setenv("FAKE_ELISAPKG_SLEEP", "") == 0, 441)
    expect_integration(integration_setenv("FAKE_ELISAPKG_STARTED_FILE", "") == 0, 442)
    _ = PosixFile::remove("build/fake-elisapkg-started")
    expect_integration(integration_setenv("FAKE_ELISAPKG_SLEEP", "2") == 0, 443)
    expect_integration(integration_setenv("FAKE_ELISAPKG_STARTED_FILE", "../../../build/fake-elisapkg-started") == 0, 444)
    run_shell_command(shell, ShellCommand.RunPackageTests.u32())
    stale_started_wait: mutable i64 = 0
    stale_started: mutable darray[u8] = []
    while (stale_started.count == 0 or not BuildJob::is_running(&build_job)) and stale_started_wait < 30000:
        app_frame()
        stale_started <- []
        _ = PosixFile::read_bytes(&stale_started, "build/fake-elisapkg-started", 128)
        stale_started_wait <- stale_started_wait + 1
    source_bytes_before_edit: i64 = HostClient::request(host_process, 148, 0, 0).result
    source_edit: sview = "\n# source changed while the package test was running\n"
    stale_edit_result: HostClient::HostReply = HostClient::request_text(host_process, 133,
        source_bytes_before_edit, source_bytes_before_edit, source_edit)
    expect_integration(stale_started_wait < 30000 and stale_started.count > 0
        and BuildJob::is_running(&build_job) and package_task_active
        and stale_edit_result.result == 1, 445)
    stale_package_wait: mutable i64 = 0
    while BuildJob::is_running(&build_job) and stale_package_wait < 30000:
        app_frame()
        stale_package_wait <- stale_package_wait + 1
    stale_package_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
    stale_test_runner_problem: ToolProblem& = &shell.tool_problems[PROBLEM_TOOL_TEST_RUNNER.usize()]
    expect_integration(stale_package_wait < 30000 and build_job.state == BuildJob::State.Succeeded
        and not package_task_active and stale_test_runner_problem.active and stale_test_runner_problem.severity == 2
        and stale_test_runner_problem.source_revision == package_task_source_fingerprint
        and bytes_contain(stale_package_output, "fake elisapkg test succeeded"), 446)
    source_bytes_after_edit: i64 = HostClient::request(host_process, 148, 0, 0).result
    reverted_source: HostClient::HostReply = HostClient::request_text(host_process, 133,
        source_bytes_before_edit, source_bytes_after_edit, "")
    expect_integration(reverted_source.result == 1 and HostClient::request(host_process, 130, 0, 0).result == 0, 447)
    expect_integration(integration_setenv("FAKE_ELISAPKG_SLEEP", "2") == 0, 450)
    expect_integration(integration_setenv("FAKE_ELISAPKG_STARTED_FILE", "../../../build/fake-elisapkg-tree-started") == 0, 451)
    _ = PosixFile::remove("build/fake-elisapkg-tree-started")
    package_tree_file: cstr = "test/fixtures/package_task/test/integration_tests.elisa"
    original_package_tree_file: mutable darray[u8] = []
    original_package_tree_size: usize = PosixFile::read_bytes(&original_package_tree_file, package_tree_file, 4096)
    changed_package_tree_file: darray[u8] = geometry_bytes("def main() -> i64:\n    return 1\n")
    run_shell_command(shell, ShellCommand.RunPackageTests.u32())
    tree_started_wait: mutable i64 = 0
    tree_started: mutable darray[u8] = []
    while (tree_started.count == 0 or not BuildJob::is_running(&build_job)) and tree_started_wait < 30000:
        app_frame()
        tree_started <- []
        _ = PosixFile::read_bytes(&tree_started, "build/fake-elisapkg-tree-started", 128)
        tree_started_wait <- tree_started_wait + 1
    _ = PosixFile::remove(package_tree_file)
    changed_tree_write: i64 = PosixFile::write_bytes_plain(package_tree_file, changed_package_tree_file)
    expect_integration(original_package_tree_size > 0 and tree_started_wait < 30000
        and tree_started.count > 0 and BuildJob::is_running(&build_job)
        and changed_tree_write == changed_package_tree_file.count.i64(), 452)
    stale_tree_wait: mutable i64 = 0
    while BuildJob::is_running(&build_job) and stale_tree_wait < 30000:
        app_frame()
        stale_tree_wait <- stale_tree_wait + 1
    stale_tree_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
    stale_tree_problem: ToolProblem& = &shell.tool_problems[PROBLEM_TOOL_TEST_RUNNER.usize()]
    expect_integration(stale_tree_wait < 30000 and build_job.state == BuildJob::State.Succeeded
        and not package_task_active and stale_tree_problem.active and stale_tree_problem.severity == 2
        and stale_tree_problem.source_revision == package_task_source_fingerprint
        and bytes_contain(stale_tree_output, "Package test result is stale"), 453)
    _ = PosixFile::remove(package_tree_file)
    restored_tree_write: i64 = PosixFile::write_bytes_plain(package_tree_file, original_package_tree_file)
    expect_integration(restored_tree_write == original_package_tree_size.i64(), 454)
    clear_tool_problem(shell, PROBLEM_TOOL_TEST_RUNNER)
    expect_integration(integration_setenv("FAKE_ELISAPKG_SLEEP", "") == 0, 448)
    expect_integration(integration_setenv("FAKE_ELISAPKG_STARTED_FILE", "") == 0, 449)
    _ = PosixFile::remove("build/fake-elisapkg-started")
    _ = PosixFile::remove("build/fake-elisapkg-tree-started")
    _ = PosixFile::remove("build/fake-elisapkg-task.log")
    restored_source_path: sview = "test/fixtures/source_task_fixture.elisa"
    if shell.compact_mode:
        UiHandles::replace_text(shell.compact_open_path_field, restored_source_path)
    else:
        UiHandles::replace_text(shell.open_path_field, restored_source_path)
    open_document(shell)
    expect_integration(shell.standalone_source and shell.source_mode
        and HostClient::request(host_process, 113, 0, 0).result == 1, 425)

def main() -> i64:
    UiHarness::start(1180.0, 760.0)
    UiHarness::focus_gained()
    profile_only: cstr? = getenv("ELISA_IDE_PROFILE_ONLY")
    if profile_only is value:
        profile_path: sview = "test/fixtures/source_task_fixture.elisa"
        UiHandles::replace_text(shell.open_path_field, profile_path)
        open_document(shell)
        expect_integration(shell.standalone_source and shell.source_mode
            and UiHandles::is_visible(shell.profile_button)
            and UiHandles::is_enabled(shell.profile_button), 330)
        expect_integration(integration_setenv("ELISA_PROFILER", "test/fixtures/fake_elisa_profiler.py") == 0, 331)
        expect_integration(integration_setenv("ELISA_IDE_PROFILE_ROOT", "build/profile-test-results") == 0, 332)
        click(shell.profile_button)
        profile_wait: mutable i64 = 0
        while BuildJob::is_running(&build_job) and profile_wait < 30000:
            app_frame()
            profile_wait <- profile_wait + 1
        profile_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
        expect_integration(profile_wait < 30000 and not profile_active
            and build_job.state == BuildJob::State.Succeeded
            and bytes_contain(profile_output, "Profile capture accepted")
            and bytes_contain(profile_output, "main: 1000 ns inclusive")
            and bytes_contain(profile_output, "Profile progress: capture complete")
            and bytes_contain(profile_output, "Allocation lifecycle: disabled")
            and bytes_contain(profile_output, "Native/foreign frame unwind: not collected")
            and bytes_contain(profile_output, "Artifact SHA-256:"), 333)
        expect_integration(bytes_contain(geometry_bytes(status_view(shell)), "validated report is in Build Output"), 334)
        expect_integration(bytes_contain(profile_output, "Profile report available"), 342)
        expect_integration(shell.profile_report_ready, 335)
        expect_integration(same_text(UiFlat::widget(shell.profile_button.widget_id.usize()).text, "Open Report"), 341)
        expect_integration(integration_setenv("ELISA_IDE_VIEWER", "test/fixtures/fake_profile_viewer.py") == 0, 336)
        click(shell.profile_button)
        report_open_wait: mutable i64 = 0
        while BuildJob::is_running(&build_job) and report_open_wait < 30000:
            app_frame()
            report_open_wait <- report_open_wait + 1
        report_open_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
        expect_integration(report_open_wait < 30000 and not profile_active
            and build_job.state == BuildJob::State.Succeeded
            and bytes_contain(report_open_output, "Opened html profile report"), 337)
        shell.profile_report_ready <- false
        expect_integration(integration_setenv("ELISA_PROFILER", "build/missing-profile-tool") == 0, 359)
        click(shell.profile_button)
        profile_failure_wait: mutable i64 = 0
        while BuildJob::is_running(&build_job) and profile_failure_wait < 30000:
            app_frame()
            profile_failure_wait <- profile_failure_wait + 1
        profiler_problem: ToolProblem& = &shell.tool_problems[PROBLEM_TOOL_PROFILER.usize()]
        expect_integration(profile_failure_wait < 30000 and not profile_active
            and build_job.state == BuildJob::State.Failed
            and profiler_problem.active and profiler_problem.severity == 1
            and profiler_problem.task_id == build_revision.i64()
            and profiler_problem.source_revision == shell.building_source_fingerprint
            and profiler_problem.source_path_length > 0
            and bytes_contain(geometry_bytes(UiText::fixed_bytes_view_range[512](profiler_problem.message_storage, 0, profiler_problem.message_length.usize())), "Profile failed"), 360)
        expect_integration(integration_setenv("ELISA_PROFILER", "test/fixtures/fake_elisa_profiler.py") == 0, 361)
        expect_integration(integration_setenv("FAKE_PROFILE_SLEEP", "1") == 0, 343)
        _ = PosixFile::remove("build/profile-shell-started")
        expect_integration(integration_setenv("FAKE_PROFILE_STARTED_FILE", "../../build/profile-shell-started") == 0, 354)
        click(shell.profile_button)
        profile_cancel_wait: mutable i64 = 0
        while not profile_active and profile_cancel_wait < 1000:
            app_frame()
            profile_cancel_wait <- profile_cancel_wait + 1
        expect_integration(profile_active and BuildJob::is_running(&build_job), 344)
        profile_started_wait: mutable i64 = 0
        profile_started: mutable darray[u8] = []
        while profile_started.count == 0 and profile_started_wait < 30000:
            app_frame()
            profile_started <- []
            _ = PosixFile::read_bytes(&profile_started, "build/profile-shell-started", 64)
            profile_started_wait <- profile_started_wait + 1
        expect_integration(profile_started_wait < 30000 and profile_started.count > 0, 355)
        click(shell.stop_button)
        expect_integration(not profile_active and build_job.state == BuildJob::State.Cancelled
            and not shell.tool_problems[PROBLEM_TOOL_PROFILER.usize()].active, 345)
        expect_integration(integration_setenv("FAKE_PROFILE_SLEEP", "") == 0, 346)
        app_frame()
        expect_integration(shell.profile_recovery_ready
            and same_text(UiFlat::widget(shell.profile_button.widget_id.usize()).text, "Recover"), 356)
        click(shell.profile_button)
        profile_recovery_wait: mutable i64 = 0
        while BuildJob::is_running(&build_job) and profile_recovery_wait < 30000:
            app_frame()
            profile_recovery_wait <- profile_recovery_wait + 1
        profile_recovery_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
        expect_integration(profile_recovery_wait < 30000 and not profile_active
            and build_job.state == BuildJob::State.Succeeded
            and bytes_contain(profile_recovery_output, "Profile recovery accepted")
            and bytes_contain(profile_recovery_output, "Compiler revision: not recorded")
            and shell.profile_report_ready and not shell.profile_recovery_ready
            and same_text(UiFlat::widget(shell.profile_button.widget_id.usize()).text, "Open Report"), 357)
        click(shell.profile_button)
        recovered_report_wait: mutable i64 = 0
        while BuildJob::is_running(&build_job) and recovered_report_wait < 30000:
            app_frame()
            recovered_report_wait <- recovered_report_wait + 1
        recovered_report_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
        expect_integration(recovered_report_wait < 30000 and not profile_active
            and build_job.state == BuildJob::State.Succeeded
            and bytes_contain(recovered_report_output, "Opened html profile report"), 358)
        shell.profile_report_ready <- false
        click(shell.build_button)
        source_build_wait: mutable i64 = 0
        while BuildJob::is_running(&build_job) and source_build_wait < 120000:
            app_frame()
            source_build_wait <- source_build_wait + 1
        expect_integration(source_build_wait < 120000 and build_job.state == BuildJob::State.Succeeded, 347)
        run_project(shell)
        source_run_wait: mutable i64 = 0
        while run_active and source_run_wait < 30000:
            app_frame()
            source_run_wait <- source_run_wait + 1
        expect_integration(not run_active, 348)
        expect_integration(bytes_contain(geometry_bytes(BuildJob::output_view(&build_job)), "source-task-ran"), 349)
        expect_integration(same_text(status_view(shell), "Application finished"), 350)
        return finish()
    test_geometry_acceptance()
    test_debuggee_terminal_state()
    test_preview_path_isolation()
    test_frame_identity_acceptance()
    test_build_diagnostic_projection()
    test_lsp_coordinate_conversion()
    test_debug_restart_shortcut()
    package_only: cstr? = getenv("ELISA_IDE_PACKAGE_ONLY")
    if package_only is value:
        test_toolchain_doctor()
        test_package_task_workflow()
        return finish()

    # Cold launch owns a clean untitled form: New/Open remain usable and Save
    # is disabled until this document has a destination.
    expect_integration(shell.host_running, 1)
    expect_integration(shell.projection.hierarchy_count == 1, 2)
    expect_integration(not shell.projection.dirty, 3)
    expect_integration(UiHandles::is_enabled(shell.new_button), 4)
    expect_integration(UiHandles::is_enabled(shell.open_button), 5)
    expect_integration(not UiHandles::is_enabled(shell.save_button), 6)

    # Use the actual retained callbacks for New, palette insertion, and
    # hierarchy selection. The button is palette row 4 in the built-in set.
    click(shell.new_button)
    expect_integration(not shell.projection.dirty, 10)
    click(shell.palette_rows[4.usize()])
    expect_integration(shell.projection.node_count == 2 and shell.projection.dirty, 11)
    expect_integration(not UiHandles::is_enabled(shell.new_button) and not UiHandles::is_enabled(shell.open_button), 12)
    expect_integration(not UiHandles::is_enabled(shell.save_button), 13)
    click(shell.hierarchy_rows[1.usize()])
    expect_integration(shell.projection.selection_count == 1 and shell.projection.inspector_count > 0, 14)

    # Node display names and generated symbols are editable as distinct
    # inspector rows, after the component's registered properties.
    expect_integration(shell.projection.inspector_count == 14
        and shell.inspector_tags[12.usize()] == 7
        and shell.inspector_tags[13.usize()] == 7, 188)
    display_name_label: HostClient::HostReply = HostClient::request(&host_process, 52, 12, 0)
    generated_symbol_label: HostClient::HostReply = HostClient::request(&host_process, 52, 13, 0)
    expect_integration(same_text(ShellBytes::view_of(&display_name_label.text), "Display name")
        and same_text(ShellBytes::view_of(&generated_symbol_label.text), "Generated symbol")
        and same_text(UiHandles::text_value(shell.inspector_editors[12.usize()]), "Button"), 189)
    type_editor_value(shell.inspector_editors[12.usize()], "Save action")
    expect_integration(same_text(UiHandles::text_value(shell.inspector_editors[12.usize()]), "Save action"), 190)
    type_editor_value(shell.inspector_editors[13.usize()], "save_action")
    renamed_source: HostClient::HostReply = HostClient::request(&host_process, 106, 0, 0)
    expect_integration(same_text(UiHandles::text_value(shell.inspector_editors[12.usize()]), "Save action")
        and same_text(UiHandles::text_value(shell.inspector_editors[13.usize()]), "save_action")
        and bytes_contain(renamed_source.text, "def widget_save_action()"), 191)

    # Commit a caption through the same inspector submit callback as Enter.
    type_editor_value(shell.inspector_editors[0.usize()], "Hello from the shell")
    expect_integration(same_text(UiHandles::text_value(shell.inspector_editors[0.usize()]), "Hello from the shell"), 20)
    expect_integration(shell.projection.dirty, 21)
    commit_before_undo: bool = commit_pending_inspector_edits(shell, host_process)
    expect_integration(commit_before_undo, 27)
    committed_caption: HostClient::HostReply = HostClient::request(&host_process, 53, 0, 0)
    expect_integration(same_text(ShellBytes::view_of(&committed_caption.text), "Hello from the shell"), 28)
    preview_snapshot_before: HostClient::HostReply = HostClient::request(&host_process, 80, 0, 0)
    expect_integration(bytes_contain(preview_snapshot_before.text, "Hello from the shell"), 29)
    preview_frame_before: i64 = run_preview(preview_snapshot_before)
    expect_integration(preview_frame_before > 0, 35)
    refresh_all(shell, host_process)
    shell_preview_ready_for_test: bool = wait_for_shell_preview(60000)
    expect_integration(shell_preview_ready_for_test, 38)
    expect_integration(shell.preview_region_count == 2, 39)
    click(shell.hierarchy_rows[0.usize()])
    expect_integration(shell.projection.selection_count == 1, 51)
    click_result: bool = click_last_preview_region_from_canvas()
    expect_integration(click_result, 52)
    selected_row: HostClient::HostReply = HostClient::request(&host_process, 43, 1, 0)
    expect_integration(shell.projection.selection_count == 1 and selected_row.result == 1, 53)
    expect_integration(same_text(UiHandles::text_value(shell.inspector_editors[0.usize()]), "Hello from the shell"), 54)
    click(shell.preview_retry_button)
    expect_integration(shell.preview_pending and shell.preview_ready and shell.preview_region_count == 0, 66)
    preview_retry_completed: bool = wait_for_shell_preview(60000)
    preview_retry_ok: bool = preview_retry_completed and shell.preview_region_count == 2
    expect_integration(preview_retry_ok, 2067)
    if not preview_retry_ok:
        integration_report_i64("preview_retry_pending=", 1 if shell.preview_pending else 0)
        integration_report_i64("preview_retry_ready=", 1 if shell.preview_ready else 0)
        integration_report_i64("preview_retry_regions=", shell.preview_region_count.i64())
        integration_report_i64("preview_retry_revision=", shell.preview_revision.i64())
        integration_report_i64("preview_retry_geometry_revision=", shell.preview_geometry_revision.i64())
        integration_report_i64("preview_retry_signature=", shell.preview_signature)
        integration_report_i64("preview_retry_geometry_signature=", shell.preview_geometry_signature)
        report_sview(UiHandles::text_value(shell.preview_status))
        report_sview(UiFlat::widget(shell.preview_status.widget_id.usize()).help)
    preview_retry_only: cstr? = getenv("ELISA_IDE_PREVIEW_RETRY_ONLY")
    if preview_retry_only is value:
        return finish()
    expect_integration(UiHandles::activate(shell.undo_button), 22)
    undo_caption: HostClient::HostReply = HostClient::request(&host_process, 53, 0, 0)
    expect_integration(same_text(ShellBytes::view_of(&undo_caption.text), "Button"), 26)
    expect_integration(same_text(UiHandles::text_value(shell.inspector_editors[0.usize()]), "Button"), 23)
    preview_snapshot_after: HostClient::HostReply = HostClient::request(&host_process, 80, 0, 0)
    expect_integration(bytes_contain(preview_snapshot_after.text, "Button")
        and not bytes_contain(preview_snapshot_after.text, "Hello from the shell"), 36)
    preview_frame_after: i64 = run_preview(preview_snapshot_after)
    expect_integration(preview_frame_after > 0 and preview_frame_before != preview_frame_after, 37)

    # Save As is available for the untitled document. Reopen it through the
    # visible shell controls after the successful commit.
    UiHandles::replace_text(shell.open_path_field, sview(SAVE_PATH, 0, -1))
    click(shell.save_as_button)
    expect_integration(not shell.projection.dirty and not UiHandles::is_enabled(shell.save_button), 30)
    saved: mutable darray[u8] = []
    saved_length: usize = PosixFile::read_bytes(&saved, SAVE_PATH, 1048576)
    expect_integration(saved_length > 0 and bytes_contain(saved, "Button") and not bytes_contain(saved, "Hello from the shell"), 31)
    expect_integration(UiHandles::is_enabled(shell.new_button) and UiHandles::is_enabled(shell.open_button), 32)

    UiHandles::replace_text(shell.open_path_field, sview(SAVE_PATH, 0, -1))
    click(shell.open_button)
    expect_integration(not shell.projection.dirty and shell.projection.node_count == 2, 33)
    click(shell.hierarchy_rows[1.usize()])
    expect_integration(same_text(UiHandles::text_value(shell.inspector_editors[0.usize()]), "Button"), 34)

    # The generated source projection is available beside the RAD canvas and
    # remains read-only; toggling the same command returns to the canvas.
    expect_integration(UiHandles::activate(shell.source_button), 127)
    source_view: sview = UiFlat::widget(shell.source_text.widget_id.usize()).text
    source_bytes: mutable darray[u8] = geometry_bytes(source_view)
    expect_integration(shell.source_mode, 131)
    expect_integration(UiHandles::is_visible(shell.source_pane), 132)
    expect_integration(not UiHandles::is_visible(shell.source_open_editor_button), 142)
    expect_integration(not UiHandles::is_visible(shell.source_reveal_button), 163)
    source_ownership_text: sview = UiFlat::widget(shell.source_ownership.widget_id.usize()).text
    expect_integration(UiHandles::is_visible(shell.source_ownership)
        and bytes_contain(geometry_bytes(source_ownership_text), "Form:")
        and bytes_contain(geometry_bytes(source_ownership_text), "generated view is read-only"), 137)
    expect_integration(shell.source_line_count > 0
        and UiHandles::is_visible(shell.source_line_rows[0.usize()]), 136)
    expect_integration(bytes_contain(source_bytes, "module main_view:"), 133)
    expect_integration(bytes_contain(source_bytes, "def build() -> bool"), 134)
    expect_integration(HostClient::request(host_process, 113, 0, 0).result != 1, 192)
    source_owner_line: mutable i32 = -1
    button_byte_offset: i64 = byte_index_of(source_bytes, "UiHandles::button")
    source_scan: mutable i32 = 0
    while source_scan < shell.source_line_count:
        next_offset: mutable i64 = source_bytes.count.i64()
        if source_scan + 1 < shell.source_line_count:
            next_offset <- shell.source_line_offsets[(source_scan + 1).usize()]
        if button_byte_offset >= shell.source_line_offsets[source_scan.usize()] and button_byte_offset < next_offset:
            source_owner_line <- source_scan
            break
        source_scan <- source_scan + 1
    source_owner_activation: mutable bool = false
    source_owner_result: mutable bool = false
    source_owner_name: mutable bool = false
    if source_owner_line >= 0:
        if UiHandles::widget(shell.source_line_rows[source_owner_line.usize()]) is source_widget:
            center_x: f32 = source_widget.x + source_widget.width * 0.5
            center_y: f32 = source_widget.y + source_widget.height * 0.5
            source_click_row: i32 = source_row_at(shell, UiCore::Vec2(center_x, center_y))
            expect_integration(source_click_row == source_owner_line, 190)
            source_owner_activation <- true
            UiHarness::dispatch(UiCore::PointerEvent.Down(at: UiCore::Vec2(center_x, center_y), button: UiCore::PointerButton.Primary.i32()))
            UiHarness::dispatch(UiCore::PointerEvent.Up(at: UiCore::Vec2(center_x, center_y), button: UiCore::PointerButton.Primary.i32()))
        selected_name: HostClient::HostReply = HostClient::request(host_process, 54, 0, 0)
        source_owner_result <- selected_name.result == 1
        source_owner_name <- same_text(ShellBytes::view_of(&selected_name.text), "Save action")
    expect_integration(source_owner_line >= 0, 138)
    expect_integration(source_owner_activation, 139)
    expect_integration(source_owner_result, 140)
    expect_integration(source_owner_name, 141)
    expect_integration(same_text(status_view(shell), "Selected form owner from generated source"), 193)
    expect_integration(UiHandles::activate(shell.source_button), 130)
    expect_integration(not shell.source_mode and UiHandles::is_visible(shell.surface_pane), 129)

    # A regular Elisa source file opens in the bounded line editor. A copied
    # fixture lets the shell test verify Save without changing tracked input.
    source_fixture: mutable darray[u8] = []
    source_fixture_length: usize = PosixFile::read_bytes(&source_fixture, SOURCE_VIEW_PATH, 1048576)
    _ = PosixFile::remove(SOURCE_EDIT_PATH)
    source_copy_length: i64 = PosixFile::write_plain(SOURCE_EDIT_PATH, ShellBytes::view_of(&source_fixture))
    expect_integration(source_fixture_length > 0 and source_copy_length == source_fixture_length.i64(), 153)
    _ = PosixFile::remove(SOURCE_RELATED_PATH)
    related_fixture_text: sview = "module related_fixture:\n    def related_entry() -> i64:\n        return 7\n"
    related_fixture_length: i64 = PosixFile::write_plain(SOURCE_RELATED_PATH, related_fixture_text)
    expect_integration(related_fixture_length == related_fixture_text.len.i64(), 229)
    expect_integration(integration_setenv("ELISA_LSP", "../test/fixtures/fake_elisa_lsp.py") == 0, 201)
    expect_integration(integration_setenv("ELISA_LSP_RELATED_PATH", SOURCE_RELATED_PATH) == 0, 230)
    expect_integration(integration_setenv("ELISA_LSP_DEFINITION_PATH", SOURCE_RELATED_PATH) == 0, 265)
    expect_integration(integration_setenv("ELISA_LSP_SYMBOL_PATH", SOURCE_RELATED_PATH) == 0, 287)
    decoded_uri_path: darray[u8] = decode_local_file_uri("file:///tmp/Related%20Elisa%20Source.elisa")
    expect_integration(bytes_contain(decoded_uri_path, "Related Elisa Source.elisa")
        and decode_local_file_uri("https://example.invalid/source.elisa").count == 0
        and decode_local_file_uri("file:///tmp/bad%00.elisa").count == 0
        and decode_local_file_uri("file:///tmp/bad%2.elisa").count == 0, 231)
    debug_preferences_path: mutable darray[u8] = []
    append_panel_text(&debug_preferences_path, "build/debug-breakpoint-test-")
    append_nonnegative(&debug_preferences_path, PosixProcess::monotonic_ms())
    append_panel_text(&debug_preferences_path, "/preferences.json")
    debug_preferences_path.push(0)
    debug_preferences_config: mutable cstr = ""
    can Unsafe.PointerCast:
        debug_preferences_config <- (&debug_preferences_path[0]).cast[cstr] can Unsafe.PointerCast
    expect_integration(integration_setenv("ELISA_IDE_CONFIG", debug_preferences_config) == 0, 368)
    UiHandles::replace_text(shell.open_path_field, sview(SOURCE_EDIT_PATH, 0, -1))
    click(shell.open_button)
    source_first_line: sview = UiHandles::text_value(shell.source_line_rows[0.usize()])
    source_title_text: sview = UiFlat::widget(shell.source_title.widget_id.usize()).text
    expect_integration(shell.source_mode and UiHandles::is_visible(shell.source_pane)
        and same_text(source_title_text, "Elisa source"), 154)
    expect_integration(UiHandles::is_visible(shell.source_open_editor_button)
        and UiHandles::is_enabled(shell.source_open_editor_button), 162)
    expect_integration(UiHandles::is_visible(shell.source_reveal_button)
        and UiHandles::is_enabled(shell.source_reveal_button), 164)
    expect_integration(shell.source_line_count == 32
        and bytes_contain(geometry_bytes(source_first_line), "1 | module source_view:"), 155)
    breakpoint_marker_row: UiHandles::Handle = shell.source_line_rows[1.usize()]
    if UiHandles::widget(breakpoint_marker_row) is breakpoint_widget:
        UiHarness::dispatch(UiCore::PointerEvent.Down(at: UiCore::Vec2(breakpoint_widget.x + 2.0, breakpoint_widget.y + breakpoint_widget.height * 0.5), button: UiCore::PointerButton.Primary.i32()))
        guttered_breakpoint_line: sview = UiHandles::text_value(breakpoint_marker_row)
        expect_integration(shell.debug_breakpoint_count == 1
            and ShellDebug::has_breakpoint(shell, 2)
            and bytes_contain(geometry_bytes(guttered_breakpoint_line), "*      2 |"), 294)
        source_identity: HostClient::HostReply = HostClient::request(host_process, 114, 0, 0)
        source_identity_fingerprint: i64 = HostClient::request(host_process, 152, 0, 0).result
        restored_breakpoint_shell: mutable Shell = new_shell()
        ShellDebug::ensure_source(restored_breakpoint_shell,
            ShellBytes::view_of(&source_identity.text), source_identity_fingerprint)
        expect_integration(restored_breakpoint_shell.debug_breakpoint_count == 1
            and ShellDebug::has_breakpoint(restored_breakpoint_shell, 2), 369)
        relocated_breakpoint_shell: mutable Shell = new_shell()
        ShellDebug::ensure_source(relocated_breakpoint_shell, SOURCE_RELATED_PATH,
            source_identity_fingerprint)
        expect_integration(relocated_breakpoint_shell.debug_breakpoint_count == 0, 370)
        stale_breakpoint_shell: mutable Shell = new_shell()
        ShellDebug::ensure_source(stale_breakpoint_shell,
            ShellBytes::view_of(&source_identity.text), source_identity_fingerprint + 1)
        expect_integration(stale_breakpoint_shell.debug_breakpoint_count == 0, 371)
