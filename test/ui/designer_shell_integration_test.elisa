# First M03 editing slice through the real shell widgets and document host.
#
# The headless harness delivers physical pointer events to the retained shell.
# The test creates a form, inserts a button from the palette, edits and undoes
# its caption, saves it, then opens that file through the shell and verifies
# the persisted value in the inspector projection.

include "shell_test_platform.elisa"
include "preview_image_test_adapter.elisa"
include "../../framework/src/test/ui_harness.elisa"
include "../../src/shell/shell_app.elisa"

const SAVE_PATH: cstr = "build/shell-integration-main.elisaform.json"
const SOURCE_VIEW_PATH: cstr = "test/fixtures/source_view.elisa"
const SOURCE_EDIT_PATH: cstr = "build/shell-source-edit.elisa"
const SOURCE_RELATED_PATH: cstr = "build/Related Elisa Source.elisa"
const PROJECT_ROOT_PATH: cstr = "build/New Elisa Project"
const PROJECT_FORM_PATH: cstr = "build/New Elisa Project/forms/main.elisaform.json"
const PROJECT_MANIFEST_PATH: cstr = "build/New Elisa Project/New Elisa Project.elisaproject.json"
const PROJECT_HANDLERS_PATH: cstr = "build/New Elisa Project/src/main_handlers.elisa"
const PROJECT_GENERATED_ROOT_PATH: cstr = "build/New Elisa Project/generated"
const PROJECT_GENERATED_README_PATH: cstr = "build/New Elisa Project/generated/README.md"
const PROJECT_GENERATED_APP_PATH: cstr = "build/New Elisa Project/generated/App_app.elisa"
const PROJECT_GENERATED_HANDLERS_PATH: cstr = "build/New Elisa Project/generated/App_handlers.elisa"
const PROJECT_GENERATED_VIEW_PATH: cstr = "build/New Elisa Project/generated/App_view.elisa"
const PROJECT_GENERATED_MAP_PATH: cstr = "build/New Elisa Project/generated/App_view.elisa.map.json"
const PROJECT_GENERATED_MANIFEST_PATH: cstr = "build/New Elisa Project/generated/.elisa-ide-generation.json"
const COMPACT_PROJECT_ROOT_PATH: cstr = "build/Compact Elisa Project"
const COMPACT_PROJECT_FORM_PATH: cstr = "build/Compact Elisa Project/forms/main.elisaform.json"
const COMPACT_PROJECT_MANIFEST_PATH: cstr = "build/Compact Elisa Project/Compact Elisa Project.elisaproject.json"
const INTEGRATION_PREVIEW_PATH_CAPACITY: usize = 1024

global mutable integration_failure: i64 = 0
global mutable integration_assertion_count: i64 = 0

@link_name("designer_setenv")
extern integration_setenv(name: cstr, value: cstr) -> i64

@link_name("designer_report_i64")
extern integration_report_i64(label: cstr, value: i64) -> void

@link_name("designer_report_text")
extern integration_report_text(text: cstr) -> void

def expect_integration(condition: bool, code: i64) -> void:
    integration_assertion_count <- integration_assertion_count + 1
    if not condition and integration_failure == 0:
        integration_failure <- code

def same_text(left: sview, right: sview) -> bool:
    return false if left.len != right.len
    index: mutable i64 = 0
    while index < left.len:
        return false if left[index] != right[index]
        index <- index + 1
    return true

def status_view(shell: Shell) -> sview:
    return "" if shell.status_length <= 0 or shell.status_length > 256
    can Unsafe.PointerCast:
        return UiText::unsafe_sview_bounded_bytes(&shell.status_storage[0], shell.status_length.usize())

def bytes_contain(bytes: darray[u8]&, needle: sview) -> bool:
    return false if needle.len == 0 or bytes.count.i64() < needle.len
    start: mutable i64 = 0
    while start + needle.len <= bytes.count.i64():
        matched: mutable bool = true
        offset: mutable i64 = 0
        while offset < needle.len:
            if bytes[(start + offset).usize()] != needle[offset]:
                matched <- false
                break
            offset <- offset + 1
        if matched:
            return true
        start <- start + 1
    return false

def byte_index_of(bytes: darray[u8]&, needle: sview) -> i64:
    return -1 if needle.len == 0 or bytes.count.i64() < needle.len
    start: mutable i64 = 0
    while start + needle.len <= bytes.count.i64():
        matched: mutable bool = true
        offset: mutable i64 = 0
        while offset < needle.len:
            if bytes[(start + offset).usize()] != needle[offset]:
                matched <- false
                break
            offset <- offset + 1
        return start if matched
        start <- start + 1
    return -1

def report_frame_manifest(bytes: darray[u8]&) -> void:
    needle: sview = "frame_v1 "
    for start in 0..<bytes.count:
        matched: mutable bool = true
        for offset in 0..<needle.len:
            if start + offset >= bytes.count or bytes[start + offset] != needle[offset]:
                matched <- false
                break
        if matched:
            line: mutable u8[128] = zeroed
            length: mutable usize = 0
            while start + length < bytes.count and bytes[start + length] != 10 and length < 127:
                line[length] <- bytes[start + length]
                length <- length + 1
            text: mutable cstr = ""
            can Unsafe.PointerCast:
                text <- (&line[0]).cast[cstr] can Unsafe.PointerCast
            integration_report_text(text)
            return

def geometry_bytes(text: sview) -> darray[u8]:
    bytes: mutable darray[u8] = []
    for index in 0..<text.len:
        bytes.push(text[index])
    return bytes

def report_sview(text: sview) -> void can[Memory.Allocate, Memory.Release, Unsafe.PointerCast]:
    bytes: mutable darray[u8] = geometry_bytes(text)
    bytes.push(0)
    pointer: mutable cstr = ""
    can Unsafe.PointerCast:
        pointer <- (&bytes[0]).cast[cstr] can Unsafe.PointerCast
    integration_report_text(pointer)

def geometry_was_invalidated(test_shell: Shell) -> bool:
    return test_shell.preview_region_count == 0 and test_shell.preview_geometry_revision == 0 and test_shell.preview_geometry_signature == 0 and test_shell.preview_form_width == 0.0 and test_shell.preview_form_height == 0.0

def test_geometry_acceptance() -> void:
    test_shell: mutable Shell = new_shell()
    complete: mutable darray[u8] = geometry_bytes("preview_revision=7\ngeometry_v1 7 123 node-root 0 0 102400 76800 1 0\ngeometry_v1 7 123 node-button 1024 2048 4096 5120 1 1\n")
    accepted: bool = ShellPreview::accept_geometry_output(test_shell, complete, 7, 123, 100.0, 75.0)
    expect_integration(accepted and test_shell.preview_region_count == 2 and test_shell.preview_geometry_revision == 7 and test_shell.preview_geometry_signature == 123 and test_shell.preview_form_width == 100.0 and test_shell.preview_form_height == 75.0, 60)

    malformed_tail: mutable darray[u8] = geometry_bytes("geometry_v1 7 123 node-root 0 0 102400 76800 1 0\ngeometry_v1 7 123 node-bad 4 nope 10 10 1 1\n")
    malformed_accepted: bool = ShellPreview::accept_geometry_output(test_shell, malformed_tail, 7, 123, 100.0, 75.0)
    expect_integration(not malformed_accepted and geometry_was_invalidated(test_shell), 61)

    mixed_revision: mutable darray[u8] = geometry_bytes("geometry_v1 7 123 node-root 0 0 102400 76800 1 0\ngeometry_v1 8 123 node-button 1024 2048 4096 5120 1 1\n")
    revision_accepted: bool = ShellPreview::accept_geometry_output(test_shell, mixed_revision, 7, 123, 100.0, 75.0)
    expect_integration(not revision_accepted and geometry_was_invalidated(test_shell), 62)

    mixed_signature: mutable darray[u8] = geometry_bytes("geometry_v1 7 123 node-root 0 0 102400 76800 1 0\ngeometry_v1 7 124 node-button 1024 2048 4096 5120 1 1\n")
    signature_accepted: bool = ShellPreview::accept_geometry_output(test_shell, mixed_signature, 7, 123, 100.0, 75.0)
    expect_integration(not signature_accepted and geometry_was_invalidated(test_shell), 63)

    stale: mutable darray[u8] = geometry_bytes("geometry_v1 6 123 node-root 0 0 102400 76800 1 0\n")
    stale_accepted: bool = ShellPreview::accept_geometry_output(test_shell, stale, 7, 123, 100.0, 75.0)
    expect_integration(not stale_accepted and geometry_was_invalidated(test_shell), 64)

    duplicate_id: mutable darray[u8] = geometry_bytes("geometry_v1 7 123 node-root 0 0 102400 76800 1 0\ngeometry_v1 7 123 node-root 1024 2048 4096 5120 1 1\n")
    duplicate_accepted: bool = ShellPreview::accept_geometry_output(test_shell, duplicate_id, 7, 123, 100.0, 75.0)
    expect_integration(not duplicate_accepted and geometry_was_invalidated(test_shell), 65)

    trailing_field: mutable darray[u8] = geometry_bytes("geometry_v1 7 123 node-root 0 0 102400 76800 1 0 unexpected\n")
    trailing_accepted: bool = ShellPreview::accept_geometry_output(test_shell, trailing_field, 7, 123, 100.0, 75.0)
    expect_integration(not trailing_accepted and geometry_was_invalidated(test_shell), 66)

    embedded_marker: mutable darray[u8] = geometry_bytes("worker output geometry_v1 7 123 node-root 0 0 102400 76800 1 0\n")
    embedded_accepted: bool = ShellPreview::accept_geometry_output(test_shell, embedded_marker, 7, 123, 100.0, 75.0)
    expect_integration(not embedded_accepted and geometry_was_invalidated(test_shell), 1067)

def append_preview_capture(target: mutable darray[u8]&, chunk: darray[u8]&, truncated: mutable bool&) -> void:
    index: mutable usize = 0
    while index < chunk.count:
        if target.count < 1048576:
            target.push(chunk[index])
        else:
            truncated <- true
        index <- index + 1

def wait_preview_worker(process: PosixProcess::Process, budget_ms: i64,
                        stdout: mutable darray[u8]&, stderr: mutable darray[u8]&, output_truncated: mutable bool&) -> bool:
    # Keep the small handle by value. A native pointer produced from an Elisa
    # reference-to-reference here does not preserve the original process handle.
    # Drain both pipes during the wait so a worker cannot block while writing
    # geometry or a bounded diagnostic before it exits.
    elapsed: mutable i64 = 0
    while elapsed < budget_ms:
        stdout_chunk: mutable darray[u8] = []
        _ = PosixProcess::read_stdout(&process, &stdout_chunk, 65536)
        append_preview_capture(stdout, stdout_chunk, output_truncated)
        stderr_chunk: mutable darray[u8] = []
        _ = PosixProcess::read_stderr(&process, &stderr_chunk, 65536)
        append_preview_capture(stderr, stderr_chunk, output_truncated)
        if PosixProcess::poll(&process, 20):
            stdout_chunk <- []
            _ = PosixProcess::read_stdout(&process, &stdout_chunk, 65536)
            append_preview_capture(stdout, stdout_chunk, output_truncated)
            stderr_chunk <- []
            _ = PosixProcess::read_stderr(&process, &stderr_chunk, 65536)
            append_preview_capture(stderr, stderr_chunk, output_truncated)
            return true
        elapsed <- elapsed + 20
    return false

def wait_for_shell_preview(budget_ms: i64) -> bool:
    elapsed: mutable i64 = 0
    while elapsed < budget_ms:
        if not shell.preview_pending:
            return shell.preview_ready and shell.preview_region_count > 0 and shell.preview_geometry_revision == shell.preview_revision and shell.preview_geometry_signature == shell.preview_signature
        process: PosixProcess::Process = preview_process
        _ = PosixProcess::poll(&process, 20)
        ShellPreview::poll_and_bind(shell)
        elapsed <- elapsed + 20
    return false

def click_last_preview_region_from_canvas() -> bool:
    return false if shell.preview_form_width <= 0.0 or shell.preview_form_height <= 0.0
    if UiHandles::widget(shell.preview_canvas) is canvas:
        return false if canvas.width <= 0.0 or canvas.height <= 0.0
        scale_x: f32 = canvas.width / shell.preview_form_width
        scale_y: f32 = canvas.height / shell.preview_form_height
        scale: f32 = scale_x if scale_x < scale_y else scale_y
        return false if scale <= 0.0
        return false if shell.preview_region_count == 0
        region: PreviewRegion = shell.preview_regions[shell.preview_region_count - 1]
        return false if not region.visible or not region.selectable
        form_x: f32 = (region.x_q10 + region.width_q10 / 2).f32() / 1024.0
        form_y: f32 = (region.y_q10 + region.height_q10 / 2).f32() / 1024.0
        drawn_width: f32 = shell.preview_form_width * scale
        drawn_height: f32 = shell.preview_form_height * scale
        x: f32 = canvas.x + (canvas.width - drawn_width) * 0.5 + form_x * scale
        y: f32 = canvas.y + (canvas.height - drawn_height) * 0.5 + form_y * scale
        UiHarness::dispatch(UiCore::PointerEvent.Down(at: UiCore::Vec2(x, y), button: UiCore::PointerButton.Primary.i32()))
        UiHarness::dispatch(UiCore::PointerEvent.Up(at: UiCore::Vec2(x, y), button: UiCore::PointerButton.Primary.i32()))
        return true
    return false

def fail_preview(stage: i64) -> i64:
    integration_report_i64("preview_failure_stage=", stage)
    return 0

def preview_paths_differ(left: mutable u8[1024]&, right: mutable u8[1024]&) -> bool:
    for index in 0..<1024:
        return true if left[index] != right[index]
        return false if left[index] == 0
    return false

def preview_snapshot_revision(snapshot: darray[u8]&) -> u64:
    return 0 if snapshot.count < 16
    revision: mutable u64 = 0
    for shift in 0..<8:
        revision <- revision | (snapshot[8 + shift].u64() << (shift * 8))
    return revision

def preview_snapshot_signature(snapshot: mutable darray[u8]&) -> i64:
    return shell_preview_snapshot_signature(&snapshot[0], snapshot.count)

def test_frame_identity_acceptance() -> void:
    valid: mutable darray[u8] = geometry_bytes("worker output\nframe_v1 7 123 4096 1234 5678\n")
    accepted: bool = ShellPreview::accept_frame_identity_output(valid, 7, 123, 4096, 1234, 5678)
    expect_integration(accepted, 74)

    wrong_revision: mutable darray[u8] = geometry_bytes("frame_v1 8 123 4096 1234 5678\n")
    expect_integration(not ShellPreview::accept_frame_identity_output(wrong_revision, 7, 123, 4096, 1234, 5678), 75)

    wrong_digest: mutable darray[u8] = geometry_bytes("frame_v1 7 123 4096 1234 5679\n")
    expect_integration(not ShellPreview::accept_frame_identity_output(wrong_digest, 7, 123, 4096, 1234, 5678), 76)

    duplicate: mutable darray[u8] = geometry_bytes("frame_v1 7 123 4096 1234 5678\nframe_v1 7 123 4096 1234 5678\n")
    expect_integration(not ShellPreview::accept_frame_identity_output(duplicate, 7, 123, 4096, 1234, 5678), 77)

    embedded: mutable darray[u8] = geometry_bytes("worker frame_v1 7 123 4096 1234 5678\n")
    expect_integration(not ShellPreview::accept_frame_identity_output(embedded, 7, 123, 4096, 1234, 5678), 78)

def test_build_diagnostic_projection() -> void:
    bytes: mutable darray[u8] = geometry_bytes("built project application: ok\nforms/main.elisa:4:2: error: bad property\nwarning: local package graph\n")
    text: sview = ShellBytes::view_of(&bytes)
    expect_integration(build_diagnostic_count(text) == 2, 148)
    first: sview = build_diagnostic_at(text, 0)
    second: sview = build_diagnostic_at(text, 1)
    expect_integration(same_text(first, "forms/main.elisa:4:2: error: bad property")
        and same_text(second, "warning: local package graph"), 149)
    expect_integration(build_diagnostic_at(text, 2).len == 0, 150)
    expect_integration(safe_build_source_path("src/main_handlers.elisa")
        and safe_build_source_path("/workspace/project/src/main.elisa")
        and not safe_build_source_path("../outside/main.elisa")
        and not safe_build_source_path("build/project/generated/View.elisa"), 262)

def test_lsp_coordinate_conversion() -> void:
    source: sview = "a😀b"
    expect_integration(ShellLsp::character_to_utf16(source, 8, 5) == 3
        and ShellLsp::character_to_utf16(source, 16, 3) == 3
        and ShellLsp::character_to_utf16(source, 32, 2) == 3, 207)
    expect_integration(ShellLsp::character_to_utf16(source, 16, 2) == 1
        and ShellLsp::character_to_utf16(source, 8, 2) == 1, 208)
    expect_integration(ShellLsp::utf16_to_character(source, 8, 3) == 5
        and ShellLsp::utf16_to_character(source, 16, 3) == 3
        and ShellLsp::utf16_to_character(source, 32, 3) == 2, 263)
    expect_integration(ShellLsp::utf16_to_character(source, 8, 2) == 1
        and ShellLsp::utf16_to_character(source, 16, 2) == 1
        and ShellLsp::utf16_to_character(source, 32, 2) == 1, 264)

def test_preview_path_isolation() -> void:
    first_input: mutable u8[1024] = zeroed
    first_frame: mutable u8[1024] = zeroed
    second_input: mutable u8[1024] = zeroed
    second_frame: mutable u8[1024] = zeroed
    first_created: i64 = shell_preview_paths_create(&first_input[0], INTEGRATION_PREVIEW_PATH_CAPACITY, &first_frame[0], INTEGRATION_PREVIEW_PATH_CAPACITY)
    second_created: i64 = shell_preview_paths_create(&second_input[0], INTEGRATION_PREVIEW_PATH_CAPACITY, &second_frame[0], INTEGRATION_PREVIEW_PATH_CAPACITY)
    distinct: bool = first_created == 0 and second_created == 0 and preview_paths_differ(first_input, second_input) and preview_paths_differ(first_frame, second_frame)
    expect_integration(distinct, 68)
    if distinct:
        first_input_path: mutable cstr = ""
        first_frame_path: mutable cstr = ""
        second_input_path: mutable cstr = ""
        second_frame_path: mutable cstr = ""
        can Unsafe.PointerCast:
            first_input_path <- (&first_input[0]).cast[cstr] can Unsafe.PointerCast
            first_frame_path <- (&first_frame[0]).cast[cstr] can Unsafe.PointerCast
            second_input_path <- (&second_input[0]).cast[cstr] can Unsafe.PointerCast
            second_frame_path <- (&second_frame[0]).cast[cstr] can Unsafe.PointerCast
        payload: mutable darray[u8] = [69, 76, 80, 70]
        first_write: i64 = PosixFile::write_bytes_plain(first_input_path, payload)
        second_write: i64 = PosixFile::write_bytes_plain(second_input_path, payload)
        expect_integration(first_write == 4 and second_write == 4, 69)
        mixed_cleanup: i64 = shell_preview_paths_cleanup(first_input_path, second_frame_path)
        protected_first: mutable darray[u8] = []
        protected_second: mutable darray[u8] = []
        protected_first_length: i64 = PosixFile::read_bytes_result(&protected_first, first_input_path, 8)
        protected_second_length: i64 = PosixFile::read_bytes_result(&protected_second, second_input_path, 8)
        expect_integration(mixed_cleanup != 0 and protected_first_length == 4 and protected_second_length == 4, 73)
        first_cleanup: i64 = shell_preview_paths_cleanup(first_input_path, first_frame_path)
        remaining: mutable darray[u8] = []
        remaining_length: i64 = PosixFile::read_bytes_result(&remaining, second_input_path, 8)
        expect_integration(first_cleanup == 0 and remaining_length == 4 and remaining[0] == 69 and remaining[3] == 70, 70)
        second_cleanup: i64 = shell_preview_paths_cleanup(second_input_path, second_frame_path)
        absent: mutable darray[u8] = []
        absent_status: i64 = PosixFile::read_bytes_result(&absent, second_input_path, 8)
        expect_integration(second_cleanup == 0 and PosixFile::read_error_is_not_found(absent_status), 71)

    tiny_input: mutable u8[2] = zeroed
    bounded_frame: mutable u8[1024] = zeroed
    bounded_failure: i64 = shell_preview_paths_create(&tiny_input[0], 2, &bounded_frame[0], INTEGRATION_PREVIEW_PATH_CAPACITY)
    expect_integration(bounded_failure != 0 and tiny_input[0] == 0 and bounded_frame[0] == 0, 72)

def test_debuggee_terminal_state() -> void:
    test_shell: mutable Shell = new_shell()
    test_shell.debug_session_active <- true
    test_shell.debug_poll_deadline_ms <- 750
    test_shell.debug_breakpoint_count <- 1
    test_shell.debug_breakpoint_lines[0.usize()] <- 12
    test_shell.source_mode <- true
    test_shell.standalone_source <- true
    test_shell.source_line_count <- 32
    not_terminal: bool = ShellDebug::handle_terminal_snapshot(test_shell,
        "Debugger running. Continue, pause, or step when the target stops.")
    expect_integration(not not_terminal and test_shell.debug_session_active, 366)
    terminal: bool = ShellDebug::handle_terminal_snapshot(test_shell,
        "Debuggee exited. Press Debug to launch it again.")
    expect_integration(terminal and not test_shell.debug_session_active
        and test_shell.debug_poll_deadline_ms == 0
        and ShellDebug::has_breakpoint(test_shell, 12)
        and test_shell.source_mode and test_shell.standalone_source
        and test_shell.source_line_count == 32
        and same_text(status_view(test_shell), "Debuggee exited. Press Debug to launch it again."), 367)

def run_preview(snapshot: HostClient::HostReply) -> i64:
    return fail_preview(1) if snapshot.result != 1 or snapshot.text.count == 0
    input_storage: mutable u8[1024] = zeroed
    frame_storage: mutable u8[1024] = zeroed
    return fail_preview(2) if shell_preview_paths_create(&input_storage[0], INTEGRATION_PREVIEW_PATH_CAPACITY, &frame_storage[0], INTEGRATION_PREVIEW_PATH_CAPACITY) != 0
    input_path: mutable cstr = ""
    frame_path: mutable cstr = ""
    can Unsafe.PointerCast:
        input_path <- (&input_storage[0]).cast[cstr] can Unsafe.PointerCast
        frame_path <- (&frame_storage[0]).cast[cstr] can Unsafe.PointerCast
    if PosixFile::write_bytes_plain(input_path, snapshot.text) != snapshot.text.count.i64():
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(3)
    if integration_setenv("ELISA_UI_PREVIEW_INPUT", input_path) != 0:
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(4)
    if integration_setenv("ELISA_UI_SNAPSHOT", frame_path) != 0:
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(5)
    if integration_setenv("ELISA_UI_SMOKE_FRAMES", "1") != 0:
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(6)

    arguments: mutable darray[cstr] = []
    arguments.push("build/preview_worker")
    worker: mutable PosixProcess::Process = PosixProcess::start(&arguments)
    if not PosixProcess::valid(&worker):
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(7)
    worker_stdout: mutable darray[u8] = []
    worker_stderr: mutable darray[u8] = []
    worker_output_truncated: mutable bool = false
    if not wait_preview_worker(worker, 60000, &worker_stdout, &worker_stderr, &worker_output_truncated):
        _ = PosixProcess::cancel(&worker)
        PosixProcess::dispose(&worker)
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(8)
    status: PosixProcess::Status = PosixProcess::status(&worker)
    PosixProcess::dispose(&worker)
    if not status.finished or status.exit_code != 0 or status.stdout_truncated or worker_output_truncated:
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(9)
    if not bytes_contain(worker_stdout, "preview_revision=") or not bytes_contain(worker_stdout, "rect n2 ") or not bytes_contain(worker_stdout, "rect n3 "):
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(10)
    frame_bytes: mutable darray[u8] = []
    frame_length: usize = PosixFile::read_bytes(&frame_bytes, frame_path, 8388608)
    if frame_length < 1000 or frame_bytes.count < 8:
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(11)
    if frame_bytes[0] != 137 or frame_bytes[1] != 80 or frame_bytes[2] != 78 or frame_bytes[3] != 71:
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(12)
    identity_length: mutable usize = 0
    identity_hash_high: mutable u32 = 0
    identity_hash_low: mutable u32 = 0
    identity_status: i64 = shell_preview_frame_identity(frame_path, &identity_length, &identity_hash_high, &identity_hash_low)
    identity_ok: bool = identity_status == 0
    snapshot_revision: u64 = preview_snapshot_revision(snapshot.text)
    snapshot_signature: i64 = preview_snapshot_signature(&snapshot.text)
    manifest_ok: bool = ShellPreview::accept_frame_identity_output(worker_stdout, snapshot_revision, snapshot_signature, identity_length, identity_hash_high, identity_hash_low)
    if not identity_ok or not manifest_ok:
        integration_report_i64("preview_identity_status=", identity_status)
        integration_report_i64("preview_identity_length=", identity_length.i64())
        integration_report_i64("preview_identity_revision=", snapshot_revision.i64())
        integration_report_i64("preview_identity_signature=", snapshot_signature)
        integration_report_i64("preview_manifest_present=", 1 if bytes_contain(worker_stdout, "frame_v1 ") else 0)
        integration_report_i64("preview_manifest_accepted=", 1 if manifest_ok else 0)
        report_frame_manifest(worker_stdout)
        _ = shell_preview_paths_cleanup(input_path, frame_path)
        return fail_preview(13)
    checksum: mutable i64 = 0
    for index in 0..<frame_bytes.count:
        checksum <- checksum + frame_bytes[index].i64() * ((index % 251 + 1).i64())
    _ = shell_preview_paths_cleanup(input_path, frame_path)
    return checksum

def click(handle: UiHandles::Handle) -> void:
    return if not UiHandles::is_valid(handle) or not UiHandles::is_visible(handle) or not UiHandles::is_enabled(handle)
    if UiHandles::widget(handle) is widget:
        x: f32 = widget.x + widget.width * 0.5
        y: f32 = widget.y + widget.height * 0.5
        UiHarness::dispatch(UiCore::PointerEvent.Down(at: UiCore::Vec2(x, y), button: UiCore::PointerButton.Primary.i32()))
        UiHarness::dispatch(UiCore::PointerEvent.Up(at: UiCore::Vec2(x, y), button: UiCore::PointerButton.Primary.i32()))

def type_editor_value(handle: UiHandles::Handle, value: sview) -> void:
    return if not UiHandles::request_focus(handle)
    original: sview = UiHandles::text_value(handle)
    UiHandles::set_selection_utf16(handle, 0, original.len.usize())
    app_text_input(value)
    UiHarness::dispatch(UiCore::KeyEvent.Down(UiCore::Key.Enter))

def clean_host() -> void:
    return if not shell.host_running
    HostClient::stop(&host_process)
    _ = PosixProcess::poll(&host_process, 1000)
    PosixProcess::dispose(&host_process)
    shell.host_running <- false

def clean_test_project(form_path: cstr, manifest_path: cstr, forms_path: cstr, root_path: cstr) -> void:
    _ = PosixFile::remove(form_path)
    _ = PosixFile::remove(manifest_path)
    _ = PosixFile::remove_directory_if_empty(forms_path)
    _ = PosixFile::remove_directory_if_empty(root_path)

def clean_generated_project() -> void:
    _ = PosixFile::remove(PROJECT_GENERATED_README_PATH)
    _ = PosixFile::remove(PROJECT_GENERATED_APP_PATH)
    _ = PosixFile::remove(PROJECT_GENERATED_HANDLERS_PATH)
    _ = PosixFile::remove(PROJECT_GENERATED_VIEW_PATH)
    _ = PosixFile::remove(PROJECT_GENERATED_MAP_PATH)
    _ = PosixFile::remove(PROJECT_GENERATED_MANIFEST_PATH)
    _ = PosixFile::remove_directory_if_empty(PROJECT_GENERATED_ROOT_PATH)

def clean_compact_generated_project() -> void:
    _ = PosixFile::remove("build/Compact Elisa Project/generated/README.md")
    _ = PosixFile::remove("build/Compact Elisa Project/generated/App_app.elisa")
    _ = PosixFile::remove("build/Compact Elisa Project/generated/App_handlers.elisa")
    _ = PosixFile::remove("build/Compact Elisa Project/generated/App_view.elisa")
    _ = PosixFile::remove("build/Compact Elisa Project/generated/App_view.elisa.map.json")
    _ = PosixFile::remove("build/Compact Elisa Project/generated/.elisa-ide-generation.json")
    _ = PosixFile::remove_directory_if_empty("build/Compact Elisa Project/generated")

def dispatch_reorder_shortcut(key: UiCore::Key) -> void:
    UiHarness::dispatch(UiCore::KeyEvent.Down(UiCore::Key.LeftSuper))
    UiHarness::dispatch(UiCore::KeyEvent.Down(UiCore::Key.LeftShift))
    UiHarness::dispatch(UiCore::KeyEvent.Down(key))
    UiHarness::dispatch(UiCore::KeyEvent.Up(key))
    UiHarness::dispatch(UiCore::KeyEvent.Up(UiCore::Key.LeftShift))
    UiHarness::dispatch(UiCore::KeyEvent.Up(UiCore::Key.LeftSuper))

