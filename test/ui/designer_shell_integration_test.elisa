    click(shell.build_button)
    build_wait: mutable i64 = 0
    while BuildJob::is_running(&build_job) and build_wait < 120000:
        app_frame()
        build_wait <- build_wait + 1
    built_project: mutable darray[u8] = []
    built_project_length: usize = PosixFile::read_bytes(&built_project, "build/elisa_project_app", 8)
    expect_integration(build_wait < 120000 and build_job.state == BuildJob::State.Succeeded
        and built_project_length > 0, 135)
    build_output_text: sview = UiFlat::widget(shell.build_output.widget_id.usize()).text
    build_output_view: sview = BuildJob::output_view(&build_job)
    expect_integration(UiHandles::is_visible(shell.build_output), 142)
    expect_integration(bytes_contain(geometry_bytes(build_output_view), "built project application"), 143)
    expect_integration(bytes_contain(geometry_bytes(build_output_text), "built project application"), 144)
    type_editor_value(shell.inspector_editors[0.usize()], "12")
    expect_integration(HostClient::request(host_process, 40, 0, 0).result == 1, 283)
    click(shell.save_button)
    expect_integration(HostClient::request(host_process, 40, 0, 0).result == 0, 284)
    run_project(shell)
    expect_integration(not run_active
        and bytes_contain(geometry_bytes(status_view(shell)), "Project changed since its build"), 285)
    command(shell, 13, 0)
    click(shell.save_button)
    expect_integration(HostClient::request(host_process, 40, 0, 0).result == 0, 286)
    # Task execution opens Output; return to Problems before verifying that
    # compiler diagnostics remain navigable alongside the saved build log.
    select_bottom_tab(shell, 0)
    # A compiler problem for a different handwritten file opens that file and
    # selects its exact UTF-8 byte location, even when another source document
    # is currently displayed in the Source pane.
    UiHandles::replace_text(shell.open_path_field, sview(SOURCE_VIEW_PATH, 0, -1))
    open_document(shell)
    prior_build_source_path: HostClient::HostReply = HostClient::request(host_process, 114, 0, 0)
    handler_declaration_offset: i64 = byte_index_of(opened_handler_bytes, "def project_saved(")
    handler_diagnostic_line: mutable i64 = 0
    handler_diagnostic_column: mutable i64 = 0
    handler_diagnostic_scan: mutable i64 = 0
    while handler_diagnostic_scan < handler_declaration_offset:
        if opened_handler_bytes[handler_diagnostic_scan.usize()] == 10:
            handler_diagnostic_line <- handler_diagnostic_line + 1
            handler_diagnostic_column <- 0
        else:
            handler_diagnostic_column <- handler_diagnostic_column + 1
        handler_diagnostic_scan <- handler_diagnostic_scan + 1
    cross_file_diagnostic: mutable darray[u8] = []
    append_panel_text(&cross_file_diagnostic, sview(PROJECT_HANDLERS_PATH, 0, -1))
    append_panel_text(&cross_file_diagnostic, ":")
    append_nonnegative(&cross_file_diagnostic, handler_diagnostic_line + 1)
    append_panel_text(&cross_file_diagnostic, ":")
    append_nonnegative(&cross_file_diagnostic, handler_diagnostic_column + 1)
    append_panel_text(&cross_file_diagnostic, ": error: cross-file handler fixture")
    UiHandles::set_text(shell.build_output, ShellBytes::view_of(&cross_file_diagnostic), 11.0, shell_color(172, 184, 204))
    shell.build_problem_count <- build_diagnostic_count(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    refresh_problems(shell, host_process)
    cross_file_row_index: mutable i32 = -1
    cross_file_problem_scan: mutable i32 = 0
    while cross_file_problem_scan < MAX_PROBLEM_ROWS:
        candidate_text: sview = UiFlat::widget(shell.problem_rows[cross_file_problem_scan.usize()].widget_id.usize()).text
        if UiHandles::is_visible(shell.problem_rows[cross_file_problem_scan.usize()]) and bytes_contain(geometry_bytes(candidate_text), "cross-file handler fixture"):
            cross_file_row_index <- cross_file_problem_scan
        cross_file_problem_scan <- cross_file_problem_scan + 1
    if cross_file_row_index >= 0:
        _ = widget_event_rows(shell, shell.problem_rows[cross_file_row_index.usize()].widget_id.usize())
    opened_build_source_path: HostClient::HostReply = HostClient::request(host_process, 114, 0, 0)
    cross_file_line_index: i32 = (shell.source_selected_line - shell.source_page_start - 1).i32()
    cross_file_line_text: sview = UiHandles::text_value(shell.source_line_rows[cross_file_line_index.usize()]) if cross_file_line_index >= 0 and cross_file_line_index < shell.source_line_count else ""
    expect_integration(prior_build_source_path.result == 1
        and same_text(ShellBytes::view_of(&prior_build_source_path.text), sview(SOURCE_VIEW_PATH, 0, -1))
        and same_text(ShellBytes::view_of(&opened_build_source_path.text), sview(PROJECT_HANDLERS_PATH, 0, -1))
        and cross_file_row_index >= 0 and shell.source_mode
        and shell.source_selected_line == handler_diagnostic_line + 1
        and bytes_contain(geometry_bytes(cross_file_line_text), "def project_saved(")
        and bytes_contain(geometry_bytes(status_view(shell)), "Opened build diagnostic source at line"), 263)
    generated_file_bytes: mutable darray[u8] = []
    generated_file_length: usize = PosixFile::read_bytes(&generated_file_bytes, PROJECT_GENERATED_VIEW_PATH, 1048577)
    generated_map_file_bytes: mutable darray[u8] = []
    generated_map_file_length: usize = PosixFile::read_bytes(&generated_map_file_bytes, PROJECT_GENERATED_MAP_PATH, 8388609)
    live_generated_source: HostClient::HostReply = HostClient::request(host_process, 106, 0, 0)
    live_generated_map: HostClient::HostReply = HostClient::request(host_process, 107, 0, 0)
    generated_button_offset: i64 = byte_index_of(generated_file_bytes, "UiHandles::button")
    expect_integration(generated_file_length > 0 and generated_map_file_length > 0
        and live_generated_source.result == 1 and live_generated_map.result == 1
        and ShellBytes::equal(ShellBytes::view_of(&generated_file_bytes), ShellBytes::view_of(&live_generated_source.text))
        and ShellBytes::equal(ShellBytes::view_of(&generated_map_file_bytes), ShellBytes::view_of(&live_generated_map.text))
        and generated_button_offset >= 0, 250)
    generated_line: mutable i64 = 0
    generated_column: mutable i64 = 0
    generated_scan: mutable i64 = 0
    while generated_scan < generated_button_offset:
        if generated_file_bytes[generated_scan.usize()] == 10:
            generated_line <- generated_line + 1
            generated_column <- 0
        else:
            generated_column <- generated_column + 1
        generated_scan <- generated_scan + 1
    generated_diagnostic: mutable darray[u8] = []
    append_panel_text(&generated_diagnostic, sview(PROJECT_GENERATED_VIEW_PATH, 0, -1))
    append_panel_text(&generated_diagnostic, ":")
    append_nonnegative(&generated_diagnostic, generated_line + 1)
    append_panel_text(&generated_diagnostic, ":")
    append_nonnegative(&generated_diagnostic, generated_column + 1)
    append_panel_text(&generated_diagnostic, ": error: invalid handler")
    UiHandles::set_text(shell.build_output, ShellBytes::view_of(&generated_diagnostic), 11.0, shell_color(172, 184, 204))
    shell.build_problem_count <- build_diagnostic_count(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    refresh_problems(shell, host_process)
    expect_integration(shell.build_problem_count == 1, 215)
    build_row_index: mutable i32 = -1
    problem_scan: mutable i32 = 0
    while problem_scan < MAX_PROBLEM_ROWS:
        candidate_text: sview = UiFlat::widget(shell.problem_rows[problem_scan.usize()].widget_id.usize()).text
        if UiHandles::is_visible(shell.problem_rows[problem_scan.usize()]) and bytes_contain(geometry_bytes(candidate_text), "invalid handler"):
            build_row_index <- problem_scan
        problem_scan <- problem_scan + 1
    expect_integration(build_row_index >= 0, 151)
    click(shell.hierarchy_rows[0.usize()])
    diagnostic_root_name: HostClient::HostReply = HostClient::request(host_process, 54, 0, 0)
    expect_integration(diagnostic_root_name.result == 1
        and same_text(ShellBytes::view_of(&diagnostic_root_name.text), "Column"), 253)
    build_row_visible: mutable bool = false
    if build_row_index >= 0:
        build_row_visible <- UiHandles::is_visible(shell.problem_rows[build_row_index.usize()])
        _ = widget_event_rows(shell, shell.problem_rows[build_row_index.usize()].widget_id.usize())
    expect_integration(build_row_visible, 152)
    generated_selected_name: HostClient::HostReply = HostClient::request(host_process, 54, 0, 0)
    expect_integration(bytes_contain(geometry_bytes(status_view(shell)), "Selected generated build diagnostic")
        and generated_selected_name.result == 1
        and same_text(ShellBytes::view_of(&generated_selected_name.text), "Button"), 251)
    _ = PosixFile::remove("build/unmapped-diagnostic-source.elisa")
    _ = PosixFile::remove("build/unmapped-diagnostic-source.elisa.map.json")
    UiHandles::set_text(shell.build_output, "build/unmapped-diagnostic-source.elisa:3:5: error: unmapped generated diagnostic", 11.0, shell_color(172, 184, 204))
    shell.build_problem_count <- build_diagnostic_count(UiFlat::widget(shell.build_output.widget_id.usize()).text)
    refresh_problems(shell, host_process)
    unmapped_row_index: mutable i32 = -1
    problem_scan <- 0
    while problem_scan < MAX_PROBLEM_ROWS:
        candidate_text: sview = UiFlat::widget(shell.problem_rows[problem_scan.usize()].widget_id.usize()).text
        if UiHandles::is_visible(shell.problem_rows[problem_scan.usize()]) and bytes_contain(geometry_bytes(candidate_text), "unmapped generated diagnostic"):
            unmapped_row_index <- problem_scan
        problem_scan <- problem_scan + 1
    if unmapped_row_index >= 0:
        _ = widget_event_rows(shell, shell.problem_rows[unmapped_row_index.usize()].widget_id.usize())
    expect_integration(unmapped_row_index >= 0
        and bytes_contain(geometry_bytes(status_view(shell)), "Cannot read Elisa source file"), 252)
    expect_integration(shell.problem_copy_length > 0 and UiHandles::is_enabled(shell.problem_copy_button), 165)
    expect_integration(widget_event_rows(shell, shell.problem_copy_button.widget_id.usize())
        and same_text(status_view(shell), "The system clipboard is unavailable"), 166)

    test_hierarchy_multi_selection()
    test_deep_hierarchy_breadcrumb()
    test_drag_editing()

    # The compact path row exposes the same project action at narrow widths.
    clean_test_project(COMPACT_PROJECT_FORM_PATH, COMPACT_PROJECT_MANIFEST_PATH, "build/Compact Elisa Project/forms", COMPACT_PROJECT_ROOT_PATH)
    UiCore::set_viewport(600.0, 760.0)
    apply_shell_layout(shell)
    UiHandles::layout(UiCore::viewport_width(), UiCore::viewport_height())
    expect_integration(shell.compact_mode and UiHandles::is_visible(shell.compact_new_project_button), 48)
    UiHandles::replace_text(shell.compact_open_path_field, sview(COMPACT_PROJECT_ROOT_PATH, 0, -1))
    click(shell.compact_new_project_button)
    compact_manifest: mutable darray[u8] = []
    compact_manifest_length: usize = PosixFile::read_bytes(&compact_manifest, COMPACT_PROJECT_MANIFEST_PATH, 1048576)
    expect_integration(compact_manifest_length > 0 and not shell.projection.dirty and shell.projection.node_count == 1, 49)

    test_keyboard_reorder_shortcuts()

    # A source-only Elisa entry builds against the compiler/runtime without
    # SDL, runs as its own supervised process, and becomes stale as soon as
    # the open source buffer changes.
    _ = PosixFile::remove("build/source-task-preserved.elisa")
    if HostClient::request(host_process, 130, 0, 0).result == 1:
        preserved_source: HostClient::HostReply = HostClient::request_text(host_process, 146, 0, 0, "build/source-task-preserved.elisa")
        expect_integration(preserved_source.result == 1, 281)
    if HostClient::request(host_process, 40, 0, 0).result == 1:
        preserved_form: HostClient::HostReply = HostClient::request(host_process, 15, 0, 0)
        expect_integration(preserved_form.result == 1, 282)
    source_task_path: sview = "test/fixtures/source_task_fixture.elisa"
    if shell.compact_mode:
        UiHandles::replace_text(shell.compact_open_path_field, source_task_path)
    else:
        UiHandles::replace_text(shell.open_path_field, source_task_path)
    open_document(shell)
    expect_integration(shell.standalone_source and shell.source_mode
        and HostClient::request(host_process, 113, 0, 0).result == 1, 276)
    test_package_task_workflow()
    expect_integration(UiHandles::is_visible(shell.profile_button)
        and UiHandles::is_enabled(shell.profile_button), 320)
    expect_integration(integration_setenv("ELISA_PROFILER", "test/fixtures/fake_elisa_profiler.py") == 0, 321)
    expect_integration(integration_setenv("ELISA_IDE_PROFILE_ROOT", "../../build/profile-test-results") == 0, 322)
    click(shell.profile_button)
    profile_wait: mutable i64 = 0
    while BuildJob::is_running(&build_job) and profile_wait < 30000:
        app_frame()
        profile_wait <- profile_wait + 1
    profile_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
    expect_integration(profile_wait < 30000 and not profile_active
        and build_job.state == BuildJob::State.Succeeded
        and bytes_contain(profile_output, "Profile capture accepted")
        and bytes_contain(profile_output, "main: 1000 ns inclusive")
        and bytes_contain(profile_output, "Profile progress: capture complete")
        and bytes_contain(profile_output, "Task lifecycle: unsupported")
        and bytes_contain(profile_output, "Process attach: unavailable")
        and bytes_contain(profile_output, "Artifact SHA-256:"), 323)
    expect_integration(bytes_contain(geometry_bytes(status_view(shell)), "validated report is in Build Output"), 324)
    expect_integration(shell.profile_report_ready, 338)
    expect_integration(same_text(UiFlat::widget(shell.profile_button.widget_id.usize()).text, "Open Report"), 342)
    expect_integration(integration_setenv("ELISA_IDE_VIEWER", "test/fixtures/fake_profile_viewer.py") == 0, 339)
    click(shell.profile_button)
    report_open_wait: mutable i64 = 0
    while BuildJob::is_running(&build_job) and report_open_wait < 30000:
        app_frame()
        report_open_wait <- report_open_wait + 1
    report_open_output: darray[u8] = geometry_bytes(BuildJob::output_view(&build_job))
    expect_integration(report_open_wait < 30000 and not profile_active
        and build_job.state == BuildJob::State.Succeeded
        and bytes_contain(report_open_output, "Opened html profile report"), 340)

    shell.profile_report_ready <- false
    expect_integration(integration_setenv("FAKE_PROFILE_SLEEP", "1") == 0, 325)
    click(shell.profile_button)
    profile_cancel_wait: mutable i64 = 0
    while not profile_active and profile_cancel_wait < 1000:
        app_frame()
        profile_cancel_wait <- profile_cancel_wait + 1
    expect_integration(profile_active and BuildJob::is_running(&build_job), 326)
    click(shell.stop_button)
    expect_integration(not profile_active and not BuildJob::is_running(&build_job)
        and build_job.state == BuildJob::State.Cancelled
        and bytes_contain(geometry_bytes(status_view(shell)), "Profile cancelled"), 327)
    expect_integration(integration_setenv("FAKE_PROFILE_SLEEP", "") == 0, 328)

    click(shell.build_button)
    source_build_wait: mutable i64 = 0
    while BuildJob::is_running(&build_job) and source_build_wait < 120000:
        app_frame()
        source_build_wait <- source_build_wait + 1
    source_artifact_bytes: mutable darray[u8] = []
    source_artifact_length: usize = PosixFile::read_bytes(&source_artifact_bytes, "build/elisa_ide_source_app", 8)
    source_build_ok: bool = source_build_wait < 120000 and build_job.state == BuildJob::State.Succeeded and shell.source_artifact_valid and source_artifact_length > 0 and bytes_contain(geometry_bytes(BuildJob::output_view(&build_job)), "elisa_ide_source_app")
    if not source_build_ok:
        report_sview(status_view(shell))
        integration_report_i64("source_build_wait=", source_build_wait)
        integration_report_i64("source_build_succeeded=", 1 if build_job.state == BuildJob::State.Succeeded else 0)
        integration_report_i64("source_artifact_valid=", 1 if shell.source_artifact_valid else 0)
        integration_report_i64("source_artifact_length=", source_artifact_length.i64())
        integration_report_i64("source_build_output_length=", BuildJob::output_view(&build_job).len)
        integration_report_i64("source_build_output_has_name=", 1 if bytes_contain(geometry_bytes(BuildJob::output_view(&build_job)), "elisa_ide_source_app") else 0)
        report_sview(BuildJob::output_view(&build_job))
    expect_integration(source_build_ok, 277)
    run_project(shell)
    source_run_wait: mutable i64 = 0
    while run_active and source_run_wait < 30000:
        app_frame()
        source_run_wait <- source_run_wait + 1
    expect_integration(source_run_wait < 30000 and not run_active, 351)
    expect_integration(bytes_contain(geometry_bytes(BuildJob::output_view(&build_job)), "source-task-ran"), 352)
    expect_integration(same_text(status_view(shell), "Application finished"), 353)
    source_dirty_row: UiHandles::Handle = shell.source_line_rows[2.usize()]
    source_dirty_focused: bool = UiHandles::request_focus(source_dirty_row)
    UiHandles::set_selection_utf16(source_dirty_row, 0, UiFlat::text_utf16_length(source_dirty_row.widget_id.usize()))
    debug_dirty_input: mutable darray[u8] = source_line_prefix(shell, 3)
    append_panel_text(&debug_dirty_input, "def main() -> i64: # unsaved source edit")
    app_text_input(ShellBytes::view_of(&debug_dirty_input))
    app_widget_event(source_dirty_row.widget_id.usize(), UiConst::WidgetEvent.Change.i32())
    expect_integration(source_dirty_focused
        and HostClient::request(host_process, 130, 0, 0).result == 1, 279)
    # Give the retained editor one normal frame after the source edit so its
    # refreshed row geometry and toolbar hit targets are current before input.
    app_frame()
    expect_integration(UiHandles::is_visible(shell.profile_button)
        and UiHandles::is_enabled(shell.profile_button), 337)
    click(shell.profile_button)
    expect_integration(not BuildJob::is_running(&build_job)
        and bytes_contain(geometry_bytes(status_view(shell)), "Save the source file before profiling it"), 329)
    dispatch_debug_restart_shortcut()
    expect_integration(not BuildJob::is_running(&build_job)
        and bytes_contain(geometry_bytes(status_view(shell)), "Save the source file before debugging it"), 466)
    run_project(shell)
    expect_integration(not run_active
        and bytes_contain(geometry_bytes(status_view(shell)), "Save the source file and rebuild"), 280)
    _ = PosixFile::remove("build/source-task-preserved.elisa")

    UiHarness::frame()
    return finish()

def finish() -> i64:
    ShellDebug::shutdown(shell)
    ShellLsp::stop(shell)
    ShellPreview::stop(shell)
    clean_host()
    UiHarness::stop()
    if integration_failure != 0:
        integration_report_i64("designer shell integration assertion=", integration_failure)
        return 1
    integration_report_i64("designer shell integration assertions passed=", integration_assertion_count)
    return 0
