# Document host: serves the editor shell over a binary request/reply protocol.
#
# The shell is a UI unit and the document core is a core unit; they cannot
# share a compilation unit or link into one executable (ADR-001, ADR-013). The
# host runs as its own process.
#
# Protocol (v1): every 32-bit integer is little-endian. A request is three
# integers (opcode, arg0, arg1) followed, for text-bearing opcodes, by a 4-byte
# length and that many UTF-8 bytes. A reply is the result integer, then a
# 4-byte text length and that many bytes. This file is flat and file-scoped:
# stage1 is sensitive to module/global compositions (stage1-notes.md).

include "../../src/workspace/designer_session.elisa"

@link_name("designer_stdin_read")
extern host_stdin_read(out: mutable void&, capacity: usize) -> i64 can[Blocking.IO]
struct HostText:
    buf: mutable darray[u8]

global mutable host_text: HostText = zeroed
const HOST_REPLY_CAPACITY: usize = 1048576
global mutable host_reply_bytes: mutable u8[HOST_REPLY_CAPACITY] = zeroed
global mutable host_reply_length: usize = 0

@link_name("designer_stdout_write")
extern host_stdout_write(bytes: void&, count: usize) -> i64 can[Blocking.IO]

def host_read_byte() -> i64:
    can Blocking.IO, Abort.Panic, Unsafe.PointerCast:
        buffer: mutable u8[1] = zeroed
        amount: i64 = host_stdin_read(&buffer[0], 1)
        return -1 if amount <= 0
        return buffer[0].i64()

def host_read_i32() -> i64:
    can Blocking.IO, Abort.Panic:
        value: mutable i64 = 0
        shift: mutable i64 = 0
        while shift < 4:
            part: i64 = host_read_byte()
            if part < 0:
                return -1
            factor: mutable i64 = 1
            step: mutable i64 = 0
            while step < shift:
                factor <- factor * 256
                step <- step + 1
            value <- value + part * factor
            shift <- shift + 1
        return value

def host_write_i32(value: i64) -> void:
    can Blocking.IO, Unsafe.PointerCast:
        buffer: mutable u8[4] = zeroed
        buffer[0] <- (value & 255).u8()
        buffer[1] <- ((value >> 8) & 255).u8()
        buffer[2] <- ((value >> 16) & 255).u8()
        buffer[3] <- ((value >> 24) & 255).u8()
        _ = host_stdout_write(&buffer[0], 4)

def host_read_text(out: mutable darray[u8]&) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release:
        length: i64 = host_read_i32()
        if length < 0:
            return false
        out.resize(0)
        DesignStore::ensure_bytes(out, length.usize() + 1)
        index: mutable i64 = 0
        while index < length:
            value: i64 = host_read_byte()
            if value < 0:
                return false
            out.push(value.u8())
            index <- index + 1
        return true

def host_write_text(text: sview) -> void:
    can Blocking.IO, Unsafe.PointerCast:
        host_write_i32(text.len)
        if text.len > 0:
            _ = host_stdout_write(text.data.cast[void&], text.len.usize())

def host_dispatch(opcode: i64, arg0: i64, arg1: i64, running: mutable bool&) -> i64:
    can Memory.Allocate, Memory.Release:
        running <- true
        if opcode == 1:
            return 1
        if opcode == 2:
            running <- false
            return 1
        if opcode == 10:
            if DesignerSession::new_document("Demo", "Main"):
                return 1
            return 0
        if opcode == 11:
            if DesignerSession::open_document(DesignText::view_of(host_text.buf)):
                return 1
            return 0
        if opcode == 12:
            if DesignerSession::delete_selection():
                return 1
            return 0
        if opcode == 13:
            if DesignerSession::undo():
                return 1
            return 0
        if opcode == 14:
            if DesignerSession::redo():
                return 1
            return 0
        if opcode == 15:
            if DesignerSession::save():
                return 1
            return 0
        if opcode == 16:
            if DesignerSession::duplicate_selection():
                return 1
            return 0
        if opcode == 120:
            if DesignerSession::copy_selection():
                return 1
            return 0
        if opcode == 121:
            if DesignerSession::cut_selection():
                return 1
            return 0
        if opcode == 122:
            if DesignerSession::paste_selection():
                return 1
            return 0
        if opcode == 123:
            if DesignerSession::wrap_selection(arg0):
                return 1
            return 0
        if opcode == 124:
            if DesignerSession::unwrap_selection():
                return 1
            return 0
        if opcode == 125:
            if DesignerSession::convert_container(arg0):
                return 1
            return 0
        if opcode == 126:
            if DesignerSession::select_ancestor():
                return 1
            return 0
        if opcode == 17:
            if DesignerSession::reorder_selection(arg0 != 0):
                return 1
            return 0
        if opcode == 84:
            if DesignerSession::indent_selection():
                return 1
            return 0
        if opcode == 85:
            if DesignerSession::outdent_selection():
                return 1
            return 0
        if opcode == 86:
            if DesignerSession::can_insert_component_at(arg0, arg1):
                return 1
            return 0
        if opcode == 87:
            return DesignerSession::insert_component_at(arg0, arg1)
        if opcode == 88:
            if DesignerSession::can_reparent_selection_to(arg0):
                return 1
            return 0
        if opcode == 89:
            if DesignerSession::reparent_selection_to(arg0):
                return 1
            return 0
        if opcode == 18:
            if DesignerSession::save_as_form(DesignText::view_of(host_text.buf)):
                return 1
            return 0
        if opcode == 19:
            if DesignerSession::create_project(DesignText::view_of(host_text.buf)):
                return 1
            return 0
        if opcode == 20:
            return DesignerSession::hierarchy_count()
        if opcode == 21:
            return DesignerSession::palette_count()
        if opcode == 22:
            return DesignerSession::inspector_count()
        if opcode == 23:
            return DesignerSession::node_count()
        if opcode == 24:
            return DesignerSession::selection_count()
        if opcode == 25:
            return DesignerSession::problems_count_value()
        if opcode == 90:
            return DesignerSession::event_count()
        if opcode == 30:
            return DesignerSession::insert_component(arg0)
        if opcode == 31:
            if DesignerSession::select_hierarchy_row(arg0):
                return 1
            return 0
        if opcode == 81:
            if DesignerSession::select_node_by_id(DesignText::view_of(host_text.buf)):
                return 1
            return 0
        if opcode == 82:
            if DesignerSession::toggle_hierarchy_row(arg0):
                return 1
            return 0
        if opcode == 83:
            if DesignerSession::select_hierarchy_range(arg0):
                return 1
            return 0
        if opcode == 32:
            if DesignerSession::toggle_inspector(arg0):
                return 1
            return 0
        if opcode == 33:
            if DesignerSession::cycle_inspector(arg0):
                return 1
            return 0
        if opcode == 34:
            if DesignerSession::reset_inspector(arg0):
                return 1
            return 0
        if opcode == 40:
            if DesignerSession::is_dirty():
                return 1
            return 0
        if opcode == 41:
            if DesignerSession::can_undo():
                return 1
            return 0
        if opcode == 42:
            if DesignerSession::can_redo():
                return 1
            return 0
        if opcode == 43:
            if DesignerSession::hierarchy_selected(arg0):
                return 1
            return 0
        if opcode == 44:
            if DesignerSession::can_save():
                return 1
            return 0
        if opcode == 50:
            return set_text(DesignerSession::hierarchy_label(arg0))
        if opcode == 51:
            return set_text(DesignerSession::hierarchy_type(arg0))
        if opcode == 52:
            return set_text(DesignerSession::inspector_label(arg0))
        if opcode == 53:
            return set_text(DesignerSession::inspector_value(arg0))
        if opcode == 54:
            return set_text(DesignerSession::selection_name())
        if opcode == 55:
            return set_text(DesignerSession::selection_type())
        if opcode == 56:
            return set_text(DesignerSession::status())
        if opcode == 57:
            return set_text(DesignerSession::title())
        if opcode == 58:
            return set_text(DesignerSession::form_title())
        if opcode == 109:
            return set_text(DesignerSession::form_path())
        if opcode == 112:
            if DesignerSession::open_source(DesignText::view_of(host_text.buf)):
                return 1
            return 0
        if opcode == 113:
            if DesignerSession::source_view_is_open():
                return 1
            return 0
        if opcode == 114:
            return set_text(DesignerSession::source_view_path())
        if opcode == 115:
            return DesignerSession::source_view_line_count()
        if opcode == 118:
            return DesignerSession::source_view_line_byte_start(arg0)
        if opcode == 116:
            line: sview = DesignerSession::source_view_line(arg0)
            result: i64 = set_text(line)
            return 2 if result == 1 and DesignerSession::source_view_line_truncated()
            return result
        if opcode == 130:
            if DesignerSession::source_view_dirty():
