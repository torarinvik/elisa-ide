            return 0
        if opcode == 133:
            if DesignerSession::source_view_replace_range(arg0, arg1, DesignText::view_of(host_text.buf)):
                return 1
            return 0
        if opcode == 150:
            payload: sview = DesignText::view_of(host_text.buf)
            return -1 if arg0 < 0 or arg0 > payload.len or arg1 != 0
            query: sview = string_view_slice(payload, 0, arg0)
            replacement: sview = string_view_slice(payload, arg0, payload.len)
            return DesignerSession::source_view_replace_all(query, replacement)
        if opcode == 134:
            if DesignerSession::source_view_undo():
                return 1
            return 0
        if opcode == 135:
            if DesignerSession::source_view_redo():
                return 1
            return 0
        if opcode == 136:
            if DesignerSession::source_view_can_undo():
                return 1
            return 0
        if opcode == 137:
            if DesignerSession::source_view_can_redo():
                return 1
            return 0
        if opcode == 138:
            if DesignerSession::source_view_check_external_change():
