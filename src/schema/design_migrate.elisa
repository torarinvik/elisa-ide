# Schema-version checks and logical migration defaults.
#
# The latest Json API deliberately exposes parsed documents as opaque,
# region-indexed handles. Legacy spellings are therefore normalized while the
# model is decoded instead of rebuilding a second JSON DOM. The normalized
# model receives the current schema version, and old field aliases are treated
# as known fields so they do not leak into extension data.

include "../model/design_limits.elisa"
include "../validation/design_diagnostics.elisa"

include "../../compiler/elisacore_std/elisacore_runtime.elisa"
include "../../compiler/elisacore_std/elisacore_json.elisa"

module DesignMigrate:
    public:
        def version_of[@r](value: JsonValueHandle[r]) -> i64:
            member: JsonValueHandle[r] = catch json_handle_get(value, "schemaVersion"):
                value:
                    value
                error e:
                    json_handle_null(value)
            return 0 if not json_handle_is_number(member)
            number: f64 = catch json_handle_as_number(member):
                value:
                    value
                error e:
                    0.0
            return number.i64()

        # Returns the version to persist in the decoded model, or -1 after
        # reporting that this reader cannot load the document.
        def migrate_form[@r](root: JsonValueHandle[r], sink: mutable DesignDiagnostics::Sink&) -> i64:
            version: i64 = version_of(root)
            if version > DesignLimits::SCHEMA_VERSION:
                _ = DesignDiagnostics::report_error(sink, DesignDiagnostics::Code.UnsupportedSchemaVersion, "schemaVersion", "document was written by a newer schema version")
                return -1
            if version < DesignLimits::OLDEST_READABLE_VERSION:
                _ = DesignDiagnostics::report_error(sink, DesignDiagnostics::Code.UnsupportedSchemaVersion, "schemaVersion", "document schema is older than this build can read")
                return -1
            if version == 0:
                _ = DesignDiagnostics::report_warning(sink, DesignDiagnostics::Code.MigrationApplied, "", "migrated form schema 0 -> 1: title renamed to name")
                return DesignLimits::SCHEMA_VERSION
            return version

        def migrate_project[@r](root: JsonValueHandle[r], sink: mutable DesignDiagnostics::Sink&) -> i64:
            version: i64 = version_of(root)
            if version > DesignLimits::SCHEMA_VERSION:
                _ = DesignDiagnostics::report_error(sink, DesignDiagnostics::Code.UnsupportedSchemaVersion, "schemaVersion", "document was written by a newer schema version")
                return -1
            if version < DesignLimits::OLDEST_READABLE_VERSION:
                _ = DesignDiagnostics::report_error(sink, DesignDiagnostics::Code.UnsupportedSchemaVersion, "schemaVersion", "document was written by a schema older than this build can read")
                return -1
            if version == 0:
                _ = DesignDiagnostics::report_warning(sink, DesignDiagnostics::Code.MigrationApplied, "", "migrated project schema 0 -> 1: appId renamed to applicationId")
                return DesignLimits::SCHEMA_VERSION
            return version
