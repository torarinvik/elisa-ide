# Project and form document encoding.
#
# Output is canonical: compact JSON, fixed member order (never map iteration
# order), locale-independent number formatting, and no timestamps or random
# values. Encoding the same document twice is byte-identical, which the
# round-trip fixtures assert. A single trailing newline makes the file
# text-friendly without affecting stability.

include "../model/design_limits.elisa"
include "../model/design_text.elisa"
include "../model/design_ids.elisa"
include "../model/design_values.elisa"
include "../model/design_node.elisa"
include "../model/design_form.elisa"
include "../model/design_project.elisa"
include "../model/design_store.elisa"

include "../../compiler/elisacore_std/elisacore_runtime.elisa"
include "../../compiler/elisacore_std/collections.elisa"
include "../../compiler/elisacore_std/elisacore_json.elisa"

module DesignEncode:
    private:
        def empty_arena() -> Arena:
            return Arena{begin: null, end: null, end_index: 0, strategy: 0}

        # JSON strings and numbers go through the standard library's checked,
        # opaque-handle writer. The document itself is streamed directly into
        # the output buffer, so the encoder never needs to expose Json's raw DOM.
        def append_handle_json[@j, @r](arena: mutable Arena& @r, buffer: mutable darray[u8]&, value: JsonValueHandle[j]) -> void:
            in arena:
                encoded: darray[u8] = json_handle_write(arena, value)
                DesignText::push_view(buffer, DesignText::view_of(encoded))

        def append_json_string[@r](arena: mutable Arena& @r, buffer: mutable darray[u8]&, text: sview) -> void:
            in arena:
                value: JsonValueHandle[r] = json_handle_string(arena, text)
                append_handle_json(arena, buffer, value)

        def append_json_number[@r](arena: mutable Arena& @r, buffer: mutable darray[u8]&, number: f64) -> void:
            in arena:
                value: JsonValueHandle[r] = json_handle_number(arena, number)
                append_handle_json(arena, buffer, value)

        def append_json_bool[@r](arena: mutable Arena& @r, buffer: mutable darray[u8]&, flag: bool) -> void:
            in arena:
                value: JsonValueHandle[r] = json_handle_bool(arena, flag)
                append_handle_json(arena, buffer, value)

        def object_key[@r](arena: mutable Arena& @r, buffer: mutable darray[u8]&, first: mutable bool&, key: sview) -> void:
            in arena:
                if first == false:
                    buffer.push(44)
                first <- false
                append_json_string(arena, buffer, key)
                buffer.push(58)

        def array_item_prefix(buffer: mutable darray[u8]&, first: mutable bool&) -> void:
            if first == false:
                buffer.push(44)
            first <- false

        def push_hex(buffer: mutable darray[u8]&, value: u8) -> void:
            high: u8 = value / 16
            low: u8 = value % 16
            buffer.push(hex_byte(high))
            buffer.push(hex_byte(low))

        def hex_byte(nibble: u8) -> u8:
            return 48 + nibble if nibble < 10 else 97 + (nibble - 10)

        def append_color(buffer: mutable darray[u8]&, value: DesignValues::ColorValue) -> void:
            buffer.push(34)
            buffer.push(35)
            push_hex(buffer, value.r)
            push_hex(buffer, value.g)
            push_hex(buffer, value.b)
            push_hex(buffer, value.a)
            buffer.push(34)

        def append_design_value[@a, @p](arena: mutable Arena& @a, buffer: mutable darray[u8]&, pool: DesignValues::StringPool& @p, value: DesignValues::DesignValue&) -> void:
            in arena:
                match value.tag:
                    DesignValues::ValueTag.Bool:
                        append_json_bool(arena, buffer, value.bool_value)
                    DesignValues::ValueTag.Integer:
                        append_json_number(arena, buffer, value.int_value.f64())
                    DesignValues::ValueTag.Scalar:
                        append_json_number(arena, buffer, value.scalar_value)
                    DesignValues::ValueTag.Length:
                        append_json_number(arena, buffer, value.scalar_value)
                    DesignValues::ValueTag.Text:
                        append_json_string(arena, buffer, DesignValues::text_of(pool, value.text_ref))
                    DesignValues::ValueTag.EnumKey:
                        append_json_string(arena, buffer, DesignValues::text_of(pool, value.text_ref))
                    DesignValues::ValueTag.Color:
                        append_color(buffer, value.color_value)
                    DesignValues::ValueTag.NodeRef:
                        append_json_string(arena, buffer, DesignValues::text_of(pool, value.text_ref))
                    DesignValues::ValueTag.Unsupported:
                        raw: sview @p = DesignValues::text_of(pool, value.text_ref)
                        parsed: JsonParseResult[a] = json_parse_checked(arena, raw)
                        raw_handle: JsonValueHandle[a] = json_handle_from_result(parsed)
                        if parsed.code == JsonErrorCode.OK:
                            append_handle_json(arena, buffer, raw_handle)
                        else:
                            append_json_string(arena, buffer, raw)
                return

        def append_raw_members[@source](buffer: mutable darray[u8]&, first: mutable bool&, raw: darray[u8]& @source) -> void:
            # Decoding only stores validated JSON here. Keep the defensive parse
            # check so a damaged extension blob cannot corrupt the file. The
            # scratch arena is local to this helper so parsed strings can borrow
            # the caller-owned raw bytes only while they are being re-encoded.
            return if raw.count == 0
            scratch_arena: mutable Arena = empty_arena()
            in scratch_arena:
                parsed: JsonParseResult[scratch_arena] = json_parse_checked(scratch_arena, DesignText::view_of_ref(raw))
                return if parsed.code != JsonErrorCode.OK
                root: JsonValueHandle[scratch_arena] = json_handle_from_result(parsed)
                return if not json_handle_is_object(root)
                count: i64 = json_handle_object_len(root)
                index: mutable i64 = 0
                while index < count:
                    key: sview @scratch_arena = catch json_handle_key_at(root, index):
                        value:
                            value
                        error e:
                            ""
                    item: JsonValueHandle[scratch_arena] = catch json_handle_value_at(root, index):
                        value:
                            value
                        error e:
                            json_handle_null(root)
                    object_key(scratch_arena, buffer, first, key)
                    append_handle_json(scratch_arena, buffer, item)
                    index <- index + 1
                return

        def emit_node[@a, @form](arena: mutable Arena& @a, buffer: mutable darray[u8]&, form: DesignForms::Form& @form, node: DesignNodes::Node& @form) -> void:
            in arena:
                first: mutable bool = true
                id_text_storage: mutable u8[24] = zeroed
                buffer.push(123)
                object_key(arena, buffer, &first, "id")
                append_json_string(arena, buffer, DesignIds::text(&node.id, &id_text_storage))
                object_key(arena, buffer, &first, "type")
                append_json_string(arena, buffer, DesignValues::text_of(form.strings, node.type_key))
                object_key(arena, buffer, &first, "name")
                append_json_string(arena, buffer, DesignValues::text_of(form.strings, node.name))
                object_key(arena, buffer, &first, "symbol")
                append_json_string(arena, buffer, DesignValues::text_of(form.strings, node.symbol))

                object_key(arena, buffer, &first, "properties")
                buffer.push(123)
                property_first: mutable bool = true
                index: mutable i64 = 0
                while index < node.properties.count.i64():
                    property: DesignNodes::Property = node.properties[index.usize()]
                    object_key(arena, buffer, &property_first, DesignValues::text_of(form.strings, property.key))
                    append_design_value(arena, buffer, form.strings, property.value)
                    index <- index + 1
                buffer.push(125)

                object_key(arena, buffer, &first, "children")
                buffer.push(91)
                array_first: mutable bool = true
                index <- 0
                while index < node.children.count.i64():
                    array_item_prefix(buffer, &array_first)
                    append_json_string(arena, buffer, DesignIds::text(&node.children[index.usize()], &id_text_storage))
                    index <- index + 1
                buffer.push(93)

                object_key(arena, buffer, &first, "events")
                buffer.push(123)
                event_first: mutable bool = true
                index <- 0
                while index < node.events.count.i64():
                    connection: DesignNodes::EventConnection = node.events[index.usize()]
                    object_key(arena, buffer, &event_first, DesignValues::text_of(form.strings, connection.event_key))
                    buffer.push(123)
                    handler_first: mutable bool = true
                    object_key(arena, buffer, &handler_first, "handler")
                    append_json_string(arena, buffer, DesignValues::text_of(form.strings, connection.handler))
                    buffer.push(125)
                    index <- index + 1
                buffer.push(125)

                if node.runtime_hidden:
                    object_key(arena, buffer, &first, "runtimeHidden")
                    append_json_bool(arena, buffer, true)
                if node.editor_locked:
                    object_key(arena, buffer, &first, "editorLocked")
                    append_json_bool(arena, buffer, true)
                if node.editor_hidden:
                    object_key(arena, buffer, &first, "editorHidden")
                    append_json_bool(arena, buffer, true)

                append_raw_members(buffer, &first, &node.extension_json)
                buffer.push(125)

        def emit_form[@a, @form](arena: mutable Arena& @a, buffer: mutable darray[u8]&, form: DesignForms::Form& @form) -> void:
            in arena:
                first: mutable bool = true
                id_text_storage: mutable u8[24] = zeroed
                buffer.push(123)
                object_key(arena, buffer, &first, "format")
                append_json_string(arena, buffer, "elisa-ide-form")
                object_key(arena, buffer, &first, "schemaVersion")
                append_json_number(arena, buffer, form.schema_version.f64())
                object_key(arena, buffer, &first, "id")
                append_json_string(arena, buffer, DesignIds::text(&form.id, &id_text_storage))
                object_key(arena, buffer, &first, "name")
                append_json_string(arena, buffer, DesignValues::text_of(form.strings, form.name))
                object_key(arena, buffer, &first, "moduleSymbol")
                append_json_string(arena, buffer, DesignValues::text_of(form.strings, form.module_symbol))

                object_key(arena, buffer, &first, "viewport")
                buffer.push(123)
                viewport_first: mutable bool = true
                object_key(arena, buffer, &viewport_first, "width")
                append_json_number(arena, buffer, form.viewport_width)
                object_key(arena, buffer, &viewport_first, "height")
                append_json_number(arena, buffer, form.viewport_height)
                buffer.push(125)

                object_key(arena, buffer, &first, "root")
                append_json_string(arena, buffer, DesignIds::text(&form.root, &id_text_storage))
                object_key(arena, buffer, &first, "nodes")
                buffer.push(91)
                nodes_first: mutable bool = true
                index: mutable i64 = 0
                while index < form.nodes.count.i64():
                    array_item_prefix(buffer, &nodes_first)
                    emit_node(arena, buffer, form, &form.nodes[index.usize()])
                    index <- index + 1
                buffer.push(93)

                append_raw_members(buffer, &first, &form.extensions)
                buffer.push(125)

        def emit_project[@a, @project](arena: mutable Arena& @a, buffer: mutable darray[u8]&, project: DesignProjects::Project& @project) -> void:
            in arena:
                first: mutable bool = true
                id_text_storage: mutable u8[24] = zeroed
                buffer.push(123)
                object_key(arena, buffer, &first, "format")
                append_json_string(arena, buffer, "elisa-ide-project")
                object_key(arena, buffer, &first, "schemaVersion")
                append_json_number(arena, buffer, project.schema_version.f64())
                object_key(arena, buffer, &first, "projectId")
                append_json_string(arena, buffer, DesignIds::text(&project.id, &id_text_storage))
                object_key(arena, buffer, &first, "name")
                append_json_string(arena, buffer, DesignValues::text_of(project.strings, project.name))
                object_key(arena, buffer, &first, "applicationId")
                append_json_string(arena, buffer, DesignValues::text_of(project.strings, project.application_id))

                object_key(arena, buffer, &first, "framework")
                buffer.push(123)
                framework_first: mutable bool = true
                object_key(arena, buffer, &framework_first, "dependency")
                append_json_string(arena, buffer, "elisa-ui")
                buffer.push(125)

                object_key(arena, buffer, &first, "forms")
                buffer.push(91)
                forms_first: mutable bool = true
                index: mutable i64 = 0
                while index < project.forms.count.i64():
                    array_item_prefix(buffer, &forms_first)
                    buffer.push(123)
                    entry_first: mutable bool = true
                    object_key(arena, buffer, &entry_first, "id")
                    append_json_string(arena, buffer, DesignIds::text(&project.forms[index.usize()].id, &id_text_storage))
                    object_key(arena, buffer, &entry_first, "path")
                    append_json_string(arena, buffer, DesignValues::text_of(project.strings, project.forms[index.usize()].path))
                    buffer.push(125)
                    index <- index + 1
                buffer.push(93)
                object_key(arena, buffer, &first, "entryForm")
                append_json_string(arena, buffer, DesignIds::text(&project.entry_form, &id_text_storage))

                object_key(arena, buffer, &first, "source")
                buffer.push(123)
                source_first: mutable bool = true
                object_key(arena, buffer, &source_first, "roots")
                buffer.push(91)
                roots_first: mutable bool = true
                index <- 0
                while index < project.source_roots.count.i64():
                    array_item_prefix(buffer, &roots_first)
                    append_json_string(arena, buffer, DesignValues::text_of(project.strings, project.source_roots[index.usize()]))
                    index <- index + 1
                buffer.push(93)
                buffer.push(125)

                object_key(arena, buffer, &first, "generation")
                buffer.push(123)
                generation_first: mutable bool = true
                object_key(arena, buffer, &generation_first, "namespace")
                append_json_string(arena, buffer, DesignValues::text_of(project.strings, project.generation_namespace))
                object_key(arena, buffer, &generation_first, "outputRoot")
                append_json_string(arena, buffer, DesignValues::text_of(project.strings, project.generation_output_root))
                buffer.push(125)

                object_key(arena, buffer, &first, "targets")
                buffer.push(91)
                targets_first: mutable bool = true
                index <- 0
                while index < project.targets.count.i64():
                    array_item_prefix(buffer, &targets_first)
                    buffer.push(123)
                    target_first: mutable bool = true
                    object_key(arena, buffer, &target_first, "id")
                    append_json_string(arena, buffer, DesignIds::text(&project.targets[index.usize()].id, &id_text_storage))
                    object_key(arena, buffer, &target_first, "backend")
                    append_json_string(arena, buffer, DesignValues::text_of(project.strings, project.targets[index.usize()].backend))
                    object_key(arena, buffer, &target_first, "renderer")
                    append_json_string(arena, buffer, DesignValues::text_of(project.strings, project.targets[index.usize()].renderer))
                    buffer.push(125)
                    index <- index + 1
                buffer.push(93)

                append_raw_members(buffer, &first, &project.extensions)
                buffer.push(125)

        private:
            # The output buffer must outlive the encoder's local arena because
            # callers keep encoded bytes across frames.
        def durable(bytes: darray[u8]) -> darray[u8]:
            result: mutable darray[u8] = []
            DesignStore::ensure_bytes(&result, bytes.count + 1)
            index: mutable i64 = 0
            while index < bytes.count.i64():
                result.push(bytes[index.usize()])
                index <- index + 1
            return result

    public:
        def encode_form[@form](form: DesignForms::Form& @form) -> darray[u8]:
            arena: mutable Arena = empty_arena()
            output: mutable darray[u8] = []
            emit_form(&arena, &output, form)
            output.push(10)
            return durable(output)

        def encode_project[@project](project: DesignProjects::Project& @project) -> darray[u8]:
            arena: mutable Arena = empty_arena()
            output: mutable darray[u8] = []
            emit_project(&arena, &output, project)
            output.push(10)
            return durable(output)
