# Headless CLI: validate and migrate project/form documents without a GUI.
#
# Shares the same parser, model, validation, and migration code as the editor.
# Exit codes: 0 success, 1 validation errors, 2 usage or I/O failure.
#
# Usage:
#   elisa-ide-cli validate <project-or-form.json>
#   elisa-ide-cli migrate  <input.json> <output.json>
#   elisa-ide-cli generate <form.json> <output.elisa>
#   elisa-ide-cli source   <output.elisa> <output.map.json> <byte-offset>

include "../registry/design_registry.elisa"
include "../schema/design_json_decode.elisa"
include "../schema/design_json_encode.elisa"
include "../validation/design_validate.elisa"
include "../lowering/design_lower.elisa"
include "../codegen/elisa_emit.elisa"
include "../codegen/source_map_json.elisa"
include "../platform/posix/posix_file.elisa"

include "../../compiler/elisacore_std/elisacore_runtime.elisa"
include "../../compiler/elisacore_std/collections.elisa"
include "../../compiler/elisacore_std/elisacore_fileio.elisa"

module ElisaIdeCli:
    private:
        def usage() -> i64:
            print("usage: elisa-ide-cli validate <document.json>\n")
            print("       elisa-ide-cli migrate  <input.json> <output.json>\n")
            print("       elisa-ide-cli generate <form.json> <output.elisa> [output.map.json]\n")
            print("       elisa-ide-cli source   <output.elisa> <output.map.json> <byte-offset>\n")
            return 2

        def is_project_path(path: sview) -> bool:
            return DesignText::has_text(path, ".elisaproject.json")

        def print_sink(sink: DesignDiagnostics::Sink&) -> void:
            index: mutable i64 = 0
            while index < sink.items.count.i64():
                diagnostic: DesignDiagnostics::Diagnostic = sink.items[index.usize()]
                if diagnostic.severity == DesignDiagnostics::Severity.Error:
                    print("error: ")
                else:
                    print("warning: ")
                print(DesignDiagnostics::code_name(diagnostic.code))
                if diagnostic.path.count > 0:
                    print(" at ")
                    print(DesignText::view_of(diagnostic.path))
                print(": ")
                print(DesignText::view_of(diagnostic.message))
                print("\n")
                index <- index + 1

        def read_document(path: cstr, arena: mutable Arena&) -> darray[u8]:
            bytes: darray[u8] = catch read_entire_file(arena, path):
                value:
                    value
                error e:
                    []
            return bytes

        def print_i64(value: i64) -> void:
            text: mutable darray[u8] = []
            DesignText::push_i64(&text, value)
            print(DesignText::view_of(text))

        def parse_offset(text: cstr, valid: mutable bool&) -> i64:
            valid <- false
            value: mutable i64 = 0
            index: mutable i64 = 0
            while index < 32:
                byte: u8 = text[index.usize()]
                break if byte == 0
                return 0 if byte < 48 or byte > 57
                value <- value * 10 + (byte - 48).i64()
                return 0 if value < 0
                index <- index + 1
            return 0 if index == 0
            valid <- true
            return value

        def print_source_origin(path: cstr, source: darray[u8]&, map: CodegenSourceMap::SourceMap, span_index: i64) -> void:
            start: i64 = CodegenSourceMap::start_byte_at(map, span_index)
            finish: i64 = CodegenSourceMap::end_byte_at(map, span_index)
            line: mutable i64 = 1
            column: mutable i64 = 1
            cursor: mutable i64 = 0
            while cursor < start:
                if source[cursor.usize()] == 10:
                    line <- line + 1
                    column <- 1
                else:
                    column <- column + 1
                cursor <- cursor + 1
            output: mutable darray[u8] = []
            DesignText::push_view(&output, "source: ")
            DesignText::push_cstr(&output, path)
            DesignText::push_view(&output, ":")
            DesignText::push_i64(&output, line)
            DesignText::push_view(&output, ":")
            DesignText::push_i64(&output, column)
            DesignText::push_view(&output, " bytes=")
            DesignText::push_i64(&output, start)
            DesignText::push_view(&output, "-")
            DesignText::push_i64(&output, finish)
            DesignText::push_view(&output, " origin=")
            DesignText::push_view(&output, CodegenSourceMap::kind_name(CodegenSourceMap::kind_at(map, span_index)))
            DesignText::push_view(&output, " form=")
            DesignText::push_view(&output, CodegenSourceMap::form_id_at(map, span_index))
            DesignText::push_view(&output, " node=")
            DesignText::push_view(&output, CodegenSourceMap::node_id_at(map, span_index))
            DesignText::push_view(&output, " member=")
            DesignText::push_view(&output, CodegenSourceMap::member_at(map, span_index))
            print(DesignText::view_of(output))

        def navigate_source(source_path: cstr, map_path: cstr, offset_text: cstr) -> i64:
            source_arena: mutable Arena = Arena{begin: null, end: null, end_index: 0, strategy: 0}
            map_arena: mutable Arena = Arena{begin: null, end: null, end_index: 0, strategy: 0}
            source: darray[u8] = read_document(source_path, &source_arena)
            map_bytes: darray[u8] = read_document(map_path, &map_arena)
            if source.count == 0 or map_bytes.count == 0:
                print("error: cannot read generated source or source map\n")
                return 2
            offset_valid: mutable bool = false
            offset: i64 = parse_offset(offset_text, &offset_valid)
            if not offset_valid:
                print("error: byte offset must be a non-negative integer\n")
                return 2
            decoded: CodegenSourceMapJson::DecodeResult = CodegenSourceMapJson::decode(DesignText::view_of(map_bytes), DesignText::view_of(source))
            if not decoded.ok:
                print("error: source map is stale or invalid\n")
                return 1
            lookup: CodegenSourceMap::Lookup = CodegenSourceMap::lookup(decoded.map, DesignText::view_of(source), offset)
            if not lookup.ok:
                print("error: source-map lookup rejected the byte offset\n")
                return 1
            if not lookup.found:
                print("source: no design origin at byte ")
                print_i64(offset)
                print("\n")
                return 0
            print_source_origin(source_path, source, decoded.map, lookup.span_index)
            return 0

        def validate_document(path: cstr) -> i64:
            arena: mutable Arena = Arena{begin: null, end: null, end_index: 0, strategy: 0}
            bytes: darray[u8] = read_document(path, &arena)
            if bytes.count == 0:
                print("error: cannot read ")
                print(path)
                print("\n")
                return 2
            registry: DesignRegistry::Registry = DesignRegistry::build_builtin()
            sink: mutable DesignDiagnostics::Sink = DesignDiagnostics::empty_sink()
            if is_project_path(sview(path, 0, -1)):
                project: DesignProjects::Project = DesignDecode::decode_project(DesignText::view_of(bytes), &sink)
                DesignValidate::validate_project(project, &sink)
            else:
                form: DesignForms::Form = DesignDecode::decode_form(DesignText::view_of(bytes), registry, &sink)
                DesignValidate::validate_form(form, registry, &sink)
            print_sink(&sink)
            if DesignDiagnostics::has_errors(sink):
                return 1
            print("ok: ")
            print(path)
            print("\n")
            return 0

        def migrate_document(input_path: cstr, output_path: cstr) -> i64:
            arena: mutable Arena = Arena{begin: null, end: null, end_index: 0, strategy: 0}
            bytes: darray[u8] = read_document(input_path, &arena)
            if bytes.count == 0:
                print("error: cannot read ")
                print(input_path)
                print("\n")
                return 2
            registry: DesignRegistry::Registry = DesignRegistry::build_builtin()
            sink: mutable DesignDiagnostics::Sink = DesignDiagnostics::empty_sink()
            output: mutable darray[u8] = []
            if is_project_path(sview(input_path, 0, -1)):
                project: DesignProjects::Project = DesignDecode::decode_project(DesignText::view_of(bytes), &sink)
                if DesignDiagnostics::has_errors(sink):
                    print_sink(&sink)
                    return 1
                output <- DesignEncode::encode_project(project)
            else:
                form: DesignForms::Form = DesignDecode::decode_form(DesignText::view_of(bytes), registry, &sink)
                if DesignDiagnostics::has_errors(sink):
                    print_sink(&sink)
                    return 1
                output <- DesignEncode::encode_form(form)
            written: i64 = catch write_entire_file(output_path, DesignText::view_of(output)):
                value:
                    value
                error e:
                    -1
            if written < 0:
                print("error: cannot write ")
                print(output_path)
                print("\n")
                return 2
            print_sink(&sink)
            print("migrated: ")
            print(input_path)
            print(" -> ")
            print(output_path)
            print("\n")
            return 0

        def generate_view(input_path: cstr, output_path: cstr, source_map_path: cstr) -> i64:
            arena: mutable Arena = Arena{begin: null, end: null, end_index: 0, strategy: 0}
            bytes: darray[u8] = read_document(input_path, &arena)
            if bytes.count == 0:
                print("error: cannot read ")
                print(input_path)
                print("\n")
                return 2

            registry: DesignRegistry::Registry = DesignRegistry::build_builtin()
            sink: mutable DesignDiagnostics::Sink = DesignDiagnostics::empty_sink()
            form: mutable DesignForms::Form = DesignDecode::decode_form(DesignText::view_of(bytes), registry, &sink)
            if DesignDiagnostics::has_errors(sink):
                print_sink(&sink)
                return 1

            # lower_form performs the canonical form validation before it
            # constructs target-specific operations.
            lowered: DesignLower::LoweredForm = DesignLower::lower_form(form, registry, &sink)
            if not lowered.valid or DesignDiagnostics::has_errors(sink):
                print_sink(&sink)
                return 1

            emission: ElisaEmit::Emission = ElisaEmit::emit_view(form, registry, lowered, &sink)
            if not emission.valid or DesignDiagnostics::has_errors(sink):
                print_sink(&sink)
                return 1

            existing: mutable darray[u8] = []
            output_status: i64 = PosixFile::read_bytes_result(&existing, output_path, DesignLimits::MAX_INPUT_BYTES)
            if output_status >= 0:
                print("error: output already exists; refusing to replace ")
                print(output_path)
                print("\n")
                return 2
            if not PosixFile::read_error_is_not_found(output_status):
                print("error: output path is not available ")
                print(output_path)
                print("\n")
                return 2

            map_enabled: bool = sview(source_map_path, 0, -1).len > 0
            map_bytes: mutable darray[u8] = []
            if map_enabled:
                existing_map: mutable darray[u8] = []
                map_status: i64 = PosixFile::read_bytes_result(&existing_map, source_map_path, DesignLimits::MAX_INPUT_BYTES)
                if map_status >= 0:
                    print("error: source-map output already exists; refusing to replace ")
                    print(source_map_path)
                    print("\n")
                    return 2
                if not PosixFile::read_error_is_not_found(map_status):
                    print("error: source-map output path is not available ")
                    print(source_map_path)
                    print("\n")
                    return 2
                map_bytes <- CodegenSourceMapJson::encode(emission.source_map, DesignText::view_of(emission.source))
                if map_bytes.count == 0:
                    _ = DesignDiagnostics::report_error(sink, DesignDiagnostics::Code.InvalidReference, "generation.source-map", "could not encode the generated source map")
                    print_sink(&sink)
                    return 1

            # This command publishes exactly one generated view file. The
            # POSIX service stages and syncs the complete source before
            # publishing it, and its link-based publication refuses to
            # replace a destination even if another process creates it after
            # generation begins.
            publish_source: i64 error[FileReplaceError] = PosixFile::atomic_write_new(output_path, DesignText::view_of(emission.source))
            written: mutable i64 = catch publish_source:
                value:
                    value
                FileReplaceError.DestinationExists:
                    -2
                FileReplaceError.CommittedButNotDurable:
                    -3
                error e:
                    -1
            if written == -2:
                print("error: output already exists; refusing to replace ")
                print(output_path)
                print("\n")
                return 2
            if written == -3:
                print("warning: generated output is visible, but directory durability could not be confirmed: ")
                print(output_path)
                print("\n")
                written <- emission.source.count.i64()
            if written < 0:
                print("error: could not publish generated source to ")
                print(output_path)
                print("\n")
                return 2

            if map_enabled:
                publish_map: i64 error[FileReplaceError] = PosixFile::atomic_write_new(source_map_path, DesignText::view_of(map_bytes))
                map_written: mutable i64 = catch publish_map:
                    value:
                        value
                    FileReplaceError.DestinationExists:
                        -2
                    FileReplaceError.CommittedButNotDurable:
                        -3
                    error e:
                        -1
                if map_written < 0 and map_written != -3:
                    print("error: generated source was published but source-map publication failed at ")
                    print(source_map_path)
                    print("\n")
                    return 2
                if map_written == -3:
                    print("warning: source-map output is visible, but directory durability could not be confirmed: ")
                    print(source_map_path)
                    print("\n")

            print_sink(&sink)
            print("generated: ")
            print(input_path)
            print(" -> ")
            print(output_path)
            if map_enabled:
                print(" and ")
                print(source_map_path)
            print("\n")
            return 0

    public:
        def run(argc: i64, argv: mutable void&) -> i64 can[Unsafe.PointerCast]:
            if argc < 3:
                return usage()
            slots: mutable cstr&& = argv.cast[mutable cstr&&]
            command: cstr = slots[1.usize()].cast[cstr]
            if DesignText::equal(sview(command, 0, -1), "validate"):
                return validate_document(slots[2.usize()].cast[cstr])
            if DesignText::equal(sview(command, 0, -1), "migrate"):
                if argc < 4:
                    return usage()
                return migrate_document(slots[2.usize()].cast[cstr], slots[3.usize()].cast[cstr])
            if DesignText::equal(sview(command, 0, -1), "generate"):
                if argc != 4 and argc != 5:
                    return usage()
                if argc == 5:
                    return generate_view(slots[2.usize()].cast[cstr], slots[3.usize()].cast[cstr], slots[4.usize()].cast[cstr])
                return generate_view(slots[2.usize()].cast[cstr], slots[3.usize()].cast[cstr], "")
            if DesignText::equal(sview(command, 0, -1), "source"):
                if argc != 5:
                    return usage()
                return navigate_source(slots[2.usize()].cast[cstr], slots[3.usize()].cast[cstr], slots[4.usize()].cast[cstr])
            return usage()

def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return ElisaIdeCli::run(argc, argv)
