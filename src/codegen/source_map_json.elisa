# Deterministic, versioned JSON persistence for generated-source maps.
#
# Ranges are UTF-8 byte offsets (half-open). The persisted hash binds every
# range to one exact generated byte sequence; decoding requires those bytes and
# fails closed when the artifact has changed.

include "source_map.elisa"
include "../model/design_text.elisa"

include "../../compiler/elisacore_std/elisacore_runtime.elisa"
include "../../compiler/elisacore_std/collections.elisa"
include "../../compiler/elisacore_std/elisacore_json.elisa"

module CodegenSourceMapJson:
    private:
        const MAX_JSON_BYTES: usize = 8388608

        def empty_arena() -> Arena:
            return Arena{begin: null, end: null, end_index: 0, strategy: 0}

        def durable(bytes: darray[u8]) -> darray[u8]:
            result: mutable darray[u8] = []
            index: mutable i64 = 0
            while index < bytes.count.i64():
                result.push(bytes[index.usize()])
                index <- index + 1
            return result

        def member_key[@r](value: JsonValueHandle[r], index: i64) -> sview @r:
            return catch json_handle_key_at(value, index):
                value:
                    value
                error e:
                    ""

        def member_value[@r](value: JsonValueHandle[r], index: i64) -> JsonValueHandle[r]:
            return catch json_handle_value_at(value, index):
                value:
                    value
                error e:
                    json_handle_null(value)

        def array_value[@r](value: JsonValueHandle[r], index: i64) -> JsonValueHandle[r]:
            return catch json_handle_at(value, index):
                value:
                    value
                error e:
                    json_handle_null(value)

        def member_at[@r](value: JsonValueHandle[r], key: sview) -> JsonValueHandle[r]:
            return catch json_handle_get(value, key):
                value:
                    value
                error e:
                    json_handle_null(value)

        def string_value[@r](value: JsonValueHandle[r]) -> sview @r:
            return catch json_handle_as_string(value):
                value:
                    value
                error e:
                    ""

        def duplicate_members[@r](value: JsonValueHandle[r]) -> bool:
            return false if json_handle_kind(value) != JsonKind.OBJECT
            count: i64 = json_handle_object_len(value)
            index: mutable i64 = 0
            while index < count:
                key: sview = member_key(value, index)
                earlier: mutable i64 = 0
                while earlier < index:
                    return true if DesignText::equal(member_key(value, earlier), key)
                    earlier <- earlier + 1
                index <- index + 1
            return false

        def hex_digit(byte: u8) -> i64:
            if byte >= 48 and byte <= 57:
                return (byte - 48).i64()
            if byte >= 97 and byte <= 102:
                return (byte - 97 + 10).i64()
            if byte >= 65 and byte <= 70:
                return (byte - 65 + 10).i64()
            return -1

        def parse_hash(text: sview, valid: mutable bool&) -> u64:
            valid <- false
            return 0 if text.len != 16
            value: mutable u64 = 0
            index: mutable i64 = 0
            while index < 16:
                digit: i64 = hex_digit(text[index])
                return 0 if digit < 0
                value <- (value << 4) | digit.u64()
                index <- index + 1
            valid <- true
            return value

        def hash_text(value: u64) -> darray[u8]:
            text: mutable darray[u8] = []
            for shift in 0..<16:
                bit_shift: i64 = (15 - shift) * 4
                nibble: u64 = (value >> bit_shift) & 15
                text.push((48 + nibble.u8()) if nibble < 10 else (87 + nibble.u8()))
            return text

        def kind_text(kind: CodegenSourceMap::OriginKind) -> sview:
            match kind:
                CodegenSourceMap::OriginKind.Form:
                    return "form"
                CodegenSourceMap::OriginKind.Node:
                    return "node"
                CodegenSourceMap::OriginKind.Property:
                    return "property"
                CodegenSourceMap::OriginKind.Event:
                    return "event"
                CodegenSourceMap::OriginKind.Template:
                    return "template"
            return ""

        def parse_kind(text: sview, valid: mutable bool&) -> CodegenSourceMap::OriginKind:
            valid <- true
            if DesignText::equal(text, "form"):
                return CodegenSourceMap::OriginKind.Form
            if DesignText::equal(text, "node"):
                return CodegenSourceMap::OriginKind.Node
            if DesignText::equal(text, "property"):
                return CodegenSourceMap::OriginKind.Property
            if DesignText::equal(text, "event"):
                return CodegenSourceMap::OriginKind.Event
            if DesignText::equal(text, "template"):
                return CodegenSourceMap::OriginKind.Template
            valid <- false
            return CodegenSourceMap::OriginKind.Form

        def append_handle_json[@j, @r](arena: mutable Arena& @r, output: mutable darray[u8]&, value: JsonValueHandle[j]) -> void:
            in arena:
                encoded: darray[u8] = json_handle_write(arena, value)
                DesignText::push_view(output, DesignText::view_of(encoded))

        def append_json_string[@r](arena: mutable Arena& @r, output: mutable darray[u8]&, value: sview) -> void:
            in arena:
                handle: JsonValueHandle[r] = json_handle_string(arena, value)
                append_handle_json(arena, output, handle)

        def append_json_number[@r](arena: mutable Arena& @r, output: mutable darray[u8]&, value: f64) -> void:
            in arena:
                handle: JsonValueHandle[r] = json_handle_number(arena, value)
                append_handle_json(arena, output, handle)

        def object_key[@r](arena: mutable Arena& @r, output: mutable darray[u8]&, first: mutable bool&, key: sview) -> void:
            in arena:
                if first == false:
                    output.push(44)
                first <- false
                append_json_string(arena, output, key)
                output.push(58)

        def parse_integer[@r](value: JsonValueHandle[r], maximum: i64, parsed: mutable bool&) -> i64:
            parsed <- false
            return 0 if not json_handle_is_number(value)
            number: f64 = catch json_handle_as_number(value):
                value:
                    value
                error e:
                    -1.0
            return 0 if number < 0.0 or number > maximum.f64()
            integer: i64 = number.i64()
            return 0 if number != integer.f64()
            parsed <- true
            return integer

        def valid_shape[@r](root: JsonValueHandle[r]) -> bool:
            return false if json_handle_kind(root) != JsonKind.OBJECT or duplicate_members(root)
            return false if json_handle_object_len(root) != 5
            spans: JsonValueHandle[r] = member_at(root, "spans")
            return false if json_handle_kind(spans) != JsonKind.ARRAY
            count: i64 = json_handle_array_len(spans)
            return false if count < 0 or count > 8192
            index: mutable i64 = 0
            while index < count:
                span: JsonValueHandle[r] = array_value(spans, index)
                return false if json_handle_kind(span) != JsonKind.OBJECT or duplicate_members(span) or json_handle_object_len(span) != 6
                index <- index + 1
            return true

        def failure(issue: Issue, generated_bytes: sview) -> DecodeResult:
            return DecodeResult{ok: false, issue: issue, map: CodegenSourceMap::empty(generated_bytes)}

    public:
        const VERSION: i64 = 1

        const enum Issue of i32:
            None = 0
            InputTooLarge = 1
            MalformedJson = 2
            DuplicateKey = 3
            InvalidShape = 4
            InvalidFormat = 5
            UnsupportedVersion = 6
            InvalidMetadata = 7
            StaleGeneratedBytes = 8
            InvalidSpan = 9
            TooManySpans = 10

        struct DecodeResult:
            ok: mutable bool
            issue: mutable Issue
            map: mutable CodegenSourceMap::SourceMap

        # Encodes in a fixed member order. All offsets and lengths are UTF-8
        # byte values; the full-width hash is hex text to avoid JSON float loss.
        def encode(map: CodegenSourceMap::SourceMap&, generated_bytes: sview) -> darray[u8]:
            checked: CodegenSourceMap::Validation = CodegenSourceMap::validate(map, generated_bytes)
            return [] if not checked.ok
            arena: mutable Arena = empty_arena()
            output: mutable darray[u8] = []
            in arena:
                first: mutable bool = true
                output.push(123)
                object_key(&arena, &output, &first, "format")
                append_json_string(&arena, &output, "elisa-ide-source-map")
                object_key(&arena, &output, &first, "version")
                append_json_number(&arena, &output, VERSION.f64())
                object_key(&arena, &output, &first, "generatedLength")
                append_json_number(&arena, &output, map.generated_length.f64())
                object_key(&arena, &output, &first, "generatedHash")
                hash: darray[u8] = hash_text(map.generated_hash)
                append_json_string(&arena, &output, DesignText::view_of(hash))
                object_key(&arena, &output, &first, "spans")
                output.push(91)
                index: mutable i64 = 0
                array_first: mutable bool = true
                while index < map.spans.count.i64():
                    if not array_first:
                        output.push(44)
                    array_first <- false
                    span: CodegenSourceMap::Span = map.spans[index.usize()]
                    span_first: mutable bool = true
                    output.push(123)
                    object_key(&arena, &output, &span_first, "startByte")
                    append_json_number(&arena, &output, span.start_byte.f64())
                    object_key(&arena, &output, &span_first, "endByte")
                    append_json_number(&arena, &output, span.end_byte.f64())
                    object_key(&arena, &output, &span_first, "kind")
                    append_json_string(&arena, &output, kind_text(span.kind))
                    object_key(&arena, &output, &span_first, "formId")
                    append_json_string(&arena, &output, DesignValues::text_of(map.strings, span.form_id))
                    object_key(&arena, &output, &span_first, "nodeId")
                    append_json_string(&arena, &output, DesignValues::text_of(map.strings, span.node_id))
                    object_key(&arena, &output, &span_first, "member")
                    append_json_string(&arena, &output, DesignValues::text_of(map.strings, span.member))
                    output.push(125)
                    index <- index + 1
                output.push(93)
                output.push(125)
                output.push(10)
            return durable(output)

        # The generated artifact is mandatory input. The returned failure map
        # is always empty and bound to those bytes; no partially decoded spans
        # escape if any metadata or origin is malformed.
        def decode(text: sview, generated_bytes: sview) -> DecodeResult:
            if text.len < 0 or text.len.usize() > MAX_JSON_BYTES:
                return failure(Issue.InputTooLarge, generated_bytes)
            arena: mutable Arena = empty_arena()
            parsed: JsonParseResult[arena] = json_parse_checked(&arena, text)
            root: JsonValueHandle[arena] = json_handle_from_result(parsed)
            if parsed.code != JsonErrorCode.OK or json_handle_kind(root) != JsonKind.OBJECT:
                return failure(Issue.MalformedJson, generated_bytes)
            if duplicate_members(root):
                return failure(Issue.DuplicateKey, generated_bytes)
            if json_handle_kind(member_at(root, "spans")) == JsonKind.ARRAY:
                spans_for_duplicates: JsonValueHandle[arena] = member_at(root, "spans")
                if json_handle_array_len(spans_for_duplicates) > 8192:
                    return failure(Issue.TooManySpans, generated_bytes)
                duplicate_index: mutable i64 = 0
                while duplicate_index < json_handle_array_len(spans_for_duplicates):
                    item: JsonValueHandle[arena] = array_value(spans_for_duplicates, duplicate_index)
                    if json_handle_kind(item) == JsonKind.OBJECT and duplicate_members(item):
                        return failure(Issue.DuplicateKey, generated_bytes)
                    duplicate_index <- duplicate_index + 1
            if not valid_shape(root):
                return failure(Issue.InvalidShape, generated_bytes)
            if not DesignText::equal(string_value(member_at(root, "format")), "elisa-ide-source-map"):
                return failure(Issue.InvalidFormat, generated_bytes)

            version_parsed: mutable bool = false
            version: i64 = parse_integer(member_at(root, "version"), 2147483647, &version_parsed)
            if not version_parsed:
                return failure(Issue.InvalidMetadata, generated_bytes)
            if version != VERSION:
                return failure(Issue.UnsupportedVersion, generated_bytes)

            length_parsed: mutable bool = false
            generated_length: i64 = parse_integer(member_at(root, "generatedLength"), generated_bytes.len, &length_parsed)
            hash_valid: mutable bool = false
            generated_hash: u64 = parse_hash(string_value(member_at(root, "generatedHash")), &hash_valid)
            return failure(Issue.InvalidMetadata, generated_bytes) if not length_parsed or not hash_valid
            return failure(Issue.StaleGeneratedBytes, generated_bytes) if generated_length != generated_bytes.len or generated_hash != Fingerprint::fnv1a64(generated_bytes)

            spans: JsonValueHandle[arena] = member_at(root, "spans")
            span_count: i64 = json_handle_array_len(spans)
            result: mutable CodegenSourceMap::SourceMap = CodegenSourceMap::empty(generated_bytes)
            index: mutable i64 = 0
            while index < span_count:
                item: JsonValueHandle[arena] = array_value(spans, index)
                start_valid: mutable bool = false
                end_valid: mutable bool = false
                start_byte: i64 = parse_integer(member_at(item, "startByte"), generated_bytes.len, &start_valid)
                end_byte: i64 = parse_integer(member_at(item, "endByte"), generated_bytes.len, &end_valid)
                kind_valid: mutable bool = false
                kind: CodegenSourceMap::OriginKind = parse_kind(string_value(member_at(item, "kind")), &kind_valid)
                form_id: sview @arena = string_value(member_at(item, "formId"))
                node_id: sview @arena = string_value(member_at(item, "nodeId"))
                member: sview @arena = string_value(member_at(item, "member"))
                if not start_valid or not end_valid or not kind_valid or not CodegenSourceMap::add_span(&result, start_byte, end_byte, kind, form_id, node_id, member):
                    return failure(Issue.InvalidSpan, generated_bytes)
                index <- index + 1

            checked: CodegenSourceMap::Validation = CodegenSourceMap::validate(result, generated_bytes)
            return failure(Issue.InvalidSpan, generated_bytes) if not checked.ok
            return DecodeResult{ok: true, issue: Issue.None, map: result}
