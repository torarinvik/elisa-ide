# Session bridge for the UI compilation unit.
#
# The editor shell is a UI unit (elisa-ui framework only); the document model,
# registry, commands, and persistence are core units. They cannot share one
# compilation unit (ADR-001). This file declares the core session's public
# functions as externs bound to their `@link_name` symbols, so the shell can
# read projections and issue commands without including the core source.
#
# Only integers, booleans, and `sview`/`sview` results cross this boundary.
# An `sview` is valid only until the next session call that mutates a
# projection; the shell copies what it needs into retained widget text before
# returning to the frame loop.

include "../../framework/src/platform/sdl3/ui_sdl3_flat.elisa"

@link_name("designer_session_init")
extern session_init() -> void
@link_name("designer_session_open_project")
extern session_open_project(path: sview) -> bool
@link_name("designer_session_new_document")
extern session_new_document(project_display: sview, form_display: sview) -> bool
@link_name("designer_session_can_open")
extern session_can_open() -> bool

@link_name("designer_session_hierarchy_count")
