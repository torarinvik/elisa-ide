# Editor shell composition root.
#
# Builds the fixed panes with elisa-ui, starts the document host, routes
# toolbar/command actions to host requests, and refreshes the panels after each
# action. All shell state lives in the `Shell` record passed by reference.

include "host_client.elisa"
include "shell_state.elisa"
include "shell_lsp.elisa"
include "shell_layout.elisa"
include "shell_preview.elisa"
include "shell_panels.elisa"
include "../source/external_editor.elisa"
include "../build/build_job.elisa"
include "../../framework/src/widgets/ui_shortcuts.elisa"

@link_name("designer_workspace_preferences_load_ratios")
extern designer_workspace_preferences_load_ratios(left: mutable f64&, right: mutable f64&, bottom: mutable f64&) -> void can[Blocking.IO]
@link_name("designer_workspace_preferences_save_ratios")
extern designer_workspace_preferences_save_ratios(left: f64, right: f64, bottom: f64) -> i64 can[Blocking.IO]

const PROJECT_BUILD_SCRIPT: cstr = "scripts/build_project.sh"
const PROJECT_RUN_BINARY: cstr = "build/elisa_project_app"
const SOURCE_RUN_BINARY: cstr = "build/elisa_ide_source_app"
const COMMAND_KEY_CAPACITY: usize = 512
const BUILD_PATH_CAPACITY: usize = 1024
const SOURCE_PATH_CAPACITY: usize = 4096
const PROCESS_OUTPUT_CAPACITY: usize = 4096

const enum ShellCommand of u32:
    NewDocument = 1
    OpenDocument = 2
    SaveDocument = 3
    SaveAs = 4
    Undo = 5
    Redo = 6
    DeleteSelection = 7
    DuplicateSelection = 8
    NewProject = 9
    MoveSelectionBackward = 10
    MoveSelectionForward = 11
    InsertSelection = 17
    IndentSelection = 15
    OutdentSelection = 16
    BuildProject = 12
    RunProject = 13
    StopProject = 14
    CopySelection = 18
    CutSelection = 19
    PasteSelection = 20
    WrapRow = 21
    WrapColumn = 22
    UnwrapSelection = 23
    ConvertOrientation = 24
    SelectAncestor = 25

global mutable host_process: mutable PosixProcess::Process = PosixProcess::Process{handle: null}
global mutable host_path_storage: mutable u8[BUILD_PATH_CAPACITY] = zeroed
global mutable build_process: mutable PosixProcess::Process = PosixProcess::Process{handle: null}
global mutable run_process: mutable PosixProcess::Process = PosixProcess::Process{handle: null}
global mutable build_job: BuildJob::Job = zeroed
global mutable build_revision: u64 = 0
global mutable build_run_after: bool = false
global mutable run_active: bool = false
global mutable shell_command_key_latched: bool[512] = zeroed

def toolbar_button(shell: mutable Shell&, parent: UiHandles::Handle, label: sview, width: f32) -> UiHandles::Handle:
    button: UiHandles::Handle = UiHandles::button(parent, width, 24.0, shell_color(48, 54, 68) if shell.dark else shell_color(218, 223, 234), panel_hover_color(shell.dark), panel_press_color(shell.dark))
    UiHandles::set_text(button, label, 12.0, shell_color(238, 242, 252))
    UiHandles::set_grow(button, 0.0)
    return button

def start_host(shell: mutable Shell&) -> void:
    if shell.host_running:
        return
    if host_path_storage[0] == 0 and shell_preview_helper_path("document_host", &host_path_storage[0], BUILD_PATH_CAPACITY) != 0:
        set_status_view(shell, "Document host is missing from this app bundle")
        return
    host_executable: mutable cstr = ""
    can Unsafe.PointerCast:
        host_executable <- (&host_path_storage[0]).cast[cstr] can Unsafe.PointerCast
    host_process <- HostClient::start(host_executable)
    shell.host_running <- PosixProcess::valid(host_process)
    if shell.host_running:
        _ = HostClient::request(host_process, 10, 0, 0)
    else:
        set_status_view(shell, "Document host failed to start; check the helper and temporary-directory permissions")

def source_path_for_external_action(process: mutable PosixProcess::Process&) -> darray[u8]:
    path_reply: HostClient::HostReply = HostClient::request(process, 114, 0, 0)
    return [] if path_reply.result != 1 or path_reply.text.count == 0 or path_reply.text.count > 4096
    path_buffer: mutable darray[u8] = []
    path_index: mutable i64 = 0
    while path_index < path_reply.text.count.i64():
        byte: u8 = path_reply.text[path_index.usize()]
        return [] if byte == 0 or byte < 32 or byte == 127
        path_buffer.push(byte)
        path_index <- path_index + 1
    path_buffer.push(0)
    return path_buffer

def copy_selected_problem(shell: mutable Shell&) -> void:
    if shell.problem_copy_length <= 0:
        set_status_view(shell, "Select a diagnostic before copying")
        return
    copied: bool = ui_clipboard_write(&shell.problem_copy_bytes[0], shell.problem_copy_length.usize())
    if copied:
        if shell.problem_copy_truncated:
            set_status_view(shell, "Copied the selected diagnostic, truncated to 16 KiB")
        else:
            set_status_view(shell, "Copied the selected diagnostic")
    else:
        set_status_view(shell, "The system clipboard is unavailable")

def register_shortcuts() -> void:
    UiShortcuts::reset()
    for key_index in 0..<COMMAND_KEY_CAPACITY:
        shell_command_key_latched[key_index] <- false
    bind_primary_shortcuts(UiShortcuts::MOD_CONTROL)
    bind_primary_shortcuts(UiShortcuts::MOD_SUPER)

def bind_primary_shortcuts(primary: u32) -> void:
    _ = UiShortcuts::bind_application(UiCore::Key.N.i32(), primary, ShellCommand.NewDocument.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.O.i32(), primary, ShellCommand.OpenDocument.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.S.i32(), primary, ShellCommand.SaveDocument.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.S.i32(), primary | UiShortcuts::MOD_SHIFT, ShellCommand.SaveAs.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.Z.i32(), primary, ShellCommand.Undo.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.Z.i32(), primary | UiShortcuts::MOD_SHIFT, ShellCommand.Redo.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.Y.i32(), primary, ShellCommand.Redo.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.D.i32(), primary, ShellCommand.DuplicateSelection.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.C.i32(), primary, ShellCommand.CopySelection.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.X.i32(), primary, ShellCommand.CutSelection.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.V.i32(), primary, ShellCommand.PasteSelection.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.R.i32(), primary | UiShortcuts::MOD_SHIFT, ShellCommand.WrapRow.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.W.i32(), primary | UiShortcuts::MOD_SHIFT, ShellCommand.WrapColumn.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.U.i32(), primary | UiShortcuts::MOD_SHIFT, ShellCommand.UnwrapSelection.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.O.i32(), primary | UiShortcuts::MOD_SHIFT, ShellCommand.ConvertOrientation.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.Up.i32(), primary | UiShortcuts::MOD_ALT, ShellCommand.SelectAncestor.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.I.i32(), primary, ShellCommand.InsertSelection.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.Up.i32(), primary | UiShortcuts::MOD_SHIFT, ShellCommand.MoveSelectionBackward.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.Down.i32(), primary | UiShortcuts::MOD_SHIFT, ShellCommand.MoveSelectionForward.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.RightBracket.i32(), primary | UiShortcuts::MOD_CONTROL | UiShortcuts::MOD_SHIFT, ShellCommand.IndentSelection.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.LeftBracket.i32(), primary | UiShortcuts::MOD_CONTROL | UiShortcuts::MOD_SHIFT, ShellCommand.OutdentSelection.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.B.i32(), primary, ShellCommand.BuildProject.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.R.i32(), primary, ShellCommand.RunProject.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.C.i32(), primary | UiShortcuts::MOD_SHIFT, ShellCommand.StopProject.u32(), false)
    _ = UiShortcuts::bind_application(UiCore::Key.Delete.i32(), 0, ShellCommand.DeleteSelection.u32(), false)

def apply_shell_layout(shell: mutable Shell&) -> void:
    width: f32 = UiCore::viewport_width()
    compact: bool = ShellLayout::is_compact(width)
    shell.compact_mode <- compact
    shell.active_split <- 0 if compact
    rects: ShellLayout::PaneRects = ShellLayout::resolve(width, UiCore::viewport_height(), shell.left_ratio, shell.right_ratio, shell.bottom_ratio)
    UiHandles::set_visible(shell.compact_navigation, compact)
    UiHandles::set_visible(shell.compact_path_row, compact)
    UiHandles::set_visible(shell.open_path_field, not compact)
    UiHandles::set_visible(shell.open_button, not compact)
    UiHandles::set_visible(shell.save_as_button, not compact)
    UiHandles::set_visible(shell.new_project_button, not compact)
    UiHandles::set_visible(shell.delete_button, not compact)
    UiHandles::set_visible(shell.duplicate_button, not compact)
    UiHandles::set_visible(shell.surface_pane, not shell.source_mode)
    UiHandles::set_visible(shell.source_pane, shell.source_mode)
    UiHandles::set_grow(shell.surface_pane, 0.0 if shell.source_mode else 1.0)
    UiHandles::set_grow(shell.source_pane, 1.0 if shell.source_mode else 0.0)
    if compact:
        shell.compact_panel <- 0 if shell.compact_panel < 0 or shell.compact_panel > 2
        UiHandles::set_visible(shell.left_pane, shell.compact_panel == 1)
        UiHandles::set_visible(shell.left_splitter, false)
        UiHandles::set_visible(shell.center_pane, shell.compact_panel == 0)
        UiHandles::set_visible(shell.right_splitter, false)
        UiHandles::set_visible(shell.right_pane, shell.compact_panel == 2)
        UiHandles::set_grow(shell.left_pane, 1.0 if shell.compact_panel == 1 else 0.0)
        UiHandles::set_grow(shell.center_pane, 1.0 if shell.compact_panel == 0 else 0.0)
        UiHandles::set_grow(shell.right_pane, 1.0 if shell.compact_panel == 2 else 0.0)
    else:
        UiHandles::set_visible(shell.left_pane, true)
        UiHandles::set_visible(shell.left_splitter, true)
        UiHandles::set_visible(shell.center_pane, true)
        UiHandles::set_visible(shell.right_splitter, true)
        UiHandles::set_visible(shell.right_pane, true)
        UiHandles::set_grow(shell.left_pane, 0.0)
        UiHandles::set_grow(shell.left_splitter, 0.0)
        UiHandles::set_grow(shell.center_pane, 1.0)
        UiHandles::set_grow(shell.right_splitter, 0.0)
        UiHandles::set_grow(shell.right_pane, 0.0)
    UiHandles::set_min_size(shell.left_pane, rects.left_width, 0.0)
    UiHandles::set_min_size(shell.left_splitter, 6.0, 0.0)
    UiHandles::set_min_size(shell.center_pane, ShellLayout::MIN_CENTER, 0.0)
    UiHandles::set_min_size(shell.right_splitter, 6.0, 0.0)
    UiHandles::set_min_size(shell.right_pane, rects.right_width, 0.0)
    UiHandles::set_min_size(shell.bottom_splitter, 0.0, 6.0)
    UiHandles::set_min_size(shell.bottom_pane, 0.0, rects.bottom_height)

def pointer_over_splitter(handle: UiHandles::Handle, at: UiCore::Vec2) -> bool:
    UiHandles::ensure_layout()
    if UiHandles::widget(handle) is widget:
        return at.x >= widget.x - 5.0 and at.x <= widget.x + widget.width + 5.0 and at.y >= widget.y - 5.0 and at.y <= widget.y + widget.height + 5.0
    return false

def update_split_from_pointer(shell: mutable Shell&, at: UiCore::Vec2) -> void:
    if shell.active_split == 1:
        ratio: f32 = ShellLayout::left_ratio_at(at.x, UiCore::viewport_width())
        shell.pane_preferences_dirty <- true if ratio != shell.left_ratio
        shell.left_ratio <- ratio
    elif shell.active_split == 2:
        ratio: f32 = ShellLayout::right_ratio_at(at.x, UiCore::viewport_width())
        shell.pane_preferences_dirty <- true if ratio != shell.right_ratio
        shell.right_ratio <- ratio
    elif shell.active_split == 3:
        ratio: f32 = ShellLayout::bottom_ratio_at(at.y, UiCore::viewport_height())
        shell.pane_preferences_dirty <- true if ratio != shell.bottom_ratio
        shell.bottom_ratio <- ratio
    apply_shell_layout(shell)
    UiHandles::layout(UiCore::viewport_width(), UiCore::viewport_height())

def pointer_over_handle(handle: UiHandles::Handle, at: UiCore::Vec2) -> bool:
    UiHandles::ensure_layout()
    if UiHandles::widget(handle) is widget:
        return at.x >= widget.x and at.x <= widget.x + widget.width and at.y >= widget.y and at.y <= widget.y + widget.height
    return false

def source_row_at(shell: Shell&, at: UiCore::Vec2) -> i32:
    index: mutable i32 = 0
    while index < shell.source_line_count:
        if pointer_over_handle(shell.source_line_rows[index.usize()], at):
            return index
        index <- index + 1
    return -1

def focused_source_row(shell: Shell&) -> i32:
    index: mutable i32 = 0
    while index < shell.source_line_count:
        if UiHandles::is_focused(shell.source_line_rows[index.usize()]):
            return index
        index <- index + 1
    return -1

def indent_source_line(shell: mutable Shell&, outdent: bool) -> bool:
    return false if not shell.source_mode or not shell.host_running or HostClient::request(host_process, 113, 0, 0).result != 1
    row_index: i32 = focused_source_row(shell)
    return false if row_index < 0 or row_index >= shell.source_line_count
    row: UiHandles::Handle = shell.source_line_rows[row_index.usize()]
    return false if not UiHandles::is_enabled(row)
    line_number: i64 = shell.source_line_offsets[row_index.usize()]
    line_start: i64 = HostClient::request(host_process, 118, line_number, 0).result
    line_reply: HostClient::HostReply = HostClient::request(host_process, 116, line_number, 0)
    return false if line_start < 0 or line_reply.result != 1
    line: sview = ShellBytes::view_of(&line_reply.text)
    leading: mutable i64 = 0
    while leading < line.len and (line[leading] == 32 or line[leading] == 9):
        leading <- leading + 1
    remove_count: mutable i64 = 0
    insertion: mutable sview = "    "
    edit_start: mutable i64 = line_start + leading
    edit_finish: mutable i64 = edit_start
    if outdent:
        insertion <- ""
        edit_start <- line_start
        if line.len > 0 and line[0] == 9:
            remove_count <- 1
        else:
            remove_count <- leading if leading < 4 else 4
        return true if remove_count == 0
        edit_finish <- line_start + remove_count
    prefix: darray[u8] = source_line_prefix(line_number + 1)
    caret_byte: usize = UiFlat::selection_end(row.widget_id.usize())
    caret_column: mutable i64 = caret_byte.i64() - prefix.count.i64()
    caret_column <- 0 if caret_column < 0
    next_column: mutable i64 = caret_column
    if outdent:
        next_column <- caret_column - remove_count if caret_column >= remove_count else 0
    elif caret_column >= leading:
        next_column <- caret_column + 4
    changed: HostClient::HostReply = HostClient::request_text(host_process, 133, edit_start, edit_finish, insertion)
    if changed.result != 1:
        set_status(shell, HostClient::request(host_process, 56, 0, 0).text)
        return true
    shell.source_page_start <- (line_number / MAX_SOURCE_LINES.i64()) * MAX_SOURCE_LINES.i64()
    refresh_source_view(shell, host_process)
    target_index: i32 = (line_number - shell.source_page_start).i32()
    if target_index >= 0 and target_index < shell.source_line_count:
        target_row: UiHandles::Handle = shell.source_line_rows[target_index.usize()]
        if UiHandles::request_focus(target_row):
            target_prefix: darray[u8] = source_line_prefix(line_number + 1)
            target_value: sview = UiHandles::text_value(target_row)
            available_bytes: mutable i64 = target_value.len - target_prefix.count.i64()
            available_bytes <- 0 if available_bytes < 0
            next_column <- available_bytes if next_column > available_bytes
            cursor_byte: usize = (target_prefix.count.i64() + next_column).usize()
            cursor_units: usize = UiFlat::text_utf16_offset(target_row.widget_id.usize(), cursor_byte)
            UiHandles::set_selection_utf16(target_row, cursor_units, 0)
            shell.source_selected_line <- line_number + 1
    set_status(shell, HostClient::request(host_process, 56, 0, 0).text)
    return true

def insert_source_line_break(shell: mutable Shell&) -> bool:
    return false if not shell.source_mode or not shell.host_running
    return false if HostClient::request(host_process, 113, 0, 0).result != 1
    row_index: mutable i32 = focused_source_row(shell)
    return false if row_index < 0
    row: UiHandles::Handle = shell.source_line_rows[row_index.usize()]
    line_number: i64 = shell.source_line_offsets[row_index.usize()]
    prefix: darray[u8] = source_line_prefix(line_number + 1)
    value: sview = UiHandles::text_value(row)
    content_length: mutable i64 = value.len - prefix.count.i64()
    content_length <- 0 if content_length < 0
    selection_start: mutable i64 = UiFlat::selection_start(row.widget_id.usize()).i64() - prefix.count.i64()
    selection_end: mutable i64 = UiFlat::selection_end(row.widget_id.usize()).i64() - prefix.count.i64()
    selection_start <- 0 if selection_start < 0
    selection_end <- 0 if selection_end < 0
    selection_start <- content_length if selection_start > content_length
    selection_end <- content_length if selection_end > content_length
    line_start: i64 = HostClient::request(host_process, 118, line_number, 0).result
    if line_start < 0:
        set_status_view(shell, "The selected source line is no longer available")
        return true
    edited: HostClient::HostReply = HostClient::request_text(host_process, 133, line_start + selection_start, line_start + selection_end, "\n")
    if edited.result != 1:
        set_status(shell, HostClient::request(host_process, 56, 0, 0).text)
        return true
    target_line: i64 = line_number + 1
    shell.source_page_start <- (target_line / MAX_SOURCE_LINES.i64()) * MAX_SOURCE_LINES.i64()
    refresh_source_view(shell, host_process)
    target_index: i32 = (target_line - shell.source_page_start).i32()
    if target_index >= 0 and target_index < shell.source_line_count:
        target_row: UiHandles::Handle = shell.source_line_rows[target_index.usize()]
        if UiHandles::request_focus(target_row):
            target_prefix: darray[u8] = source_line_prefix(target_line + 1)
            cursor: usize = UiFlat::text_utf16_offset(target_row.widget_id.usize(), target_prefix.count)
            UiHandles::set_selection_utf16(target_row, cursor, 0)
            shell.source_selected_line <- target_line + 1
    set_status(shell, HostClient::request(host_process, 56, 0, 0).text)
    return true

def merge_source_lines(shell: mutable Shell&, direction: i32) -> bool:
    return false if not shell.source_mode or not shell.host_running or (direction != -1 and direction != 1)
    return false if HostClient::request(host_process, 113, 0, 0).result != 1
    row_index: i32 = focused_source_row(shell)
    return false if row_index < 0
    row: UiHandles::Handle = shell.source_line_rows[row_index.usize()]
    line_number: i64 = shell.source_line_offsets[row_index.usize()]
    value: sview = UiHandles::text_value(row)
    prefix: darray[u8] = source_line_prefix(line_number + 1)
    content_length: mutable i64 = value.len - prefix.count.i64()
    content_length <- 0 if content_length < 0
    selection_start: usize = UiFlat::selection_start(row.widget_id.usize())
    selection_end: usize = UiFlat::selection_end(row.widget_id.usize())
    return false if selection_start != selection_end
    caret_column: mutable i64 = selection_start.i64() - prefix.count.i64()
    caret_column <- 0 if caret_column < 0
    caret_column <- content_length if caret_column > content_length
    return false if direction < 0 and caret_column != 0
    return false if direction > 0 and caret_column != content_length
    neighbor_line: i64 = line_number + direction.i64()
    total: i64 = HostClient::request(host_process, 115, 0, 0).result
    return false if neighbor_line < 0 or neighbor_line >= total
    current_start: i64 = HostClient::request(host_process, 118, line_number, 0).result
    current_text: HostClient::HostReply = HostClient::request(host_process, 116, line_number, 0)
    return false if current_start < 0 or current_text.result != 1
    neighbor_start: i64 = HostClient::request(host_process, 118, neighbor_line, 0).result
    neighbor_text: HostClient::HostReply = HostClient::request(host_process, 116, neighbor_line, 0)
    if neighbor_start < 0 or neighbor_text.result != 1:
        set_status_view(shell, "Cannot merge with a clipped, read-only source line")
        return true
    delete_start: mutable i64 = current_start + current_text.text.count.i64()
    delete_end: mutable i64 = neighbor_start
    target_line: mutable i64 = line_number
    target_column: mutable i64 = current_text.text.count.i64()
    if direction < 0:
        delete_start <- neighbor_start + neighbor_text.text.count.i64()
        delete_end <- current_start
        target_line <- neighbor_line
        target_column <- neighbor_text.text.count.i64()
    if delete_end <= delete_start:
        set_status_view(shell, "The adjacent source lines do not have a removable line ending")
        return true
    merged: HostClient::HostReply = HostClient::request_text(host_process, 133, delete_start, delete_end, "")
    if merged.result != 1:
        set_status(shell, HostClient::request(host_process, 56, 0, 0).text)
        return true
    shell.source_page_start <- (target_line / MAX_SOURCE_LINES.i64()) * MAX_SOURCE_LINES.i64()
    refresh_source_view(shell, host_process)
    target_index: i32 = (target_line - shell.source_page_start).i32()
    if target_index >= 0 and target_index < shell.source_line_count:
        target_row: UiHandles::Handle = shell.source_line_rows[target_index.usize()]
        if UiHandles::request_focus(target_row):
            target_prefix: darray[u8] = source_line_prefix(target_line + 1)
            target_bytes: mutable i64 = target_prefix.count.i64() + target_column
            target_text: sview = UiHandles::text_value(target_row)
            target_bytes <- target_text.len if target_bytes > target_text.len
            cursor: usize = UiFlat::text_utf16_offset(target_row.widget_id.usize(), target_bytes.usize())
            UiHandles::set_selection_utf16(target_row, cursor, 0)
            shell.source_selected_line <- target_line + 1
    set_status(shell, HostClient::request(host_process, 56, 0, 0).text)
    return true

def move_source_caret(shell: mutable Shell&, direction: i32, page_jump: bool) -> bool:
    return false if not shell.source_mode or not shell.host_running or (direction != -1 and direction != 1)
    return false if HostClient::request(host_process, 113, 0, 0).result != 1
    current_index: i32 = focused_source_row(shell)
    return false if current_index < 0
    current_row: UiHandles::Handle = shell.source_line_rows[current_index.usize()]
    current_prefix: darray[u8] = source_line_prefix(shell.source_line_offsets[current_index.usize()] + 1)
    current_caret: usize = UiFlat::selection_end(current_row.widget_id.usize())
    source_column: mutable i64 = current_caret.i64() - current_prefix.count.i64()
    source_column <- 0 if source_column < 0
    total: i64 = HostClient::request(host_process, 115, 0, 0).result
    current_line: i64 = shell.source_line_offsets[current_index.usize()]
    step: i64 = MAX_SOURCE_LINES.i64() if page_jump else 1
    target_line: mutable i64 = current_line + direction.i64() * step
    if page_jump and target_line < 0:
        target_line <- 0
    if page_jump and target_line >= total:
        target_line <- total - 1
    return false if target_line < 0 or target_line >= total
    target_page: i64 = (target_line / MAX_SOURCE_LINES.i64()) * MAX_SOURCE_LINES.i64()
    if target_page != shell.source_page_start:
        shell.source_page_start <- target_page
        refresh_source_view(shell, host_process)
    target_index: mutable i32 = (target_line - shell.source_page_start).i32()
    while target_index >= 0 and target_index < shell.source_line_count and not UiHandles::is_enabled(shell.source_line_rows[target_index.usize()]):
        target_index <- target_index + direction
    return false if target_index < 0 or target_index >= shell.source_line_count
    target_row: UiHandles::Handle = shell.source_line_rows[target_index.usize()]
    return false if not UiHandles::request_focus(target_row)
    target_prefix: darray[u8] = source_line_prefix(shell.source_line_offsets[target_index.usize()] + 1)
    target_value: sview = UiHandles::text_value(target_row)
    target_column: mutable i64 = target_value.len - target_prefix.count.i64()
    target_column <- source_column if source_column < target_column
    target_byte: usize = (target_prefix.count.i64() + target_column).usize()
    target_utf16: usize = UiFlat::text_utf16_offset(target_row.widget_id.usize(), target_byte)
    UiHandles::set_selection_utf16(target_row, target_utf16, 0)
    shell.source_selected_line <- shell.source_line_offsets[target_index.usize()] + 1
    return true

def move_source_caret_vertically(shell: mutable Shell&, direction: i32) -> bool:
    return move_source_caret(shell, direction, false)

def move_source_caret_by_page(shell: mutable Shell&, direction: i32) -> bool:
    return move_source_caret(shell, direction, true)

def hierarchy_row_at(shell: Shell&, at: UiCore::Vec2) -> i64:
    index: mutable i32 = 0
    while index < shell.hierarchy_count:
        if pointer_over_handle(shell.hierarchy_rows[index.usize()], at):
            return shell.hierarchy_page.i64() * MAX_HIERARCHY_ROWS.i64() + index.i64()
        index <- index + 1
    return -1

def palette_source_at(shell: Shell&, at: UiCore::Vec2) -> i64:
    index: mutable i32 = 0
    while index < shell.palette_count:
        if pointer_over_handle(shell.palette_rows[index.usize()], at):
            return shell.palette_source_indices[index.usize()].i64()
        index <- index + 1
    return -1

def clear_drag_feedback(shell: mutable Shell&, process: mutable PosixProcess::Process&) -> void:
    had_feedback: bool = shell.drag_feedback_target >= 0
    shell.drag_kind <- 0
    shell.drag_palette_index <- -1
    shell.drag_source_row <- -1
    shell.drag_target_row <- -1
    shell.drag_start_x <- 0.0
    shell.drag_start_y <- 0.0
    shell.drag_moved <- false
    shell.drag_feedback_target <- -1
    shell.drag_feedback_valid <- false
    if had_feedback and shell.host_running:
        refresh_hierarchy(shell, process)

def update_drag_feedback(shell: mutable Shell&, process: mutable PosixProcess::Process&, target_row: i64) -> void:
    if target_row == shell.drag_feedback_target:
        return
    if shell.drag_feedback_target >= 0 and shell.host_running:
        refresh_hierarchy(shell, process)
    shell.drag_feedback_target <- target_row
    shell.drag_target_row <- target_row
    if target_row < 0 or not shell.host_running:
        shell.drag_feedback_valid <- false
        set_status_view(shell, "Drop outside the hierarchy")
        return
    valid: mutable i64 = 0
    if shell.drag_kind == 1:
        valid <- HostClient::request(process, 86, shell.drag_palette_index.i64(), target_row).result
    elif shell.drag_kind == 2:
        valid <- HostClient::request(process, 88, target_row, 0).result
    shell.drag_feedback_valid <- valid == 1
    visible_row: i64 = target_row - shell.hierarchy_page.i64() * MAX_HIERARCHY_ROWS.i64()
    if visible_row >= 0 and visible_row < shell.hierarchy_count.i64():
        row: UiHandles::Handle = shell.hierarchy_rows[visible_row.usize()]
        if shell.drag_feedback_valid:
            UiHandles::set_colors(row, shell_color(42, 92, 66), shell_color(56, 116, 80), shell_color(30, 72, 50))
            UiHandles::set_help(row, "Release to drop here")
            set_status_view(shell, "Drop to insert/reparent")
        else:
            UiHandles::set_colors(row, shell_color(104, 48, 54), shell_color(132, 60, 68), shell_color(82, 36, 42))
            UiHandles::set_help(row, "This component cannot accept the drop")
            set_status_view(shell, "Cannot drop here")

def begin_drag(shell: mutable Shell&, at: UiCore::Vec2, button: i32) -> void:
    return if button != UiCore::PointerButton.Primary.i32() or shell.active_split > 0
    palette_index: i64 = palette_source_at(shell, at)
    if palette_index >= 0:
        shell.drag_kind <- 1
        shell.drag_palette_index <- palette_index.i32()
        shell.drag_source_row <- -1
        shell.drag_target_row <- -1
        shell.drag_start_x <- at.x
        shell.drag_start_y <- at.y
        shell.drag_moved <- false
        shell.drag_feedback_target <- -1
        shell.drag_feedback_valid <- false
        return
    hierarchy_row: i64 = hierarchy_row_at(shell, at)
    if hierarchy_row >= 0:
        shell.drag_kind <- 2
        shell.drag_palette_index <- -1
        shell.drag_source_row <- hierarchy_row
        shell.drag_target_row <- -1
        shell.drag_start_x <- at.x
        shell.drag_start_y <- at.y
        shell.drag_moved <- false
        shell.drag_feedback_target <- -1
        shell.drag_feedback_valid <- false

def update_drag(shell: mutable Shell&, process: mutable PosixProcess::Process&, at: UiCore::Vec2) -> bool:
    return false if shell.drag_kind == 0
    dx: f32 = at.x - shell.drag_start_x
    dy: f32 = at.y - shell.drag_start_y
    if not shell.drag_moved:
        shell.drag_moved <- true if dx > 4.0 or dx < -4.0 or dy > 4.0 or dy < -4.0
    return false if not shell.drag_moved
    update_drag_feedback(shell, process, hierarchy_row_at(shell, at))
    return true

def pointer_over_preview(shell: Shell&, at: UiCore::Vec2) -> bool:
    if UiHandles::widget(shell.preview_canvas) is canvas:
        return at.x >= canvas.x and at.y >= canvas.y and at.x < canvas.x + canvas.width and at.y < canvas.y + canvas.height
    return false

def begin_canvas_marquee(shell: mutable Shell&, at: UiCore::Vec2, button: i32) -> void:
    return if button != UiCore::PointerButton.Primary.i32() or not pointer_over_preview(shell, at)
    shell.canvas_marquee_active <- true
    shell.canvas_marquee_moved <- false
    shell.canvas_marquee_start_x <- at.x
    shell.canvas_marquee_start_y <- at.y
    shell.canvas_marquee_end_x <- at.x
    shell.canvas_marquee_end_y <- at.y

def clear_canvas_marquee(shell: mutable Shell&) -> void:
    shell.canvas_marquee_active <- false
    shell.canvas_marquee_moved <- false
    shell.canvas_marquee_start_x <- 0.0
    shell.canvas_marquee_start_y <- 0.0
    shell.canvas_marquee_end_x <- 0.0
    shell.canvas_marquee_end_y <- 0.0

def update_canvas_marquee(shell: mutable Shell&, at: UiCore::Vec2) -> bool:
    return false if not shell.canvas_marquee_active
    shell.canvas_marquee_end_x <- at.x
    shell.canvas_marquee_end_y <- at.y
    dx: f32 = at.x - shell.canvas_marquee_start_x
    dy: f32 = at.y - shell.canvas_marquee_start_y
    if not shell.canvas_marquee_moved and (dx > 4.0 or dx < -4.0 or dy > 4.0 or dy < -4.0):
        shell.canvas_marquee_moved <- true
        set_status_view(shell, "Drag across the design surface to select components")
    return shell.canvas_marquee_moved

def load_pane_preferences(shell: mutable Shell&) -> void:
    can Blocking.IO:
        left: mutable f64 = shell.left_ratio.f64()
        right: mutable f64 = shell.right_ratio.f64()
        bottom: mutable f64 = shell.bottom_ratio.f64()
        designer_workspace_preferences_load_ratios(&left, &right, &bottom)
        # Reuse the shell geometry policy as the final authority after the
        # preferences codec has supplied validated local values.
        shell.left_ratio <- ShellLayout::clamp_ratio(left.f32())
        shell.right_ratio <- ShellLayout::clamp_ratio(right.f32())
        shell.bottom_ratio <- ShellLayout::clamp_ratio(bottom.f32())
        shell.pane_preferences_dirty <- false

def save_pane_preferences(shell: mutable Shell&) -> bool:
    can Blocking.IO:
        return true if not shell.pane_preferences_dirty
        saved: bool = designer_workspace_preferences_save_ratios(shell.left_ratio.f64(), shell.right_ratio.f64(), shell.bottom_ratio.f64()) == 1
        shell.pane_preferences_dirty <- false if saved
        return saved

