    UiHandles::set_help(shell.run_button, "Run the last successful standalone-source or visual-project build")
    shell.stop_button <- toolbar_button(shell, shell.toolbar, "Stop", 58.0)
    UiHandles::set_help(shell.stop_button, "Cancel the active build or stop the running application")
    shell.save_button <- toolbar_button(shell, shell.toolbar, "Save", 64.0)
    shell.source_button <- toolbar_button(shell, shell.toolbar, "Source", 72.0)
