    UiHandles::set_visible(shell.reload_button, false)
    shell.recovery_restore_button <- toolbar_button(shell, shell.toolbar, "Restore", 72.0)
    UiHandles::set_help(shell.recovery_restore_button, "Restore the last autosaved working copy without overwriting the project file")
    shell.recovery_discard_button <- toolbar_button(shell, shell.toolbar, "Discard", 72.0)
    UiHandles::set_help(shell.recovery_discard_button, "Discard the autosaved working copy and keep the on-disk document")
