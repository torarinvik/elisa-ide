    shell.open_path_field <- UiHandles::text_field(shell.toolbar, "Document path", "Document path or new project folder", "", 250.0, 24.0, 12.0, shell_color(232, 236, 246), shell_color(27, 32, 43))
    UiHandles::set_help(shell.open_path_field, "Open an .elisa source file, .elisaform.json, or .elisaproject.json; save a form or create a project here")
    UiHandles::set_grow(shell.open_path_field, 1.0)
    shell.open_button <- toolbar_button(shell, shell.toolbar, "Open", 58.0)
