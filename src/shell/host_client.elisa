# Host client for the editor shell (UI compilation unit).
#
# The shell keeps one `document_host --signal` process alive and exchanges
# requests through session-private files under the local temporary directory.
# The stdin byte is a wakeup signal; replies use a bounded binary record. The
# paths are unique to this IDE process, so multiple instances and project
# directories cannot race over shared build/ files.

include "../platform/posix/posix_file.elisa"
include "../platform/posix/posix_process.elisa"
include "../preview/preview_wire.elisa"

const HOST_REPLY_CAPACITY: usize = PreviewWire::MAX_PAYLOAD_BYTES + 8
const HOST_IPC_PATH_CAPACITY: usize = 4096

@link_name("designer_host_ipc_paths_create")
extern designer_host_ipc_paths_create(request_path: mutable void&, request_capacity: usize, reply_path: mutable void&, reply_capacity: usize) -> i64 can[Blocking.IO]
@link_name("designer_host_ipc_paths_cleanup")
extern designer_host_ipc_paths_cleanup(request_path: cstr, reply_path: cstr) -> i64 can[Blocking.IO]

global mutable host_request_path: mutable u8[4096] = zeroed
global mutable host_reply_path: mutable u8[4096] = zeroed

module ShellBytes:
    public:
        def view_of(bytes: darray[u8]&) -> sview:
            return "" if bytes.count == 0 or bytes.items == null or bytes.count > bytes.capacity
            count: i64 = bytes.count.i64()
            return "" if count < 0 or count.usize() != bytes.count
            # The reference and checked count prove that the view borrows a
            # live byte range. The direct bridge avoids a stage1 decline when
            # a dynamic-array reference is passed through bytes_view_range.
            trusted Unsafe.UncheckedIndex:
                can Unsafe.PointerCast:
                    return UiText::unsafe_sview_bounded_bytes(&bytes[0], bytes.count)

        def equal(left: sview, right: sview) -> bool:
            return false if left.len != right.len
            index: mutable i64 = 0
            while index < left.len:
                return false if left[index] != right[index]
                index <- index + 1
            return true

struct HostReply:
    result: mutable i64
    text: mutable darray[u8]

module HostClient:
    private:
        def append_i64(buffer: mutable darray[u8]&, value: i64) -> void:
            if value == 0:
                buffer.push(48)
                return
            digits: mutable u8[24] = zeroed
            count: mutable i64 = 0
            remaining: mutable i64 = value
            while remaining > 0:
                digits[count.usize()] <- (48 + (remaining % 10)).u8()
                remaining <- remaining / 10
                count <- count + 1
            index: mutable i64 = count - 1
            while index >= 0:
                buffer.push(digits[index.usize()])
                index <- index - 1

        def i32_at(bytes: darray[u8]&, offset: i64) -> i64:
            a: i64 = bytes[offset.usize()].i32().i64()
            b: i64 = bytes[(offset + 1).usize()].i32().i64()
            c: i64 = bytes[(offset + 2).usize()].i32().i64()
            d: i64 = bytes[(offset + 3).usize()].i32().i64()
            value: i64 = a | (b << 8) | (c << 16) | (d << 24)
            return value - 4294967296 if d >= 128 else value

        def append_hex_bytes(buffer: mutable darray[u8]&, text: sview) -> void:
            index: mutable i64 = 0
            while index < text.len:
                byte: i64 = text[index].i32().i64()
                high: i64 = (byte >> 4) & 15
                low: i64 = byte & 15
                buffer.push((48 + high).u8() if high < 10 else (87 + high).u8())
                buffer.push((48 + low).u8() if low < 10 else (87 + low).u8())
                index <- index + 1

        def request_impl(process: mutable PosixProcess::Process&, opcode: i64, arg0: i64, arg1: i64, text: sview, include_text: bool) -> HostReply:
            can Blocking.IO, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
                request_path: mutable cstr = ""
                reply_path: mutable cstr = ""
                request_path <- (&host_request_path[0]).cast[cstr] can Unsafe.PointerCast
                reply_path <- (&host_reply_path[0]).cast[cstr] can Unsafe.PointerCast
                return HostReply{result: -1, text: []} if host_request_path[0] == 0 or host_reply_path[0] == 0
                _ = PosixFile::remove(request_path)
                request: mutable darray[u8] = []
                append_i64(&request, opcode)
                request.push(32)
                append_i64(&request, arg0)
                request.push(32)
                append_i64(&request, arg1)
                if include_text:
                    request.push(32)
                    append_hex_bytes(&request, text)
                request.push(10)
                view: sview = ShellBytes::view_of(&request)
                if PosixFile::write_plain(request_path, view) < 0:
                    return HostReply{result: -1, text: []}
                # Remove the previous reply so a stale file cannot be read as
                # this request's answer while the host is still working.
                _ = PosixFile::remove(reply_path)
                one_byte: mutable darray[u8] = []
                one_byte.push(10)
                _ = PosixProcess::write_stdin(process, ShellBytes::view_of(&one_byte))

                reply: mutable darray[u8] = []
                waited: mutable i64 = 0
                while waited < 30000:
                    amount: usize = PosixFile::read_bytes(&reply, reply_path, HOST_REPLY_CAPACITY)
                    if amount >= 8:
                        result: i64 = i32_at(reply, 0)
                        text_length: i64 = i32_at(reply, 4)
                        if text_length >= 0 and text_length <= PreviewWire::MAX_PAYLOAD_BYTES.i64() and reply.count.i64() >= 8 + text_length:
                            response_text: mutable darray[u8] = []
                            index: mutable i64 = 0
                            while index < text_length:
                                response_text.push(reply[(8 + index).usize()])
                                index <- index + 1
                            return HostReply{result: result, text: response_text}
                    waited <- waited + 10
                    _ = PosixProcess::poll(process, 1)
                return HostReply{result: -1, text: []}

    public:
        # Start one long-lived host so document, history, and selection survive
        # across shell actions.
        def start(host_path: cstr) -> PosixProcess::Process:
            can Blocking.IO, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
                host_request_path[0] <- 0
                host_reply_path[0] <- 0
                request_pointer: mutable void& = (&host_request_path[0]).cast[mutable void&] can Unsafe.PointerCast
                reply_pointer: mutable void& = (&host_reply_path[0]).cast[mutable void&] can Unsafe.PointerCast
                if designer_host_ipc_paths_create(request_pointer, HOST_IPC_PATH_CAPACITY, reply_pointer, HOST_IPC_PATH_CAPACITY) != 0:
                    return PosixProcess::Process{handle: null}
                request_path: mutable cstr = ""
                reply_path: mutable cstr = ""
                request_path <- (&host_request_path[0]).cast[cstr] can Unsafe.PointerCast
                reply_path <- (&host_reply_path[0]).cast[cstr] can Unsafe.PointerCast
                arguments: mutable darray[cstr] = []
                arguments.push(host_path)
                arguments.push("--signal")
                arguments.push(request_path)
                arguments.push(reply_path)
                process: PosixProcess::Process = PosixProcess::start(&arguments)
                if not PosixProcess::valid(process):
                    _ = designer_host_ipc_paths_cleanup(request_path, reply_path)
                    host_request_path[0] <- 0
                    host_reply_path[0] <- 0
                return process

        # Close stdin, reap the host, and remove only this session's private
        # files after the process can no longer be using them.
        def stop(process: mutable PosixProcess::Process&) -> void:
            can Blocking.IO, Memory.Release, Unsafe.PointerCast:
                if PosixProcess::valid(process):
                    _ = PosixProcess::close_stdin(process)
                    stopped: bool = PosixProcess::poll(process, 1000)
                    if not stopped:
                        _ = PosixProcess::cancel(process)
                    PosixProcess::dispose(process)
                if host_request_path[0] != 0 and host_reply_path[0] != 0:
                    request_path: mutable cstr = ""
                    reply_path: mutable cstr = ""
                    request_path <- (&host_request_path[0]).cast[cstr] can Unsafe.PointerCast
                    reply_path <- (&host_reply_path[0]).cast[cstr] can Unsafe.PointerCast
                    _ = designer_host_ipc_paths_cleanup(request_path, reply_path)
                    host_request_path[0] <- 0
                    host_reply_path[0] <- 0

        # Write one request, signal the host, and wait for its reply file.
        def request(process: mutable PosixProcess::Process&, opcode: i64, arg0: i64, arg1: i64) -> HostReply:
            can Blocking.IO, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
                return request_impl(process, opcode, arg0, arg1, "", false)

        # The fourth signal request field is the original UTF-8 encoded as
        # hexadecimal, so paths and user text never break the token format.
        def request_text(process: mutable PosixProcess::Process&, opcode: i64, arg0: i64, arg1: i64, text: sview) -> HostReply:
            can Blocking.IO, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
                return request_impl(process, opcode, arg0, arg1, text, true)
